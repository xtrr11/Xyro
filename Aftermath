-- Instant Bullet: the projectile is moved onto the aim point the frame it exists,
-- and any travel-time / bullet-speed values on the gun are forced so the delay is gone.
local travelOrig = setmetatable({}, { __mode = "k" })

local function bulletGoal()
	local cam = workspace.CurrentCamera
	if not cam then return end
	if lockPart and lockPart.Parent then
		return lockPart.Position
	end
	local mouse = UIS:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { cam }
	if lp.Character then table.insert(ignore, lp.Character) end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 4000, params)
	if hit then return hit.Position end
	return ray.Origin + ray.Direction * 4000
end

local function looksLikeBullet(obj)
	if not obj:IsA("BasePart") then return false end
	local n = string.lower(obj.Name)
	if n:find("shell", 1, true) or n:find("casing", 1, true) or n:find("debris", 1, true) then
		return false
	end
	if n:find("bullet", 1, true) or n:find("proj", 1, true) or n:find("pellet", 1, true)
		or n:find("round", 1, true) or n:find("shot", 1, true) or n:find("tracer", 1, true) then
		return true
	end
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	return (obj.Position - root.Position).Magnitude < 22
		and obj.Size.Magnitude < 6
		and obj.AssemblyLinearVelocity.Magnitude > 40
end

local function snapBullet(obj)
	if not obj or not obj.Parent then return end
	local goal = bulletGoal()
	if not goal then return end
	pcall(function()
		if sethiddenproperty then
			sethiddenproperty(lp, "SimulationRadius", 1e6)
		end
	end)
	pcall(function()
		local delta = goal - obj.Position
		if delta.Magnitude < 0.05 then return end
		obj.CFrame = CFrame.lookAt(goal - delta.Unit * 0.05, goal)
		obj.AssemblyLinearVelocity = delta.Unit * 1e5
		obj.AssemblyAngularVelocity = Vector3.zero
	end)
end

connect(workspace.DescendantAdded, function(obj)
	if not on("Combat", "Miscellaneous", "Instant Bullet") then return end
	if os.clock() - lastShot > 0.35 and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		return
	end
	if lp.Character and obj:IsDescendantOf(lp.Character) then return end
	if not looksLikeBullet(obj) then return end
	snapBullet(obj)
	task.defer(snapBullet, obj)
end)

local function patchTravel(root, enabled)
	if not root then return end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("NumberValue") or d:IsA("IntValue") then
			local n = string.lower(d.Name)
			local travel = n:find("travel", 1, true) or n:find("flighttime", 1, true) or n:find("bullettime", 1, true)
			local speed = n:find("bulletspeed", 1, true) or n:find("projectilespeed", 1, true) or n:find("shotspeed", 1, true)
			if travel or speed then
				if enabled then
					if travelOrig[d] == nil then travelOrig[d] = d.Value end
					d.Value = travel and 0 or 100000
				elseif travelOrig[d] ~= nil then
					d.Value = travelOrig[d]
					travelOrig[d] = nil
				end
			end
		end
	end
end

