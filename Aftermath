-- damage watchers for hit sounds + kill logs
local watched = {}
local lastShot = 0
local damaged = {}

local function watchModel(model, info)
	if watched[model] then return end
	local hum = info.hum
	if not hum then return end
	watched[model] = true
	if typeof(hum) ~= "Instance" or not hum.HealthChanged then return end
	local last = hum.Health
	connect(hum.HealthChanged, function(h)
		local dmg = last - h
		last = h
		if dmg > 0.5 and os.clock() - lastShot < 0.8 then
			damaged[model] = os.clock()
			playHit()
		end
	end)
	connect(hum.Died, function()
		if not damaged[model] or os.clock() - damaged[model] > 8 then return end
		local who = info.plr and info.plr.DisplayName or model.Name
		local verb = "killed"
		if not on("Environment", "Logs", "Use Default Kill Words") then
			local raw = flag("txt", "Environment", "Logs", "word1, word2, word3...")
			if type(raw) == "string" and raw ~= "" then
				local words = {}
				for w in raw:gmatch("[^,%s]+") do table.insert(words, w) end
				if #words > 0 then verb = words[math.random(1, #words)] end
			end
		end
		pushLog(verb .. " " .. who)
	end)
end

