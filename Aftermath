local function placeLine(frame, a, b, thickness, color)
	local d = b - a
	local len = d.Magnitude
	if len < 1 then
		frame.Visible = false
		return false
	end
	frame.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
	frame.Size = UDim2.fromOffset(len, math.max(thickness, 1))
	frame.Rotation = math.deg(math.atan2(d.Y, d.X))
	frame.BackgroundColor3 = color
	frame.Visible = true
	return true
end

local function worldToScreen(pos)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local v, on = cam:WorldToViewportPoint(pos)
	if on and v.Z > 0 then
		return Vector2.new(v.X, v.Y)
	end
end

local STUD_TO_M = 0.28
local function toMeters(studs)
