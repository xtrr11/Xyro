-- connection tracking so Unload cleans everything up ----------------------
local conns = {}
local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(conns, c)
	return c
end

-- helpers ----------------------------------------------------------------
local counter = 0
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if o:IsA("GuiObject") then
		counter += 1
		o.LayoutOrder = counter -- creation order == layout order
	end
	o.Parent = parent
	return o
end

local function stroke(o, color)
	return new("UIStroke", {
		Color = color or T.line, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

local function list(parent, pad, horizontal)
	return new("UIListLayout", {
		Padding = UDim.new(0, pad or 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
	}, parent)
end

local function text(parent, str, color, h)
	return new("TextLabel", {
		Size = UDim2.new(1, 0, 0, h or 16), BackgroundTransparency = 1, Text = str,
		TextColor3 = color or T.text, Font = FONT, TextSize = SIZE,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
	}, parent)
end

local function hoverable(btn, normal, hover)
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hover end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = normal end)
end

local function inside(obj, pos)
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

-- config registry (every widget registers a getter/setter) ---------------
local Flags = {}
local flagCount = {}
local currentTab, currentSection = "", ""
local defaults = nil

local function register(kind, label, getter, setter)
	local base = kind .. ":" .. currentTab .. "/" .. currentSection .. "/" .. label
	flagCount[base] = (flagCount[base] or 0) + 1
	local key = flagCount[base] > 1 and (base .. "#" .. flagCount[base]) or base
	Flags[key] = { get = getter, set = setter }
end

local function snapshot()
	local data = {}
	for key, f in pairs(Flags) do
		local ok, v = pcall(f.get)
		if ok and v ~= nil then data[key] = v end
	end
	return data
end

local function applyConfig(data)
	for key, v in pairs(data) do
		local f = Flags[key]
		if f then pcall(f.set, v) end
	end
end

-- floating dropdown state ---------------------------------------------------
local openDrop = nil
local function closeDrop()
	if openDrop then
		openDrop.popup:Destroy()
		openDrop.arrow.Text = "v"
		openDrop = nil
	end
end

local function hitGui(obj)
	if not obj or not obj.Parent then return false end
	local m = UIS:GetMouseLocation()
	local inset = Vector2.zero
	pcall(function()
		local g = game:GetService("GuiService"):GetGuiInset()
		inset = Vector2.new(g.X, g.Y)
	end)
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	for _, pos in ipairs({ m, m - inset, m + inset }) do
		if pos.X >= p.X - 4 and pos.X <= p.X + s.X + 4 and pos.Y >= p.Y - 4 and pos.Y <= p.Y + s.Y + 4 then
			return true
		end
	end
	return false
end

connect(UIS.InputBegan, function(i)
	if openDrop and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
		if openDrop.choose and openDrop.choose() then
			closeDrop()
		elseif not hitGui(openDrop.popup) and not hitGui(openDrop.btn) then
			closeDrop()
		end
	end
end)
connect(UIS.InputChanged, function(i)
	if openDrop and i.UserInputType == Enum.UserInputType.MouseWheel then
		if not hitGui(openDrop.popup) then closeDrop() end
	end
end)

