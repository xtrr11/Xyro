local function keyButton(parent, default, callback, defaultMode)
	local MODES = { "hold", "toggle", "always" }
	local codeName = default.Name
	local mode = defaultMode or "hold"
	local modeBtn = new("TextButton", {
		Size = UDim2.fromOffset(58, 16), Position = UDim2.new(1, -116, 0, 1), BackgroundColor3 = T.field,
		BorderSizePixel = 0, AutoButtonColor = false, Text = mode, TextColor3 = T.accent,
		Font = FONT, TextSize = 11,
	}, parent)
	stroke(modeBtn)
	hoverable(modeBtn, T.field, T.hover)
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(54, 16), Position = UDim2.new(1, -54, 0, 1), BackgroundColor3 = T.field,
		BorderSizePixel = 0, AutoButtonColor = false, Text = codeName, TextColor3 = T.text,
		Font = FONT, TextSize = 11,
	}, parent)
	stroke(btn)
	hoverable(btn, T.field, T.hover)

	local kb = {}
	local function paintMode()
		modeBtn.Text = mode
	end
	function kb.get() return codeName .. "|" .. mode end
	function kb.mode() return mode end
	function kb.set(v)
		v = tostring(v)
		local name, m = v:match("^(.-)|(.+)$")
		if not name then name, m = v, nil end
		local ok, code = pcall(function() return Enum.KeyCode[name] end)
		if ok and code then
			codeName = code.Name
			btn.Text = codeName
			if m == "hold" or m == "toggle" or m == "always" then mode = m end
			paintMode()
			if callback then callback(code) end
		end
	end
	function kb.setMode(m)
		if m == "hold" or m == "toggle" or m == "always" then
			mode = m
			paintMode()
		end
	end

	modeBtn.MouseButton1Click:Connect(function()
		local i = table.find(MODES, mode) or 1
		mode = MODES[i % #MODES + 1]
		paintMode()
	end)
	modeBtn.MouseButton2Click:Connect(function()
		local i = table.find(MODES, mode) or 1
		mode = MODES[i % #MODES + 1]
		paintMode()
	end)

	btn.MouseButton1Click:Connect(function()
		btn.Text = "..."
		local conn
		conn = UIS.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Keyboard then
				codeName = i.KeyCode.Name
				btn.Text = codeName
				if callback then callback(i.KeyCode) end
				conn:Disconnect()
			end
		end)
	end)
	return kb
end

-- opts: default, swatch (Color3), key (KeyCode), disabled, callback
function UI.checkbox(parent, str, opts)
	opts = opts or {}
	local state = opts.default or false
	local disabled = opts.disabled or false
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1 }, parent)
	local box = new("Frame", {
		Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(0, 3),
		BackgroundColor3 = state and T.accent or T.field, BorderSizePixel = 0,
	}, row)
	stroke(box, disabled and Color3.fromRGB(45, 45, 45) or T.line)

	local rightPad = 0
	if opts.swatch then rightPad = 34 end
	if opts.key then rightPad = 120 end

	local btn = new("TextButton", {
		Size = UDim2.new(1, -rightPad, 1, 0), BackgroundTransparency = 1, Text = str,
		TextColor3 = disabled and T.dim or T.text, Font = FONT, TextSize = SIZE,
		TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
	}, row)
	new("UIPadding", { PaddingLeft = UDim.new(0, 18) }, btn)

	local function setState(v)
		if disabled then return end
		state = v and true or false
		box.BackgroundColor3 = state and T.accent or T.field
		if opts.callback then opts.callback(state) end
	end
	btn.MouseButton1Click:Connect(function() setState(not state) end)
	register("chk", str, function() return state end, setState)

	if opts.swatch then
		local sw = new("TextButton", {
			Size = UDim2.fromOffset(32, 12), Position = UDim2.new(1, -32, 0, 3),
			BackgroundColor3 = opts.swatch, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
		}, row)
		sw.MouseButton1Click:Connect(function()
			local cur = 0
			for i, c in ipairs(PALETTE) do
				if c == sw.BackgroundColor3 then cur = i end
			end
			sw.BackgroundColor3 = PALETTE[cur % #PALETTE + 1]
		end)
		register("clr", str, function()
			local c = sw.BackgroundColor3
			return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
		end, function(v)
			if type(v) == "table" and #v == 3 then
				sw.BackgroundColor3 = Color3.fromRGB(v[1], v[2], v[3])
			end
		end)
	end

	if opts.key then
		local kb = keyButton(row, opts.key, nil, opts.keyMode or "toggle")
		register("key", str, kb.get, kb.set)
	end
	return row
end

function UI.slider(parent, str, min, max, default, callback)
	local value = math.clamp(default or min, min, max)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }, parent)
	text(row, str, T.text, 15)
	local bar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 15), Position = UDim2.fromOffset(0, 17),
		BackgroundColor3 = T.field, BorderSizePixel = 0, Active = true,
	}, row)
	stroke(bar)
	local fill = new("Frame", {
		Size = UDim2.new((value - min) / (max - min), 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0,
	}, bar)
	local lbl = new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = value .. "/" .. max,
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Font = FONT, TextSize = 12, ZIndex = 3,
	}, bar)

	local function setValue(v)
		value = math.clamp(math.floor(v + 0.5), min, max)
		fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
		lbl.Text = value .. "/" .. max
		if callback then callback(value) end
	end
	register("sld", str, function() return value end, function(v)
		if type(v) == "number" then setValue(v) end
	end)

	local dragging = false
	local function fromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * rel)
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(i.Position.X)
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return row
end

-- Floating dropdown: a popup that sits above everything, scrolls when long,
-- highlights hover + the selected entry, and closes on outside click.
function UI.dropdown(parent, str, options, default, callback, noSave)
	local opts = options
	local selected = default or opts[1]

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1,
	}, parent)
	text(holder, str, T.text, 15)
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 17), BackgroundColor3 = T.field,
		BorderSizePixel = 0, AutoButtonColor = false, Text = selected or "(none)",
		TextColor3 = selected and T.text or T.dim, Font = FONT, TextSize = SIZE,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)
	new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 18) }, btn)
	stroke(btn)
	hoverable(btn, T.field, T.hover)
	local arrow = new("TextLabel", {
		Size = UDim2.fromOffset(16, 20), Position = UDim2.new(1, -16, 0, 0), BackgroundTransparency = 1,
		Text = "v", TextColor3 = T.dim, Font = FONT, TextSize = 12,
	}, btn)

	local api = {}
	local function refreshButton()
		btn.Text = selected or "(none)"
		btn.TextColor3 = selected and T.text or T.dim
	end
	function api.get() return selected end
	function api.set(v)
		if table.find(opts, v) then
			selected = v
			refreshButton()
			if callback then callback(v) end
		end
	end
	function api.setOptions(newOpts)
		opts = newOpts
		if not selected or not table.find(opts, selected) then selected = opts[1] end
		refreshButton()
	end

	local function openPopup()
		if #opts == 0 then return end
		local bp, bs = btn.AbsolutePosition, btn.AbsoluteSize
		local ITEM_H = 22
		local h = math.min(#opts, 8) * ITEM_H
		local y = bp.Y + bs.Y + 2
		if y + h > gui.AbsoluteSize.Y then y = bp.Y - h - 2 end

		local popup = new("ScrollingFrame", {
			Size = UDim2.fromOffset(bs.X, h), Position = UDim2.fromOffset(bp.X, y),
			BackgroundColor3 = T.bg, BorderSizePixel = 0, ZIndex = 100,
			ScrollBarThickness = 3, ScrollBarImageColor3 = T.line,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, gui)
		stroke(popup, T.accent)
		list(popup, 0)

		local items = {}
		for _, opt in ipairs(opts) do
			local isSel = (opt == selected)
			local o = new("TextButton", {
				Size = UDim2.new(1, 0, 0, ITEM_H), BorderSizePixel = 0, AutoButtonColor = false,
				BackgroundColor3 = isSel and T.hover or T.bg, ZIndex = 101,
				Text = opt, TextColor3 = isSel and T.accent or T.dim, Font = FONT, TextSize = SIZE,
				TextXAlignment = Enum.TextXAlignment.Left, Active = true,
			}, popup)
			new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, o)
			if isSel then
				new("Frame", {
					Size = UDim2.new(0, 2, 1, 0), Position = UDim2.fromOffset(-10, 0),
					BackgroundColor3 = T.accent, BorderSizePixel = 0, ZIndex = 102,
				}, o)
			end
			o.MouseEnter:Connect(function()
				o.BackgroundColor3 = T.hover
				o.TextColor3 = T.text
			end)
			o.MouseLeave:Connect(function()
				o.BackgroundColor3 = isSel and T.hover or T.bg
				o.TextColor3 = isSel and T.accent or T.dim
			end)
			local function pick()
				selected = opt
				refreshButton()
				closeDrop()
				if callback then callback(opt) end
			end
			o.MouseButton1Down:Connect(pick)
			o.MouseButton1Click:Connect(pick)
			table.insert(items, o)
		end

		arrow.Text = "^"
		openDrop = {
			popup = popup, btn = btn, arrow = arrow,
			choose = function()
				for i, o in ipairs(items) do
					if o.Parent and hitGui(o) then
						selected = opts[i]
						refreshButton()
						if callback then callback(opts[i]) end
						return true
					end
				end
				return false
			end,
		}
	end

	function api.open()
		closeDrop()
		openPopup()
	end

	btn.MouseButton1Click:Connect(function()
		local wasThis = openDrop and openDrop.btn == btn
		closeDrop()
		if not wasThis then openPopup() end
	end)

	if not noSave then register("dd", str, api.get, api.set) end
	return api
end

function UI.button(parent, str, callback)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = T.field, BorderSizePixel = 0, AutoButtonColor = false,
		Text = str, TextColor3 = T.text, Font = FONT, TextSize = SIZE,
	}, parent)
	stroke(b)
	hoverable(b, T.field, T.hover)
	b.MouseButton1Click:Connect(function() if callback then callback() end end)
	return b
end

function UI.keybind(parent, str, default, callback, defaultMode)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1 }, parent)
	text(row, str, T.text, 20)
	local kb = keyButton(row, default, callback, defaultMode or "hold")
	register("key", str, kb.get, kb.set)
	return row
end

function UI.textbox(parent, placeholder, noSave)
	local box = new("TextBox", {
		Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = T.field, BorderSizePixel = 0,
		PlaceholderText = placeholder, Text = "", TextColor3 = T.text, PlaceholderColor3 = T.dim,
		Font = FONT, TextSize = SIZE, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
	}, parent)
	new("UIPadding", { PaddingLeft = UDim.new(0, 6) }, box)
	stroke(box)
	if not noSave then
		register("txt", placeholder, function() return box.Text end, function(v)
			if type(v) == "string" then box.Text = v end
		end)
	end
	return box
end

