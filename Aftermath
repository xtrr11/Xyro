-- Wired to the menu flags above. Nothing in the menu layout is rebuilt.
-- Aftermath uses custom rigs, so a character is "anything with a Humanoid".
-- Players are matched by Player.Character / name / UserId. Every other living
-- humanoid is a zombie or NPC. Chinese targets are the ones wearing Altyn,
-- Ratnik, or FSB gear (the powerplant zombie and the bunker soldiers).

local Camera = workspace.CurrentCamera
local Lighting = game:GetService("Lighting")
local VIM = game:GetService("VirtualInputManager")

local function flag(kind, tab, section, label)
	local f = Flags[kind .. ":" .. tab .. "/" .. section .. "/" .. label]
	if not f then return nil end
	local ok, v = pcall(f.get)
	if ok then return v end
end

local function on(tab, section, label)
	return flag("chk", tab, section, label) == true
end

local function num(tab, section, label, fallback)
	local v = flag("sld", tab, section, label)
	if type(v) == "number" then return v end
	return fallback
end

local function pick(tab, section, label, fallback)
	local v = flag("dd", tab, section, label)
	if type(v) == "string" and v ~= "" then return v end
	return fallback
end

local function swatch(tab, section, label, fallback)
	local v = flag("clr", tab, section, label)
	if type(v) == "table" and #v >= 3 then
		return Color3.fromRGB(v[1] or 255, v[2] or 255, v[3] or 255)
	end
	return fallback or WHITE
end

local function keyName(tab, section, label)
	local v = flag("key", tab, section, label)
	if type(v) ~= "string" or v == "" or v == "..." then return end
	local name = v:match("^(.-)|") or v
	if name ~= "" and name ~= "..." then return name end
end

local function keyMode(tab, section, label, fallback)
	local v = flag("key", tab, section, label)
	if type(v) == "string" then
		local m = v:match("|(.+)$")
		if m == "hold" or m == "toggle" or m == "always" then return m end
	end
	return fallback or "hold"
end

local function keyHeld(name)
	if not name then return false end
	local ok, code = pcall(function() return Enum.KeyCode[name] end)
	return ok and code ~= nil and UIS:IsKeyDown(code)
end

local bindLatch = {}

local function bindOn(tab, section, keyLabel, boxLabel, defaultMode)
	local mode = keyMode(tab, section, keyLabel, defaultMode)
	local held = keyHeld(keyName(tab, section, keyLabel))
	local box = on(tab, section, boxLabel)
	local id = tab .. "/" .. keyLabel
	if mode == "always" then return true end
	if mode == "hold" then return held or box end
	return bindLatch[id] == true or box
end

local function aimKeyHeld()
	return bindOn("Combat", "Aimbot", "Aimbot Key", "Aimbot", "hold")
end

local function moveOn(label)
	return bindOn("Combat", "Miscellaneous", label, label, "toggle")
