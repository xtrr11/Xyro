local function saveProp(inst, prop)
	local bag = limbLook[inst]
	if not bag then
		bag = {}
		limbLook[inst] = bag
	end
	if bag[prop] == nil then
		bag[prop] = inst[prop]
	end
end
local function restoreRoot(key)
	local list = styled[key]
	if not list then return end
	for inst in pairs(list) do
		local bag = limbLook[inst]
		if bag then
			if hiddenSA[inst] then
				pcall(function()
					inst.Parent = hiddenSA[inst]
				end)
				hiddenSA[inst] = nil
			end
			for prop, val in pairs(bag) do
				pcall(function()
					inst[prop] = val
				end)
			end
		end
		limbLook[inst] = nil
	end
	styled[key] = nil
end
local function track(key, inst)
	local list = styled[key]
	if not list then
		list = {}
		styled[key] = list
	end
	list[inst] = true
end
local function paintModel(key, model, enabled, color, materialName, pred)
	if not model or not enabled then
		restoreRoot(key)
		return
	end
	local mat = Enum.Material[materialName or "ForceField"] or Enum.Material.ForceField
	local drop = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("SurfaceAppearance") or d:IsA("WrapLayer") or d:IsA("WrapTarget") then
			local host = d.Parent
			if not pred or (host and host:IsA("BasePart") and pred(host)) then
				table.insert(drop, d)
			end
		elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			if d:IsA("Shirt") then
					saveProp(d, "ShirtTemplate")
					d.ShirtTemplate = ""
				elseif d:IsA("Pants") then
					saveProp(d, "PantsTemplate")
					d.PantsTemplate = ""
				else
					saveProp(d, "Graphic")
					d.Graphic = ""
				end
				track(key, d)
		elseif (d:IsA("Decal") or d:IsA("Texture") or d:IsA("MeshPart") or d:IsA("SpecialMesh")) and (not pred or (d:IsA("BasePart") and pred(d)) or (d.Parent and d.Parent:IsA("BasePart") and pred(d.Parent))) then
			if d:IsA("Decal") or d:IsA("Texture") then
				saveProp(d, "Transparency")
				d.Transparency = 1
			elseif d:IsA("MeshPart") then
				saveProp(d, "TextureID")
				pcall(function() d.TextureID = "" end)
			elseif d:IsA("SpecialMesh") then
				saveProp(d, "TextureId")
				pcall(function() d.TextureId = "" end)
			end
			track(key, d)
		end
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Name ~= "ServerCollider" and d.Name ~= "Collider" then
			if not pred or pred(d) then
				saveProp(d, "Material")
				saveProp(d, "Color")
				saveProp(d, "Transparency")
				d.Material = mat
				if color then d.Color = color end
				if d.Transparency > 0.8 then d.Transparency = 0 end
				track(key, d)
			end
		end
	end
	for _, d in ipairs(drop) do
		if d.Parent and hiddenSA[d] == nil then
			hiddenSA[d] = d.Parent
			d.Parent = nil
			track(key, d)
		end
	end
end
local function isLimb(part)
	local n = part.Name:lower()
	if n:find("gun", 1, true) or n:find("weapon", 1, true) or n:find("camera", 1, true) or n:find("optic", 1, true) then
		return false
	end
	return n == "head" or n:find("torso", 1, true) or n:find("arm", 1, true) or n:find("leg", 1, true) or n:find("hand", 1, true) or n:find("foot", 1, true)
end
local function paintLimbs(body, enabled, color, materialName)
	if not body then return end
	if not enabled then
		paintModel(body, body, false)
		return
	end
	restoreRoot(body)
	paintModel(body, body, true, color, materialName, isLimb)
	local mat = Enum.Material[materialName or "ForceField"] or Enum.Material.ForceField

	local function scrub(part)
		if not part or not part:IsA("BasePart") then return end
		part.Material = mat
		part.Color = color
		part.Reflectance = 0
		part.Transparency = 0.5
		if part:IsA("MeshPart") then pcall(function() part.TextureID = "" end) end
		for _, c in ipairs(part:GetDescendants()) do
			if c:IsA("SurfaceAppearance") or c:IsA("WrapLayer") or c:IsA("WrapTarget") then
				pcall(function() c.Parent = nil end)
			elseif c:IsA("SpecialMesh") then
				pcall(function() c.TextureId = "" end)
				pcall(function() c.MeshId = "" end)
			elseif c:IsA("Decal") or c:IsA("Texture") then
				pcall(function() c.Transparency = 1 end)
			elseif c:IsA("BasePart") then
				c.Material = mat
				c.Color = color
				c.Reflectance = 0
				c.Transparency = 0.5
				if c:IsA("MeshPart") then pcall(function() c.TextureID = "" end) end
			end
		end
	end

	-- scrub literally every BasePart in the model (head, hats, hair, everything)
	for _, d in ipairs(body:GetDescendants()) do
		if d:IsA("BasePart") then
			local n = d.Name:lower()
			if n == "humanoidrootpart" or n == "servercollider" or n == "collider" or n:find("camera", 1, true) then
				-- skip
			else
				scrub(d)
			end
		end
	end

	-- head skin match: half-transparent so it matches the body's glass look
	local head = body:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		head.Transparency = 0.5
		head.Material = mat
		head.Color = color
	end
end
