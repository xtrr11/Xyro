local BODY_WORD = { "head", "torso", "chest", "hip", "arm", "leg", "hand", "foot", "neck", "shoulder", "knee", "elbow", "wrist", "ankle", "pelvis", "spine", "upper", "lower" }
local SKIP_WORD = { "gun", "weapon", "mag", "sight", "optic", "attach", "cloth", "hair", "hat", "vest", "backpack", "holster", "finger", "thumb", "accout", "grip", "stock", "barrel", "muzzle" }

local function named(part, words)
	local n = part.Name:lower()
	for _, w in ipairs(words) do
		if n:find(w, 1, true) then return true end
	end
	return false
end

local function boneList(model)
	local list = {}
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Part0 ~= m.Part1 then
			if not named(m.Part0, SKIP_WORD) and not named(m.Part1, SKIP_WORD) then
				if named(m.Part0, BODY_WORD) or named(m.Part1, BODY_WORD) then
					local dist = (m.Part0.Position - m.Part1.Position).Magnitude
					if dist > 0.05 and dist < 3.2 then
						table.insert(list, { m.Part0, m.Part1, dist })
					end
				end
			end
		end
	end
	if #list > 0 then return list end
	local function exact(name)
		local p = model:FindFirstChild(name)
		if p and p:IsA("BasePart") then return p end
	end
	local head = exact("Head") or findPart(model, { "head" })
	local upper = exact("UpperTorso") or exact("Torso") or findPart(model, { "uppertorso", "torso", "chest" })
	local lower = exact("LowerTorso") or upper
	local lua = exact("LeftUpperArm") or exact("Left Arm")
	local lla = exact("LeftLowerArm") or lua
	local lhand = exact("LeftHand") or lla
	local rua = exact("RightUpperArm") or exact("Right Arm")
	local rla = exact("RightLowerArm") or rua
	local rhand = exact("RightHand") or rla
	local lul = exact("LeftUpperLeg") or exact("Left Leg")
	local lll = exact("LeftLowerLeg") or lul
	local lfoot = exact("LeftFoot") or lll
	local rul = exact("RightUpperLeg") or exact("Right Leg")
	local rll = exact("RightLowerLeg") or rul
	local rfoot = exact("RightFoot") or rll
	local function add(a, b)
		if a and b and a ~= b then table.insert(list, { a, b, (a.Position - b.Position).Magnitude }) end
	end
	add(head, upper)
	add(upper, lower)
	add(upper, lua) add(lua, lla) add(lla, lhand)
	add(upper, rua) add(rua, rla) add(rla, rhand)
	add(lower, lul) add(lul, lll) add(lll, lfoot)
	add(lower, rul) add(rul, rll) add(rll, rfoot)
	return list
end

