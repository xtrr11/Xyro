local leafCache = {}
local grassCache = {}
local foliageReady = false
local leafCursor = 1

local function sweepFoliage()
	local static = workspace:FindFirstChild("world_assets")
	static = static and static:FindFirstChild("StaticObjects")
	local treeFolder = static and static:FindFirstChild("Trees")
	if not treeFolder then return end
	if foliageReady and #leafCache > 0 then return end
	foliageReady = true
	table.clear(leafCache)
	table.clear(grassCache)
	local function consider(inst, into, words)
		local n = inst.Name:lower()
		for _, w in ipairs(words) do
			if n:find(w, 1, true) then
				if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
					table.insert(into, inst)
				end
				return
			end
		end
	end
	for _, tree in ipairs(treeFolder:GetChildren()) do
		consider(tree, leafCache, { "leaf", "leaves", "canopy", "frond", "bush" })
		consider(tree, grassCache, { "grass", "weed" })
		for _, p in ipairs(tree:GetChildren()) do
			consider(p, leafCache, { "leaf", "leaves", "canopy", "frond", "bush" })
			consider(p, grassCache, { "grass", "weed" })
		end
	end
	for _, folder in ipairs(static:GetChildren()) do
		if folder.Name:lower():find("grass", 1, true) then
			for _, p in ipairs(folder:GetChildren()) do
				if p:IsA("BasePart") then
					table.insert(grassCache, p)
				elseif p:IsA("Model") or p:IsA("Folder") then
					for _, c in ipairs(p:GetChildren()) do
						if c:IsA("BasePart") then table.insert(grassCache, c) end
					end
				end
			end
		end
	end
end

local function applyWorld(inst)
	if on("Environment", "World Modifications", "No Trees") or on("Environment", "World Modifications", "No Grass") then
		local trees = on("Environment", "World Modifications", "No Trees")
		local grass = on("Environment", "World Modifications", "No Grass")
		local function wanted(obj)
			local n = (obj.Name .. " " .. (obj.Parent and obj.Parent.Name or "")):lower()
			if trees and (n:find("leaf", 1, true) or n:find("bush", 1, true) or n:find("canopy", 1, true) or n:find("frond", 1, true)) then
				return true
			end
			if grass and (n:find("grass", 1, true) or n:find("plant", 1, true)) then
				return true
			end
			return false
		end
		if inst:IsA("BasePart") and wanted(inst) then
			markTree(inst)
		elseif inst:IsA("Model") and wanted(inst) then
			for _, p in ipairs(inst:GetDescendants()) do
				if p:IsA("BasePart") then markTree(p) end
			end
		end
	end
	if on("Environment", "World Modifications", "No Rain") then
		if inst:IsA("ParticleEmitter") then
			local n = inst.Name:lower()
			local p = inst.Parent and inst.Parent.Name:lower() or ""
			if n:find("rain", 1, true) or p:find("rain", 1, true) or n:find("precip", 1, true) then
				inst.Enabled = false
			end
		end
	end
end

local function restoreWorld()
	for inst, old in pairs(transOrig) do
		pcall(function()
			if inst:IsA("BasePart") then
				inst.LocalTransparencyModifier = old
			elseif inst:IsA("Decal") or inst:IsA("Texture") then
				inst.Transparency = old
			end
		end)
	end
	transOrig = {}
end

