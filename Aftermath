local function localEntity()
	local cam = workspace.CurrentCamera or workspace:FindFirstChildWhichIsA("Camera")
	if not cam then return end
	local origin = cam.CFrame.Position
	local view = cam:FindFirstChild("CurrentWeapon")
	local best, bestPart, bestD
	local function considerFolder(folder)
		if not folder then return end
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and not model:IsDescendantOf(cam) and model.Name ~= "PlayerGrave" then
				local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head")
				local part = (torso and torso:IsA("BasePart") and torso)
					or model:FindFirstChild("HumanoidRootPart")
					or model:FindFirstChild("ServerCollider")
					or model:FindFirstChildWhichIsA("BasePart")
				if part and part:IsA("BasePart") then
					local penalty = torso and 0 or 25
					local dist = (part.Position - origin).Magnitude + penalty
					if not bestD or dist < bestD then best, bestPart, bestD = model, part, dist end
				end
			end
		end
	end
	local assets = workspace:FindFirstChild("game_assets")
	considerFolder(assets and assets:FindFirstChild("Entities"))
	local default = workspace:FindFirstChild("Default")
	if default then
		for _, d in ipairs(default:GetChildren()) do
			if d:IsA("Folder") and d.Name ~= "PlayerGrave" then considerFolder(d) end
			if d:IsA("Model") then considerFolder(d.Parent) end
		end
	end
	if best and bestD and bestD < 160 then
		return best, bestPart, view
	end
end

-- Only the body sitting on this camera. Never the player you are spectating.
local function myBody()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local model, root, view = localEntity()
	if model and root and (root.Position - cam.CFrame.Position).Magnitude < 18 then
		return model, root, view
	end
	local char = lp.Character
	if char then
		local r = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		if r and (r.Position - cam.CFrame.Position).Magnitude < 18 then
			return char, r, view
		end
	end
end

local function myChar()
	local model, root, view = localEntity()
	local c = lp.Character or model or view
	local hum = c and (c:FindFirstChildOfClass("Humanoid") or c:FindFirstChildWhichIsA("Humanoid", true))
	if not root and c then
		root = (hum and hum.RootPart) or c:FindFirstChild("HumanoidRootPart")
			or c:FindFirstChild("Torso") or c:FindFirstChildWhichIsA("BasePart", true)
	end
	return c, hum, root
end

local function blobOf(model)
	local bits = { model.Name:lower() }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Accessory") or d:IsA("Clothing")
			or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic")
			or d:IsA("Decal") or d:IsA("CharacterMesh") then
			table.insert(bits, d.Name:lower())
		end
	end
	return table.concat(bits, " ")
end

local function playerOf(model)
	local plr = Players:GetPlayerFromCharacter(model)
	if plr then return plr end
	local attr = model:GetAttribute("UserId") or model:GetAttribute("PlayerId") or model:GetAttribute("OwnerId")
	if typeof(attr) == "number" then
		return Players:GetPlayerByUserId(attr)
	end
	if typeof(attr) == "string" then
		local n = tonumber(attr)
		if n then return Players:GetPlayerByUserId(n) end
		local byName = Players:FindFirstChild(attr)
		if byName and byName:IsA("Player") then return byName end
	end
	local byModel = Players:FindFirstChild(model.Name)
	if byModel and byModel:IsA("Player") then return byModel end
end

local function findPart(model, patterns)
	local best, bestScore
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local n = p.Name:lower()
			for i, pat in ipairs(patterns) do
				if n == pat or n:find(pat, 1, true) then
					local score = (n == pat and 0 or 10) + i
					if not bestScore or score < bestScore then
						best, bestScore = p, score
					end
				end
			end
		end
	end
	return best
end

local function aimPart(model, mode)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local head = findPart(model, { "head", "skull", "helmet" })
	local torso = findPart(model, { "uppertorso", "torso", "chest", "hips", "lowertorso" })
	local root = (hum and hum.RootPart) or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("ServerCollider") or model:FindFirstChild("Collider") or torso or head
	if mode == "Torso" then return torso or root or head end
	if mode == "Random" then
		local pool = {}
		if head then table.insert(pool, head) end
		if torso then table.insert(pool, torso) end
		if root then table.insert(pool, root) end
		if #pool == 0 then return nil end
		return pool[math.random(1, #pool)]
	end
	return head or torso or root
end

local function isChinese(model, blob)
	blob = blob or blobOf(model)
	if blob:find("chinese", 1, true) then return true end
	if blob:find("altyn", 1, true) then return true end
	if blob:find("ratnik", 1, true) then return true end
	if blob:find("fsb", 1, true) then return true end
	return false
end

local function canSee(part, model)
	local cam = workspace.CurrentCamera
	if not cam or not part then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { lp.Character, cam }
	params.FilterDescendantsInstances = ignore
	local origin = cam.CFrame.Position
	local hit = workspace:Raycast(origin, part.Position - origin, params)
	return hit == nil or hit.Instance:IsDescendantOf(model)
end

local function teamBlocked(plr)
	if not on("Combat", "Aimbot", "Team Check") and not on("Visuals", "Player ESP", "Team Check") then
