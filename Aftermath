-- entity cache, refreshed off the render loop because the map is huge
local function ownerOf(model)
	if not model then return end
	local function matchValue(v)
		if typeof(v) == "Instance" and v:IsA("Player") and v ~= lp then return v end
		local text = tostring(v)
		if text == "" or text == "nil" then return end
		local byId = tonumber(text)
		if byId then
			local plr = Players:GetPlayerByUserId(byId)
			if plr and plr ~= lp then return plr end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= lp and (plr.Name == text or plr.DisplayName == text) then
				return plr
			end
		end
	end
	local ok, attrs = pcall(function() return model:GetAttributes() end)
	if ok and type(attrs) == "table" then
		for _, v in pairs(attrs) do
			local plr = matchValue(v)
			if plr then return plr end
		end
	end
	local scripts = model:FindFirstChild("Scripts")
	local function scan(root)
		if not root then return end
		for _, d in ipairs(root:GetDescendants()) do
			local shown = nil
			if d:IsA("StringValue") then
				local key = d.Name:lower()
				if (key:find("name", 1, true) or key:find("user", 1, true) or key:find("player", 1, true) or key:find("owner", 1, true))
					and #d.Value >= 2 and #d.Value <= 24 and not d.Value:find("{", 1, true) then
					shown = d.Value
				end
			end
			if d:IsA("ValueBase") or d:IsA("ObjectValue") then
				local plr = matchValue(d.Value)
				if plr then return plr end
				local text = tostring(d.Value):lower()
				if text ~= "" and text ~= "nil" then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= lp and (text:find(p.Name:lower(), 1, true) or (p.DisplayName ~= "" and text:find(p.DisplayName:lower(), 1, true))) then
							return p
						end
					end
				end
			elseif d:IsA("TextLabel") or d:IsA("TextBox") then
				local plr = matchValue(d.Text)
				if plr then return plr end
			end
			local plr = matchValue(d.Name)
			if plr then return plr end
			if shown then
				return { DisplayName = shown, Name = shown }
			end
		end
	end
	return scan(scripts) or scan(model:FindFirstChild("Head")) or scan(model:FindFirstChild("HumanoidRootPart"))
end

