pcall(function()
	pcall(function()
	RunService:BindToRenderStep("XyroBodyCham", 2000000000, function()
		if chamBody and chamBody.Parent then
			paintLimbs(chamBody, true, chamBodyColor, chamBodyMat)
		end
		if hlBody and chamBody and chamBody.Parent then
			hlBody.Enabled = true
		elseif hlBody then
			hlBody.Enabled = false
		end
		if hlGun then hlGun.Enabled = false end
		if hlArm then hlArm.Enabled = false end
	end)
end)
		if chamBody and chamBody.Parent then
			paintLimbs(chamBody, true, chamBodyColor, chamBodyMat)
			local mat = Enum.Material[chamBodyMat or "ForceField"] or Enum.Material.ForceField
			local origin = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position
			local function glassHead(head)
				if not head or not head:IsA("BasePart") or not origin then return end
				if (head.Position - origin).Magnitude > 8 then return end
				head.Material = mat
				head.Color = chamBodyColor or WHITE
				head.Transparency = 0.45
				head.Reflectance = 0
				if head:IsA("MeshPart") then pcall(function() head.TextureID = "" end) end
				local mesh = head:FindFirstChildOfClass("SpecialMesh")
				if mesh then pcall(function() mesh.TextureId = "" end) end
			end
			local function forceHead(h)
				if not h or not h:IsA("BasePart") then return end
				h.Material = Enum.Material[chamBodyMat or "ForceField"] or Enum.Material.ForceField
				h.Color = chamBodyColor or WHITE
				h.Transparency = 0.5
				h.Reflectance = 0
				if h:IsA("MeshPart") then pcall(function() h.TextureID = "" end) end
				for _, c in ipairs(h:GetChildren()) do
					if c:IsA("SurfaceAppearance") or c:IsA("WrapLayer") or c:IsA("WrapTarget") then
						pcall(function() c:Destroy() end)
					elseif c:IsA("Decal") or c:IsA("Texture") then
						pcall(function() c.Transparency = 1 end)
					elseif c:IsA("SpecialMesh") then
						pcall(function() c.TextureId = "" c.MeshId = "" end)
					end
				end
				-- follow welds to any external head mesh (hat/hair/mask not inside the model)
				for _, w in ipairs(h:GetChildren()) do
					if w:IsA("Weld") or w:IsA("WeldConstraint") or w:IsA("Motor6D") then
						local other = (w.Part0 == h and w.Part1) or (w.Part1 == h and w.Part0)
						if other and other:IsA("BasePart") then
							other.Material = h.Material
							other.Color = h.Color
							other.Transparency = 0.5
							if other:IsA("MeshPart") then pcall(function() other.TextureID = "" end) end
							for _, c in ipairs(other:GetChildren()) do
								if c:IsA("SurfaceAppearance") then pcall(function() c:Destroy() end) end
								if c:IsA("Decal") or c:IsA("Texture") then pcall(function() c.Transparency = 1 end) end
							end
						end
					end
				end
			end
			forceHead(chamBody:FindFirstChild("Head", true))
			if lp.Character then forceHead(lp.Character:FindFirstChild("Head", true)) end
			local assets = workspace:FindFirstChild("game_assets")
			local folder = assets and assets:FindFirstChild("Entities")
			if folder then
				for _, model in ipairs(folder:GetChildren()) do
					forceHead(model:FindFirstChild("Head", true))
				end
			end
		end
		if chamBody and chamBody.Parent then
			hlBody = ensureHL(hlBody, chamBody, chamBodyColor or WHITE, chamBodyColor or WHITE)
			if hlBody then
				hlBody.FillTransparency = 0.5
				hlBody.OutlineTransparency = 1
				hlBody.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			end
		elseif hlBody then
			hlBody.Enabled = false
		end
		if hlGun then hlGun.Enabled = false end
		if hlArm then hlArm.Enabled = false end
	end)
end

-- render: esp, fov, aim, crosshair, recoil, weapon offset
connect(RunService.RenderStepped, function(dt)
	Camera = workspace.CurrentCamera
	if not Camera then return end
	local vp = Camera.ViewportSize
	local mouse = UIS:GetMouseLocation()

	-- drop stale humans
	for model, info in pairs(humans) do
		local plrGone = typeof(info.plr) == "Instance" and info.plr:IsA("Player") and not info.plr.Parent
		local dead = (not info.hum) or (not info.hum.Parent) or (info.hum.Health and info.hum.Health <= 0)
		if not model.Parent or dead or plrGone then
			restoreModelSizes(model)
			humans[model] = nil
			killEsp(model)
			watched[model] = nil
		else
			watchModel(model, info)
		end
	end

	local showPlayers = on("Visuals", "Player ESP", "Enable ESP")
	local showChinese = on("Visuals", "Zombie ESP", "Chinese Zombie ESP")
	local showZombies = on("Visuals", "Zombie ESP", "Normal Zombie ESP")
	local espTeam = on("Visuals", "Player ESP", "Team Check")
	local maxEsp = num("Visuals", "Player ESP", "ESP Max Distance", 3000) / STUD_TO_M
	local textSize = num("Visuals", "Object ESP", "Text Size", 13)

	local liveReps = {}
	local function addLive(part, plr, shown, pos, uid)
		local at = pos or (part and part:IsA("BasePart") and part.Position)
		if not at or not shown or shown == "" or plr == lp then return end
		for _, r in ipairs(liveReps) do
			if part and r.part == part then return end
			if (r.pos - at).Magnitude < 2 then return end
		end
		table.insert(liveReps, {
			pos = at, part = part, plr = plr, name = shown,
			uid = tonumber(uid) or (typeof(plr) == "Instance" and plr:IsA("Player") and plr.UserId) or nil,
		})
	end
	local function takeRep(d)
		if not d or not d.Name:find("Replication") then return end
		local uid = d.Name:match("(%d+)")
		local shown, plr = resolveUser(uid)
		local part = d:IsA("BasePart") and d or d:FindFirstChildWhichIsA("BasePart", true)
		if part and (shown or uid) and plr ~= lp then
			addLive(part, plr, shown or "...", part.Position, uid)
		end
	end
	local function scrapeCam(cam)
		if not cam then return end
		for _, d in ipairs(cam:GetDescendants()) do
			if d.Name:find("Replication") then
				takeRep(d)
			end
		end
	end
	scrapeCam(Camera)
	scrapeCam(workspace:FindFirstChild("Camera"))
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			local p = Camera:FindFirstChild("ReplicationPart_" .. tostring(plr.UserId), true)
			if not p then
				local alt = workspace:FindFirstChild("Camera")
				p = alt and alt:FindFirstChild("ReplicationPart_" .. tostring(plr.UserId), true)
			end
			if p then
				local shown = labelOf(plr, plr.UserId)
				local part = p:IsA("BasePart") and p or p:FindFirstChildWhichIsA("BasePart", true)
				if part and shown then addLive(part, plr, shown, part.Position) end
			end
		end
	end
	playerMarks = liveReps

	local function usernameAt(pos)
		if not pos then return end
		local bestName, bestD
		local function consider(part, plr)
			if not part or not part:IsA("BasePart") or not plr or plr == lp then return end
			local dist = (part.Position - pos).Magnitude
			if not bestD or dist < bestD then
				bestD = dist
				bestName = labelOf(plr, plr.UserId)
			end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= lp then
				local p = Camera:FindFirstChild("ReplicationPart_" .. tostring(plr.UserId))
					or Camera:FindFirstChild("ReplicationPart_" .. tostring(plr.UserId), true)
				if p then consider(p:IsA("BasePart") and p or p:FindFirstChildWhichIsA("BasePart", true), plr) end
			end
		end
		if not bestD or bestD > 400 then bestName = nil end
		if bestName then return bestName end
		for _, rep in ipairs(liveReps) do
			local dist = (rep.pos - pos).Magnitude
			if dist < 1200 and (not bestD or dist < bestD) then
				bestD = dist
				bestName = rep.name
			end
		end
		return bestName
	end

	local function bodyPos(model, info)
		local p = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head")
			or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
		if p and p:IsA("BasePart") then return p.Position end
		return info and info.root and info.root.Position
	end
	local nameOf = {}
	local openModels = {}
	for model, info in pairs(humans) do
		if rigKind(model) == "player" and info.root then
			local fromCam = (info.root.Position - Camera.CFrame.Position).Magnitude
			if fromCam < 18 then
				info.plr = nil
			else
				local owner = ownedBy[model] or ownedBy[model.Name] or ownedBy[(model.Name:gsub("[{}]", ""))] or ownerOf(model)
				if owner and owner ~= lp then
					info.plr = owner
					nameOf[model] = labelOf(owner, owner.UserId)
				elseif info.name and info.name ~= "" and info.name ~= "Player" and info.name ~= "..." then
					nameOf[model] = info.name
				elseif info.plr and info.plr ~= lp then
					local shown = labelOf(info.plr, info.plr.UserId)
					if shown then
						nameOf[model] = shown
					else
						info.plr = nil
						table.insert(openModels, model)
					end
				else
					info.plr = nil
					table.insert(openModels, model)
				end
			end
		end
	end
	local usedModel = {}
	for _, rep in ipairs(liveReps) do
		local best, bestD
		for _, model in ipairs(openModels) do
			if not usedModel[model] then
				local pos = bodyPos(model, humans[model])
				if pos then
					local dist = (pos - rep.pos).Magnitude
					if not bestD or dist < bestD then best, bestD = model, dist end
				end
			end
		end
			if best and (rep.plr or (rep.name and rep.name ~= "" and rep.name ~= "Player")) then
			usedModel[best] = true
			local shown = labelOf(rep.plr, rep.uid) or (rep.name ~= "..." and rep.name)
			if shown and shown ~= "" and shown ~= "Player" then
				nameOf[best] = shown
			end
			humans[best].plr = rep.plr or (shown and { DisplayName = shown, Name = shown, UserId = rep.uid })
		end
	end

	local seen = {}
	local me = select(1, localEntity())
	for model, info in pairs(humans) do
		if model == me or model:IsDescendantOf(Camera) or (info.root and model:FindFirstChild("UpperTorso") and (info.root.Position - Camera.CFrame.Position).Magnitude < 18) then
			if esp[model] then hideEsp(esp[model]) end
			continue
		end
		local rig = rigKind(model)
		if rig then info.kind = rig end
		if rig == nil then
			if esp[model] then hideEsp(esp[model]) end
			continue
		end
		local plr = info.plr
		local nearName = nameOf[model]
		local want = false
		local colr = WHITE
		local tag = model.Name
		if rig == "player" then
			want = showPlayers and not (plr and espTeam and teamBlocked(plr))
			colr = swatch("Visuals", "Player ESP", "Boxes", WHITE)
			local resolvedName = nearName
			if not resolvedName or resolvedName == "" or resolvedName == "..." or resolvedName == "Player" then
				resolvedName = plr and labelOf(plr, plr.UserId)
			end
			if not resolvedName or resolvedName == "" or resolvedName == "..." or resolvedName == "Player" then
				resolvedName = usernameAt(info.root and info.root.Position)
			end
			if resolvedName == "..." or resolvedName == "Player" then resolvedName = nil end
			if resolvedName and resolvedName ~= "" then
				tag = resolvedName
				info.name = resolvedName
			elseif not tag or tag == "" or tag:match("^{[%x%-]+}$") then
				local uid = (plr and plr.UserId) or info.uid
				if uid and namePending[uid] then
					tag = "..."
				else
					if not _G.__xyroIds then _G.__xyroIds = {} end
					if not _G.__xyroIds[model] then
						_G.__xyroIds._n = (_G.__xyroIds._n or 0) + 1
						_G.__xyroIds[model] = "P" .. _G.__xyroIds._n
					end
					tag = _G.__xyroIds[model]
				end
			end
		elseif rig == "zombie" then
			if info.chinese then
				want = showChinese
				colr = swatch("Visuals", "Zombie ESP", "Chinese Zombie ESP", RED)
				tag = "Chinese"
			else
				want = showZombies
				colr = swatch("Visuals", "Zombie ESP", "Normal Zombie ESP", WHITE)
				tag = "Zombie"
			end
		elseif plr or info.kind == "player" then
			want = showPlayers and not (plr and espTeam and teamBlocked(plr))
			colr = swatch("Visuals", "Player ESP", "Boxes", WHITE)
			tag = plr and plr.DisplayName or "Player"
		elseif info.chinese then
			want = showChinese
			colr = swatch("Visuals", "Zombie ESP", "Chinese Zombie ESP", RED)
			tag = "Chinese"
		else
			want = showZombies
			colr = swatch("Visuals", "Zombie ESP", "Normal Zombie ESP", WHITE)
			tag = "Zombie"
		end
		local dist = (info.root.Position - Camera.CFrame.Position).Magnitude
		if not want or dist > maxEsp then
			if esp[model] then hideEsp(esp[model]) end
			if chamHL[model] then chamHL[model].Enabled = false end
			continue
		end
		if want and dist <= maxEsp then
			seen[model] = true
			local e = ensureEsp(model)
			local head = aimPart(model, "Head") or info.root
			if head and info.root and (head.Position - info.root.Position).Magnitude > 14 then
				hideEsp(ensureEsp(model))
			else
			local bx, by, bw, bh = bodyScreenBox(model)
			if not bx then
				local half = math.max(info.root.Size.Y * 0.5, 3)
				local top = worldToScreen((head ~= info.root and head.Position or info.root.Position) + Vector3.new(0, 1.2, 0))
				local bot = worldToScreen(info.root.Position - Vector3.new(0, half + 2.2, 0))
				if top and bot then
					bh = math.max(math.abs(bot.Y - top.Y), 8)
					bw = bh * 0.45
					bx, by = top.X - bw * 0.5, math.min(top.Y, bot.Y)
				end
			end
			if bx then
				local x, y, w, h = bx, by, bw, bh
				local boxesOn = (rig == "player" and on("Visuals", "Player ESP", "Boxes")) or (rig == "zombie" and want)
				if boxesOn then
					local o = 1
					local outer = {
						Vector2.new(x - o, y - o), Vector2.new(x + w + o, y - o),
						Vector2.new(x + w + o, y + h + o), Vector2.new(x - o, y + h + o),
					}
					local inner = {
						Vector2.new(x, y), Vector2.new(x + w, y),
						Vector2.new(x + w, y + h), Vector2.new(x, y + h),
					}
					for i = 1, 4 do
						placeLine(e.boxOut[i], outer[i], outer[i % 4 + 1], 3, Color3.new(0, 0, 0))
						placeLine(e.box[i], inner[i], inner[i % 4 + 1], 1, colr)
					end
				else
					for i = 1, 4 do
						e.box[i].Visible = false
						e.boxOut[i].Visible = false
					end
				end
				local namesOn = (rig == "player" and on("Visuals", "Player ESP", "Names")) or (rig == "zombie" and on("Visuals", "Zombie ESP", "Zombie Names"))
				e.name.Visible = namesOn and true or false
				if namesOn then
					e.name.Text = tag
					e.name.TextSize = textSize
					e.name.TextColor3 = plr and swatch("Visuals", "Player ESP", "Names", WHITE) or colr
					e.name.Position = UDim2.fromOffset(x + w * 0.5, y - 2)
				end
				local distOn = (rig == "player" and on("Visuals", "Player ESP", "Distance"))
					or (rig == "zombie" and on("Visuals", "Zombie ESP", "Zombie Distance"))
				e.dist.Visible = distOn and true or false
				if distOn then
					e.dist.Text = toMeters(dist) .. "m"
					e.dist.TextSize = textSize
					e.dist.TextColor3 = swatch("Visuals", "Player ESP", "Distance", WHITE)
					e.dist.Position = UDim2.fromOffset(x + w * 0.5, y + h + 2)
				end
				local hpOn = rig == "player" and on("Visuals", "Player ESP", "Health Bar")
				if hpOn then
					local hp = info.hum.Health
					local maxhp = math.max(info.hum.MaxHealth, 1)
					local hv = model:FindFirstChild("Health", true)
					if hv and (hv:IsA("NumberValue") or hv:IsA("IntValue")) then
						hp = hv.Value
						local mv = model:FindFirstChild("MaxHealth", true)
						if mv and (mv:IsA("NumberValue") or mv:IsA("IntValue")) and mv.Value > 0 then
							maxhp = mv.Value
						end
					end
					local frac = math.clamp(hp / maxhp, 0, 1)
					e.hpBack.Visible = true
					e.hp.Visible = true
					e.hpBack.Position = UDim2.fromOffset(x - 6, y)
					e.hpBack.Size = UDim2.fromOffset(3, h)
					e.hpBack.BackgroundColor3 = Color3.new(0, 0, 0)
					e.hp.Position = UDim2.fromOffset(x - 5, y + h * (1 - frac))
					e.hp.Size = UDim2.fromOffset(1, math.max(h * frac, 1))
					e.hp.BackgroundColor3 = swatch("Visuals", "Player ESP", "Health Bar", PALETTE[5])
				else
					e.hp.Visible = false
					e.hpBack.Visible = false
				end
				local trOn = rig == "player" and on("Visuals", "Player ESP", "Tracers")
				if trOn then
					local from = Vector2.new(vp.X * 0.5, vp.Y)
					local to = Vector2.new(x + w * 0.5, y + h)
					placeLine(e.tracerOut, from, to, 3, Color3.new(0, 0, 0))
					placeLine(e.tracer, from, to, 1, swatch("Visuals", "Player ESP", "Tracers", WHITE))
				else
					e.tracer.Visible = false
					e.tracerOut.Visible = false
				end
				local skOn = on("Visuals", "Player ESP", "Skeleton")
				if skOn then
					local bones = boneList(model)
					local scol = swatch("Visuals", "Player ESP", "Skeleton", WHITE)
					local limit = math.clamp(math.max(h, 18) * 1.4, 18, 220)
					for i = 1, 28 do
						local pair = bones[i]
						local a = pair and worldToScreen(pair[1].Position)
						local b = pair and worldToScreen(pair[2].Position)
						local screenLen = (a and b) and (a - b).Magnitude or 0
						if a and b and screenLen >= 0.4 and screenLen <= limit then
							placeLine(e.boneOut[i], a, b, 2, Color3.new(0, 0, 0))
							placeLine(e.bones[i], a, b, 1, scol)
						else
							e.bones[i].Visible = false
							e.boneOut[i].Visible = false
						end
						e.joints[i].Visible = false
					end
				else
					for i = 1, 28 do
						e.bones[i].Visible = false
						e.boneOut[i].Visible = false
						e.joints[i].Visible = false
					end
				end
				local isPlayer = rig == "player"
				local wantCham = (isPlayer and (on("Visuals", "Player ESP", "Chams") or on("Visuals", "Chams", "Player Chams")))
					or ((not isPlayer) and (on("Visuals", "Zombie ESP", "Zombie Chams") or on("Visuals", "Chams", "Player Chams")))
				if wantCham then
					local mode = pick("Visuals", "Chams", "Chams Mode", "Always On Top")
					local inten = num("Visuals", "Chams", "Chams Intensity", 55) / 100
					local col = isPlayer and swatch("Visuals", "Player ESP", "Chams", MAGENTA) or swatch("Visuals", "Zombie ESP", "Zombie Chams", RED)
					chamHL[model] = ensureHL(chamHL[model], model, col, col)
					local hl = chamHL[model]
					if hl then
						hl.FillColor = col
						hl.OutlineColor = col
						hl.FillTransparency = mode == "Outline Only" and 1 or 0.25
						hl.OutlineTransparency = 0
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.Parent = model
						hl.Adornee = model
						hl.Enabled = true
					end
					if mode ~= "Outline Only" then
						paintModel(model, model, true, col, "ForceField", isLimb)
					end
				else
					if chamHL[model] then chamHL[model].Enabled = false end
					paintModel(model, model, false)
				end
			else
				hideEsp(e)
				if chamHL[model] then chamHL[model].Enabled = false end
			end
			end
		end
	end
	for model in pairs(chamHL) do
		if not seen[model] and chamHL[model] then
			chamHL[model].Enabled = false
			paintModel(model, model, false)
		end
	end
	for model in pairs(esp) do
		if not seen[model] and humans[model] == nil and worldObjs[model] == nil and graves[model] == nil then
			hideEsp(esp[model])
		end
	end

	if showPlayers then
		local drawn = {}
		for _, info in pairs(humans) do
			if info.plr then drawn[info.plr] = true end
		end
		for _, mark in ipairs(playerMarks) do
			local part = mark.part
			if mark.plr and part and part.Parent and not drawn[mark.plr] then
				local top = worldToScreen(part.Position + Vector3.new(0, 3, 0))
				local bot = worldToScreen(part.Position - Vector3.new(0, 3, 0))
				if top and bot then
					local e = ensureEsp(part)
					seen[part] = true
					local h = math.max(math.abs(bot.Y - top.Y), 8)
					local w = h * 0.55
					local x, y = top.X - w * 0.5, top.Y
					local outer = {
						Vector2.new(x - 1, y - 1), Vector2.new(x + w + 1, y - 1),
						Vector2.new(x + w + 1, y + h + 1), Vector2.new(x - 1, y + h + 1),
					}
					local inner = {
						Vector2.new(x, y), Vector2.new(x + w, y),
						Vector2.new(x + w, y + h), Vector2.new(x, y + h),
					}
					for i = 1, 4 do
						if on("Visuals", "Player ESP", "Boxes") then
							placeLine(e.boxOut[i], outer[i], outer[i % 4 + 1], 3, Color3.new(0, 0, 0))
							placeLine(e.box[i], inner[i], inner[i % 4 + 1], 1, swatch("Visuals", "Player ESP", "Boxes", WHITE))
						else
							e.box[i].Visible = false
							e.boxOut[i].Visible = false
						end
					end
					local showName = on("Visuals", "Player ESP", "Names")
					e.name.Visible = showName
					if showName then
						e.name.Text = (mark.plr and mark.plr.Name ~= "" and mark.plr.Name) or mark.name or "Player"
						e.name.TextSize = textSize
						e.name.TextColor3 = swatch("Visuals", "Player ESP", "Names", WHITE)
						e.name.Position = UDim2.fromOffset(x + w * 0.5, y - 2)
					end
					local showDist = on("Visuals", "Player ESP", "Distance")
					e.dist.Visible = showDist
					if showDist then
						e.dist.Text = toMeters((part.Position - Camera.CFrame.Position).Magnitude) .. "m"
						e.dist.TextSize = textSize
						e.dist.Position = UDim2.fromOffset(x + w * 0.5, y + h + 2)
					end
				end
			end
		end
	end

	if on("Visuals", "Player ESP", "Grave ESP") then
		for model, who in pairs(graves) do
			if not model.Parent then
				graves[model] = nil
				if esp[model] then hideEsp(esp[model]) end
			else
				local part = model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
				local sp = part and worldToScreen(part.Position)
				if sp then
					local e = ensureEsp(model)
					seen[model] = true
					for i = 1, 4 do
						e.box[i].Visible = false
						e.boxOut[i].Visible = false
					end
					e.hp.Visible = false
					e.hpBack.Visible = false
					e.tracer.Visible = false
					e.tracerOut.Visible = false
					e.name.Visible = true
					e.name.Text = who .. "  body"
					e.name.TextColor3 = Color3.fromRGB(190, 190, 190)
					e.name.TextSize = textSize
					e.name.Position = UDim2.fromOffset(sp.X, sp.Y)
				elseif esp[model] then
					hideEsp(esp[model])
				end
			end
		end
	end

	-- object esp labels (rebuilt lightly)
	for inst, info in pairs(worldObjs) do
		if not inst.Parent or not info.part.Parent then
			worldObjs[inst] = nil
			if esp[inst] then killEsp(inst) end
		else
			local kind = info.kind
			local enabled = (kind == "item" and on("Visuals", "Object ESP", "Item ESP"))
				or (kind == "vehicle" and on("Visuals", "Object ESP", "Vehicle ESP"))
				or (kind == "container" and on("Visuals", "Object ESP", "Container ESP"))
				or (kind == "grave" and on("Visuals", "Player ESP", "Grave ESP"))
			local sp = enabled and worldToScreen(info.part.Position)
			if sp then
				local e = ensureEsp(inst)
				for i = 1, 4 do
					e.box[i].Visible = false
					e.boxOut[i].Visible = false
				end
				e.hp.Visible = false
				e.hpBack.Visible = false
				e.tracer.Visible = false
				e.tracerOut.Visible = false
				e.dist.Visible = false
				e.name.Visible = true
				local colr = kind == "item" and swatch("Visuals", "Object ESP", "Item ESP", PALETTE[6])
					or kind == "vehicle" and swatch("Visuals", "Object ESP", "Vehicle ESP", PALETTE[4])
					or swatch("Visuals", "Object ESP", "Container ESP", WHITE)
				local d = math.floor((info.part.Position - Camera.CFrame.Position).Magnitude)
				e.name.Text = inst.Name .. "  " .. d .. "m"
				e.name.TextColor3 = colr
				e.name.TextSize = textSize
				e.name.Position = UDim2.fromOffset(sp.X, sp.Y)
			elseif esp[inst] then
				hideEsp(esp[inst])
			end
		end
	end
	for key, e in pairs(esp) do
		if not humans[key] and not worldObjs[key] then
			hideEsp(e)
		end
	end

	-- fov circle
	local fovOn = on("Combat", "Aimbot", "FOV Circle")
	fovRing.Visible = fovOn
	fovStroke.Enabled = fovOn
	if fovOn then
		local radius = num("Combat", "Aimbot", "FOV Radius", 260)
		local thick = math.clamp(num("Combat", "Aimbot", "FOV Thickness", 2), 1, 10)
		fovRing.Position = UDim2.fromOffset(mouse.X, mouse.Y)
		fovRing.Size = UDim2.fromOffset(radius * 2, radius * 2)
		fovStroke.Thickness = thick
		local style = pick("Combat", "Aimbot", "FOV Styles", "gradient")
		local base = swatch("Combat", "Aimbot", "FOV Circle", WHITE)
		fovHue = (fovHue + dt * num("Combat", "Aimbot", "FOV Spin Speed", 30) * 2) % 360
		if style == "rainbow" or style == "gradient" then
			fovStroke.Color = Color3.fromHSV(fovHue / 360, style == "gradient" and 0.35 or 1, 1)
			if style == "gradient" then
				fovStroke.Color = base:Lerp(Color3.fromHSV(fovHue / 360, 1, 1), 0.65)
			end
		else
			fovStroke.Color = base
		end
		if style == "dashed" then
			fovStroke.Transparency = (math.floor(fovHue / 20) % 2 == 0) and 0 or 0.65
		else
			fovStroke.Transparency = 0
		end
	end

	-- aimbot
	local aiming = aimKeyHeld()
	local method = pick("Combat", "Aimbot", "Aim method", "silent")
	local silentBlocked = on("Combat", "Target Settings", "Hitbox Expander")
		and on("Combat", "Target Settings", "Disables silent on HBE")
	if silentBlocked and method == "silent" then method = "camera" end
	if on("Combat", "Miscellaneous", "Instant Aim") then method = "camera" end

	if aiming then
		local keepVis = on("Combat", "Target Settings", "Only Target Visible Check")
		if lockModel and humans[lockModel] and lockPart and lockPart.Parent then
			if keepVis and not canSee(lockPart, lockModel) then
				lockModel, lockPart = nil, nil
			end
		else
			lockModel, lockPart = nil, nil
		end
		if not lockPart then
			lockModel, lockPart = chooseTarget()
		end
		if lockPart then
			local goal = lockPart.Position
			if method == "camera" or on("Combat", "Miscellaneous", "Instant Aim") then
				local smooth = num("Combat", "Aimbot", "Aimbot Smoothing", 1)
				local alpha = (smooth <= 0 or on("Combat", "Miscellaneous", "Instant Aim")) and 1
					or math.clamp((1 / math.max(smooth, 1)) * dt * 18, 0, 1)
				Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, goal), alpha)
			elseif method == "mouse" and type(mousemoverel) == "function" then
				local sp = worldToScreen(goal)
				if sp then
					local smooth = math.max(num("Combat", "Aimbot", "Aimbot Smoothing", 1), 1)
					mousemoverel((sp.X - mouse.X) / smooth, (sp.Y - mouse.Y) / smooth)
				end
			elseif method == "silent" and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				if (shotRoll or 100) <= num("Combat", "Aimbot", "Hit Chance", 100) then
					snapCamera(lockPart)
				end
			end
		end
	else
		lockModel, lockPart = nil, nil
	end

	-- trigger bot
	if on("Combat", "Aimbot", "Trigger Bot") and not (window.Visible and inside(window, mouse)) then
		local okHit, info = underCursor()
		if okHit then
			if not triggerHover then triggerHover = os.clock() end
			if (os.clock() - triggerHover) * 1000 >= num("Combat", "Aimbot", "Trigger Delay", 60) then
				local partName = pick("Combat", "Aimbot", "Trigger Hit Part", "Any")
				local part = info and aimPart(info.model, partName == "Any" and "Head" or partName)
				if (shotRoll or 100) <= num("Combat", "Aimbot", "Hit Chance", 100) then
					fireOnce(part)
				end
			end
		else
			triggerHover = nil
		end
	else
		triggerHover = nil
	end

	-- snapline
	local snapOn = on("Combat", "Aimbot", "Snapline")
	local snapTarget = lockPart
	if not snapTarget and on("Combat", "Aimbot", "Aimbot") then
		local m, p = chooseTarget()
		snapTarget = p
	end
	if snapOn and snapTarget then
		local sp = worldToScreen(snapTarget.Position)
		if sp then
			local thick = math.clamp(num("Combat", "Aimbot", "Snapline Thickness", 1), 1, 10)
			local colr = swatch("Combat", "Aimbot", "Snapline", WHITE)
			placeLine(snapOut, mouse, sp, thick + 2, Color3.new(0, 0, 0))
			placeLine(snapMain, mouse, sp, thick, colr)
		else
			snapOut.Visible = false
			snapMain.Visible = false
		end
	else
		snapOut.Visible = false
		snapMain.Visible = false
	end

	-- highlight current target
	if on("Combat", "Target Settings", "Highlight Target") and lockModel then
		hlTarget = ensureHL(hlTarget, lockModel, swatch("Combat", "Target Settings", "Highlight Target", MAGENTA), WHITE)
	elseif hlTarget then
		hlTarget.Enabled = false
	end

	-- crosshair
	local ch = on("Visuals", "Extras", "Crosshair")
	if ch then
		local s = num("Visuals", "Extras", "Crosshair Size", 6)
		local c = swatch("Visuals", "Extras", "Crosshair", WHITE)
		local cx, cy = vp.X * 0.5, vp.Y * 0.5
		placeLine(cross[1], Vector2.new(cx - s - 3, cy), Vector2.new(cx - 3, cy), 2, c)
		placeLine(cross[2], Vector2.new(cx + 3, cy), Vector2.new(cx + s + 3, cy), 2, c)
		placeLine(cross[3], Vector2.new(cx, cy - s - 3), Vector2.new(cx, cy - 3), 2, c)
		placeLine(cross[4], Vector2.new(cx, cy + 3), Vector2.new(cx, cy + s + 3), 2, c)
	else
		for i = 1, 4 do cross[i].Visible = false end
	end

	-- no recoil: if the camera pitches with no mouse movement, put the pitch back
	if on("Combat", "Miscellaneous", "No Recoil") and not aiming then
		local pitch, yaw, roll = Camera.CFrame:ToOrientation()
		local md = UIS:GetMouseDelta()
		if _G.__xyroPitch and math.abs(md.Y) < 0.4 and math.abs(md.X) < 0.4 then
			local dp = pitch - _G.__xyroPitch
			if math.abs(dp) > 0.001 and math.abs(dp) < 0.2 then
				Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromOrientation(_G.__xyroPitch, yaw, roll)
				pitch = _G.__xyroPitch
			end
		end
		_G.__xyroPitch = pitch
	else
		_G.__xyroPitch = nil
	end

	-- viewmodel material / offset / chams
	local vm = viewmodel()
	local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
	if on("Combat", "Miscellaneous", "No Spread") then
		zeroNamed(tool, { "spread", "bloom", "inaccur", "kick", "recoil" })
		zeroNamed(vm, { "spread", "bloom", "inaccur" })
	end
	if on("Combat", "Miscellaneous", "No Recoil") or on("Combat", "Miscellaneous", "No Weapon Bob") then
		zeroNamed(vm, { "bob", "sway", "recoil", "kick" })
		zeroNamed(tool, { "bob", "sway", "recoil" })
	end
	local function isViewArm(part)
		local n = part.Name:lower()
		if n == "humanoidrootpart" or n == "servercollider" or n == "camerabone" then return false end
		return n:find("arm", 1, true) or n:find("hand", 1, true) or n:find("torso", 1, true)
			or n:find("head", 1, true) or n:find("leg", 1, true) or n == "skin" or n:find("sleeve", 1, true)
	end
	local function isGunMesh(p)
		if not p:IsA("MeshPart") then return false end
		if isViewArm(p) then return false end
		local n = p.Name:lower()
		if n:find("camera", 1, true) or n:find("collider", 1, true) or n:find("root", 1, true) or n == "part" or n:find("bone", 1, true) then
			return false
		end
		return math.max(p.Size.X, p.Size.Y, p.Size.Z) < 8
	end
	local function isArmOnly(p)
		local n = p.Name:lower()
		if n == "left arm" or n == "right arm" or n == "leftarm" or n == "rightarm" then
			return false
		end
		if math.max(p.Size.X, p.Size.Y, p.Size.Z) > 5 then
			return false
		end
		return n == "skin" or n:find("hand", 1, true) or n:find("arm", 1, true) or n:find("sleeve", 1, true)
	end
	local gunMat = pick("Environment", "Local Modifications", "Gun Material", "ForceField")
	if on("Environment", "Local Modifications", "Gun Chams") and (vm or tool) then
		local col = swatch("Environment", "Local Modifications", "Gun Chams", WHITE)
		if hlGun then hlGun.Enabled = false end
		paintModel("gun", vm or tool, true, col, gunMat, isGunMesh)
	else
		if hlGun then hlGun.Enabled = false end
		paintModel("gun", vm or tool, false)
	end
	if on("Environment", "Local Modifications", "Arm Chams") and vm then
		local col = swatch("Environment", "Local Modifications", "Arm Chams", WHITE)
		if hlArm then hlArm.Enabled = false end
		paintModel("arms", vm, true, col, gunMat, isArmOnly)
	else
		if hlArm then hlArm.Enabled = false end
		paintModel("arms", vm, false)
	end
		if on("Environment", "Local Modifications", "Body Chams") then
		local body = select(1, myBody())
		local head = body and (body:FindFirstChild("Head") or body:FindFirstChild("UpperTorso"))
		local firstPerson = head and head:IsA("BasePart") and (head.Position - Camera.CFrame.Position).Magnitude < 4
		if body and not firstPerson then
			local col = swatch("Environment", "Local Modifications", "Body Chams", WHITE)
			local matName = pick("Environment", "Local Modifications", "Body Material", "ForceField")
			chamBody, chamBodyColor, chamBodyMat = body, col, matName
			paintLimbs(body, true, col, matName)
			if not hlBody or hlBody.Parent == nil then
				hlBody = Instance.new("Highlight")
				hlBody.Parent = highlightHost()
			end
			hlBody.Adornee = body
			hlBody.FillColor = col
			hlBody.OutlineColor = col
			hlBody.FillTransparency = 0.5
			hlBody.OutlineTransparency = 1
			hlBody.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hlBody.Enabled = true
		else
			chamBody = nil
			if hlBody then hlBody.Enabled = false end
			if body then paintLimbs(body, false) end
		end
	else
		chamBody = nil
		if hlBody then hlBody.Enabled = false end
		paintLimbs(select(1, myBody()), false)
	end
	if on("Environment", "Weapon Offsets", "Weapon Offsets") and vm and vm.Parent == Camera then
		local x = num("Environment", "Weapon Offsets", "X Value", 2) * 0.08
		local y = num("Environment", "Weapon Offsets", "Y Value", 0) * 0.08
		local z = num("Environment", "Weapon Offsets", "Z Value", -2) * 0.08
		local off = CFrame.new(x, y, z)
		local moved = false
		for _, p in ipairs(vm:GetDescendants()) do
			if p:IsA("BasePart") and p.Anchored then
				moved = true
				if not vmBase[p] then
					vmBase[p] = Camera.CFrame:ToObjectSpace(p.CFrame)
				end
				p.CFrame = Camera.CFrame * off * vmBase[p]
			end
		end
		if not moved then
			for _, m in ipairs(vm:GetDescendants()) do
				if m:IsA("Motor6D") and m.Part1 and m.Part1:IsDescendantOf(vm) then
					if not vmBase[m] then vmBase[m] = m.C0 end
					m.C0 = vmBase[m] * off
					break
				end
			end
		end
	else
		for inst, orig in pairs(vmBase) do
			if typeof(orig) == "CFrame" and inst.Parent and inst:IsA("Motor6D") then
				pcall(function() inst.C0 = orig end)
			end
		end
		vmBase = {}
	end

	-- bullet tracers from the camera to where you're shooting
	if on("Environment", "Local Modifications", "Bullet Tracers") and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		if not _G.__xyroNextTracer or os.clock() > _G.__xyroNextTracer then
				_G.__xyroNextTracer = os.clock() + 0.06
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { lp.Character, Camera }
				local dir = (lockPart and (lockPart.Position - Camera.CFrame.Position).Unit) or Camera.CFrame.LookVector
				local hit = workspace:Raycast(Camera.CFrame.Position, dir * 1500, params)
				local dest = hit and hit.Position or (Camera.CFrame.Position + dir * 300)
				local a0 = Camera.CFrame.Position + Camera.CFrame.LookVector * 2
				local p = Instance.new("Part")
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.Material = Enum.Material.Neon
				p.Size = Vector3.new(0.08, 0.08, (dest - a0).Magnitude)
				p.CFrame = CFrame.lookAt(a0, dest) * CFrame.new(0, 0, -p.Size.Z * 0.5)
				hue = (hue + 0.08) % 1
				p.Color = on("Environment", "Local Modifications", "Rainbow Bullet Tracers") and Color3.fromHSV(hue, 1, 1)
					or swatch("Environment", "Local Modifications", "Bullet Tracers", WHITE)
				p.Parent = tracerFolder
				local life = math.clamp(num("Environment", "Local Modifications", "Bullet Tracers Lifetime", 100) / 40, 0.2, 4)
				task.delay(life, function() p:Destroy() end)
		end
	end

	applyAntiAim(dt)

	-- keybind list
	local showKb = on("Visuals", "Extras", "Keybind List")
	kbList.Visible = showKb
	if showKb then
		local rows = {
			{ "Aimbot", keyName("Combat", "Aimbot", "Aimbot Key") or "F1", keyMode("Combat", "Aimbot", "Aimbot Key", "hold"), aimKeyHeld() },
			{ "Fly", keyName("Combat", "Miscellaneous", "Fly Hack") or "F2", keyMode("Combat", "Miscellaneous", "Fly Hack", "toggle"), moveOn("Fly Hack") },
			{ "Speed", keyName("Combat", "Miscellaneous", "Speed Hack") or "F1", keyMode("Combat", "Miscellaneous", "Speed Hack", "toggle"), moveOn("Speed Hack") },
			{ "Carfly", keyName("Combat", "Miscellaneous", "Carfly") or "F3", keyMode("Combat", "Miscellaneous", "Carfly", "toggle"), moveOn("Carfly") },
			{ "Menu", keyName("Settings", "Menu", "Menu Key") or "RightShift", keyMode("Settings", "Menu", "Menu Key", "toggle"), window.Visible },
		}
		for i, r in ipairs(rows) do
			local l = kbRow(i)
			l.Text = string.format("[%s]  %s  %s  %s", r[2], r[3], r[1], r[4] and "on" or "off")
			l.TextColor3 = r[4] and T.good or T.dim
			l.Visible = true
		end
	end
end)

-- heartbeat: movement, anti-aim, hitbox, neck, world, traps
connect(RunService.Heartbeat, function(dt)
	local c, hum, root = myChar()
	if hum and root then
		if moveOn("Speed Hack") then
			local data = lp:FindFirstChild("CharData")
			if not (data and data:FindFirstChild("Speed")) then
				if not savedSpeed then savedSpeed = hum.WalkSpeed end
				hum.WalkSpeed = num("Combat", "Miscellaneous", "Speed Value", 22)
			end
		elseif savedSpeed then
			hum.WalkSpeed = savedSpeed
			savedSpeed = nil
		end

		if on("Combat", "Miscellaneous", "Bunny Hop") then
			if UIS:IsKeyDown(Enum.KeyCode.Space) and hum.FloorMaterial ~= Enum.Material.Air then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end

		if moveOn("Fly Hack") then
			local data = lp:FindFirstChild("CharData")
			if data and data:FindFirstChild("Speed") then
				if flyV then stopFly() end
			else
			if not flyV or flyV.Parent ~= root then
				stopFly()
				flyV = Instance.new("BodyVelocity")
				flyV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
				flyV.Velocity = Vector3.zero
				flyV.Parent = root
				flyG = Instance.new("BodyGyro")
				flyG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
				flyG.P = 1e5
				flyG.CFrame = root.CFrame
				flyG.Parent = root
			end
			hum.PlatformStand = true
			local cam = workspace.CurrentCamera
			local d = Vector3.zero
			if not UIS:GetFocusedTextBox() then
				local cf = cam and cam.CFrame or CFrame.new()
				if UIS:IsKeyDown(Enum.KeyCode.W) then d += cf.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cf.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then d += cf.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cf.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.yAxis end
			end
			local spd = num("Combat", "Miscellaneous", "Fly Speed", 25) * 3
			flyV.Velocity = d.Magnitude > 0 and d.Unit * spd or Vector3.zero
			if cam then flyG.CFrame = cam.CFrame end
			end
		else
			if flyV then stopFly() end
		end

		-- carfly / car spin
		local seat = hum.SeatPart
		local car = seat and (seat:FindFirstAncestorOfClass("Model") or seat)
		if seat and moveOn("Carfly") then
			local primary = (car:IsA("Model") and (car.PrimaryPart or seat)) or seat
			local cam = workspace.CurrentCamera
			local d = Vector3.zero
			if cam and not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.W) then d += cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then d += cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.yAxis end
			end
			local spd = num("Combat", "Miscellaneous", "Carfly Speed", 100)
			pcall(function()
				primary.AssemblyLinearVelocity = d.Magnitude > 0 and d.Unit * spd or Vector3.zero
			end)
		end
		if seat and car and on("Combat", "Miscellaneous", "Car-Spin") then
			local primary = (car:IsA("Model") and (car.PrimaryPart or seat)) or seat
			local spd = num("Combat", "Miscellaneous", "Carspin Speed", 100)
			pcall(function()
				primary.CFrame = primary.CFrame * CFrame.Angles(0, math.rad(spd) * dt * 4, 0)
			end)
		end

		-- spin bot / anti aim. Runs again on render so the character script can't turn it back.
		applyAntiAim(dt)

		if on("Combat", "Miscellaneous", "No Impact Damage") then
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
			if root.AssemblyLinearVelocity.Y < -40 then
				root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, math.max(root.AssemblyLinearVelocity.Y, -40), root.AssemblyLinearVelocity.Z)
			end
		end

		-- long neck: lift the head motor
		if on("Combat", "Target Settings", "Long Neck") then
			local lift = num("Combat", "Target Settings", "Long Neck Value", 5) * 0.45
			for _, m in ipairs(c:GetDescendants()) do
				local isBone = m:IsA("Bone")
				local isMotor = m:IsA("Motor6D")
				if isBone or isMotor then
					local n = m.Name:lower() .. " " .. ((isMotor and m.Part1 and m.Part1.Name) or ""):lower()
					if n:find("head", 1, true) or n:find("neck", 1, true) then
						if not neckOrig[m] then
							neckOrig[m] = isBone and m.Transform or m.C0
						end
						local lifted = neckOrig[m] * CFrame.new(0, lift, 0)
						if isBone then m.Transform = lifted else m.C0 = lifted end
					end
				end
			end
		else
			restoreNeck()
		end
	end

	-- hitbox expander (client side, on the head part)
	local expand = on("Combat", "Target Settings", "Hitbox Expander")
	local onlyTarget = on("Combat", "Target Settings", "Target Only Hitbox")
	local radius = num("Combat", "Target Settings", "Hitbox Radius", 8)
	local trans = num("Combat", "Target Settings", "Hitbox Transparency", 70) / 100
	for model, info in pairs(humans) do
		local head = findPart(model, { "head" }) or info.root
		local plrGone = typeof(info.plr) == "Instance" and info.plr:IsA("Player") and not info.plr.Parent
		local dead = (info.hum and info.hum.Health and info.hum.Health <= 0) or not model.Parent or plrGone
		if dead then
			restoreModelSizes(model)
		elseif head then
			if not sizeOrig[head] then
				sizeOrig[head] = { head.Size, head.Transparency }
			end
			local grow = expand and (not onlyTarget or model == lockModel)
			if grow then
				head.Size = Vector3.new(radius, radius, radius)
				head.Transparency = trans
				pcall(function()
					head.CanCollide = false
					head.CanQuery = true
				end)
			else
				local orig = sizeOrig[head]
				if orig then
					head.Size = orig[1]
					head.Transparency = orig[2]
				end
			end
		end
	end

	-- movement tracers
	if on("Environment", "Local Modifications", "Movement Tracers") and root then
		if not lastTracerPos or (root.Position - lastTracerPos).Magnitude > 2.5 then
			lastTracerPos = root.Position
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.Material = Enum.Material.Neon
			p.Size = Vector3.new(0.35, 0.35, 0.35)
			p.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.5, 0))
			p.Color = swatch("Environment", "Local Modifications", "Movement Tracers", WHITE)
			p.Parent = tracerFolder
			local life = math.clamp(num("Environment", "Local Modifications", "Movement Tracers Lifetime", 100) / 25, 0.4, 6)
			task.delay(life, function() p:Destroy() end)
		end
	end

	-- world
	if on("Environment", "World Modifications", "Full Bright") then
		if not lightBackup then
			lightBackup = { Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows, Lighting.Ambient, Lighting.OutdoorAmbient }
		end
		local b = num("Environment", "World Modifications", "Brightness Value", 1)
		Lighting.Brightness = math.max(2, b)
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
	elseif lightBackup then
		Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows, Lighting.Ambient, Lighting.OutdoorAmbient = unpack(lightBackup)
		lightBackup = nil
	end
	if on("Environment", "World Modifications", "No Fog") then
		if not fogBackup then fogBackup = Lighting.FogEnd end
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 1e5
		local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmo then
			if not atmoBackup then atmoBackup = { atmo, atmo.Density, atmo.Haze } end
			atmo.Density = 0
			atmo.Haze = 0
		end
	elseif fogBackup then
		Lighting.FogEnd = fogBackup
		fogBackup = nil
		if atmoBackup then
			pcall(function()
				atmoBackup[1].Density = atmoBackup[2]
				atmoBackup[1].Haze = atmoBackup[3]
			end)
			atmoBackup = nil
		end
	end
	if on("Environment", "World Modifications", "No Grass") then
		pcall(function() workspace.Terrain.Decoration = false end)
	end
	if on("Environment", "World Modifications", "No Trees") or on("Environment", "World Modifications", "No Grass") then
		if not _G.__xyroFoliageAt or os.clock() > _G.__xyroFoliageAt then
			_G.__xyroFoliageAt = os.clock() + 2
			task.spawn(sweepFoliage)
		end
	elseif next(transOrig) then
		restoreWorld()
	end

	if on("Combat", "Miscellaneous", "No Beartrap Damage") then
		touchTraps(true)
	end
	if on("Environment", "Miscellaneous", "Remove Altyn FaceMask UI") then
		altynMask(true)
	elseif next(maskHidden) then
		altynMask(false)
		maskHidden = {}
	end

	-- vehicle chams while seated
	if hum and hum.SeatPart and (on("Environment", "Vehicle Customization", "Material Changer") or on("Environment", "Vehicle Customization", "Remove Textures")) then
		local car = hum.SeatPart:FindFirstAncestorOfClass("Model")
		if car then
			if on("Environment", "Vehicle Customization", "Material Changer") then
				local t = num("Environment", "Vehicle Customization", "Vehicle Transparency", 49) / 100
				setMaterial(car, pick("Environment", "Vehicle Customization", "Vehicle Material", "ForceField"),
					swatch("Environment", "Vehicle Customization", "Material Changer", MAGENTA), t)
			end
			if on("Environment", "Vehicle Customization", "Remove Textures") then
				for _, d in ipairs(car:GetDescendants()) do
					pcall(function()
						if d:IsA("MeshPart") then d.TextureID = "" end
						if d:IsA("SpecialMesh") then d.TextureId = "" end
						if d:IsA("Decal") or d:IsA("Texture") then d.Transparency = 1 end
					end)
				end
			end
		end
	end

	-- staff detector, this game only
	if on("Combat", "Target Settings", "Staff Detector") then
		if not _G.__xyroStaffAt or os.clock() > _G.__xyroStaffAt then
			_G.__xyroStaffAt = os.clock() + 8
			task.spawn(function()
				local hits = {}
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= lp then
						local reason
						pcall(function()
							if game.CreatorType == Enum.CreatorType.User and plr.UserId == game.CreatorId then
								reason = "game owner"
							end
							if not reason and game.CreatorType == Enum.CreatorType.Group then
								local role = plr:GetRoleInGroup(game.CreatorId)
								local rank = plr:GetRankInGroup(game.CreatorId)
								local lower = string.lower(role or "")
								if lower:find("admin", 1, true) or lower:find("mod", 1, true) or lower:find("dev", 1, true)
									or lower:find("owner", 1, true) or lower:find("staff", 1, true) then
									reason = role
								elseif on("Combat", "Target Settings", "Detect Ranked Players") and rank >= 200 then
									reason = role .. " (" .. rank .. ")"
								end
							end
						end)
						if reason then
							table.insert(hits, plr.DisplayName .. " - " .. reason)
						end
					end
				end
				if #hits > 0 then
					notify("Staff here:\n" .. table.concat(hits, "\n"), false)
				end
			end)
		end
	end
end)

