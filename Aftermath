					end
					if c:IsA("Folder") or c:IsA("Model") or c:IsA("Configuration") then
						read(c, depth + 1)
					end
				end
			end
			pcall(read, g, 0)
			graves[g] = label
		end
	end
	if default then
		for _, folder in ipairs(default:GetChildren()) do
			if folder ~= graveFolder then
				local n = folder.Name:lower()
				if n:find("vehicle", 1, true) or n:find("car", 1, true) or n:find("truck", 1, true) or n:find("drive", 1, true) then
