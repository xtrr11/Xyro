local function rootOf(model, hum)
	if hum and hum.RootPart then return hum.RootPart end
	local named = model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("ServerCollider")
		or model:FindFirstChild("Collider")
		or model:FindFirstChild("RootPart")
		or model:FindFirstChild("Root")
		or model:FindFirstChild("Hitbox")
		or model:FindFirstChild("Collision")
		or model:FindFirstChild("Collider")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("LowerTorso")
		or model:FindFirstChild("Hips")
		or model:FindFirstChild("Chest")
		or model:FindFirstChild("Pelvis")
	if named and named:IsA("BasePart") then return named end
	if model.PrimaryPart then return model.PrimaryPart end
	return model:FindFirstChildWhichIsA("BasePart")
end

local function considerHuman(model, force, plrOverride)
	if not model or not model:IsA("Model") then return end
	local hum = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildWhichIsA("Humanoid", true)
	local plr = plrOverride or playerOf(model)
	if model == lp.Character or plr == lp then return end
	if not force and not hum and not plr then return end
	if hum and hum.Health <= 0 then return end
	local root = rootOf(model, hum)
	if not root then
		local best, vol
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				local v = p.Size.X * p.Size.Y * p.Size.Z
				if v > 0.05 and (not vol or v > vol) then best, vol = p, v end
			end
		end
		root = best
	end
	if not root then return end
	if not hum then
		hum = {
			Health = 100, MaxHealth = 100, Parent = model, WalkSpeed = 16,
			PlatformStand = false, AutoRotate = true, RootPart = root,
			MoveDirection = Vector3.zero, FloorMaterial = Enum.Material.Air, SeatPart = nil,
			HealthChanged = { Connect = function() return { Disconnect = function() end } end },
			Died = { Connect = function() return { Disconnect = function() end } end },
			ChangeState = function() end,
			SetStateEnabled = function() end,
		}
	end
	local blob = blobOf(model)
	humans[model] = {
		model = model, hum = hum, root = root, plr = plr,
		chinese = (not plr) and isChinese(model, blob) or false,
		blob = blob,
	}
end

local OBJ_WORDS = {
	item = { "ammo", "medkit", "bandage", "food", "mre", "water", "magazine", "grenade", "floppy", "armor", "vest", "helmet", "backpack", "rucksack", "daypack" },
	vehicle = {},
	container = { "crate", "cache", "locker", "cabinet", "container", "cooler", "drawer", "safe", "ammobox", "supply", "chest", "box" },
}

local function isWreck(inst)
	local node = inst
	for _ = 1, 3 do
		if not node then break end
		local n = node.Name:lower()
		if n:find("wreck", 1, true) or n:find("broken", 1, true) or n:find("destroyed", 1, true)
			or n:find("ruin", 1, true) or n:find("husk", 1, true) or n:find("burnt", 1, true)
			or n:find("abandoned", 1, true) or n:find("scrap", 1, true) or n:find("debris", 1, true) then
			return true
		end
		node = node.Parent
	end
	return false
end

local function tagObject(inst)
	if not inst or inst == lp.Character then return end
	local n = inst.Name:lower()
	local kind
	if inst:IsA("VehicleSeat") or inst:FindFirstChildWhichIsA("VehicleSeat", true) then
		if isWreck(inst) then return end
		kind = "vehicle"
	end
	for k, words in pairs(OBJ_WORDS) do
		if not kind then
			for _, w in ipairs(words) do
				if n:find(w, 1, true) then kind = k break end
			end
		end
	end
	if not kind and inst:IsA("Tool") then kind = "item" end
	if not kind and inst:IsA("ProximityPrompt") then
		local act = ((inst.ActionText or "") .. " " .. (inst.ObjectText or "")):lower()
		local model = inst:FindFirstAncestorOfClass("Model")
		if model and not model:FindFirstChildWhichIsA("Humanoid", true) then
			if act:find("open", 1, true) or act:find("search", 1, true) or act:find("loot", 1, true) then
				kind = "container"
			else
				kind = "item"
			end
			inst = model
		end
	end
	if not kind then return end
	if inst:IsA("ProximityPrompt") then
		inst = inst:FindFirstAncestorOfClass("Model")
		if not inst then return end
	end
	if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then return end
	local part = inst:IsA("BasePart") and inst or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
	if not part and inst:IsA("Model") then
		part = inst:FindFirstChildWhichIsA("BasePart", true)
	end
	if part then
		worldObjs[inst] = { inst = inst, part = part, kind = kind }
	end
end

local function rescan()
	humans = {}
	local seen = {}
	local cam = workspace.CurrentCamera
	local origin = cam and cam.CFrame.Position
	local myModel = select(1, localEntity())
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			considerHuman(plr.Character)
			seen[plr.Character] = true
		end
	end
	for _, fname in ipairs({ "GroundWeapons", "RefillAmmo", "GroundAttachments" }) do
		local folder = workspace:FindFirstChild(fname)
		if folder then
			for _, d in ipairs(folder:GetChildren()) do
				local part
				if d:IsA("BasePart") then
					part = d
				elseif d:IsA("Model") then
					part = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
				end
				if part and not isWreck(d) then
					worldObjs[d] = { inst = d, part = part, kind = "item" }
				end
			end
		end
	end
	pcall(function()
		local function pull(className, kind)
			local ok, list = pcall(function()
				return workspace:QueryDescendants(className)
			end)
			if not ok or type(list) ~= "table" then return end
			for _, inst in ipairs(list) do
				if kind == "vehicle" then
					local model = inst:FindFirstAncestorOfClass("Model") or inst
					if not isWreck(model) then tagObject(model) end
				else
					tagObject(inst)
				end
			end
		end
		pull("VehicleSeat", "vehicle")
		pull("ProximityPrompt", "prompt")
	end)
	local reps = {}
	ownedBy = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			local function claim(key)
				if key == nil or key == "" then return end
				ownedBy[key] = plr
				if typeof(key) == "string" then
					ownedBy[key:gsub("[{}]", "")] = plr
				end
			end
			claim(plr.Name)
			claim(plr.DisplayName)
			claim(tostring(plr.UserId))
			if plr.Character then claim(plr.Character) end
			pcall(function()
				local attrs = plr:GetAttributes()
				for _, v in pairs(attrs) do
					claim(v)
				end
			end)
			pcall(function()
				for _, d in ipairs(plr:GetDescendants()) do
					if d:IsA("ObjectValue") and typeof(d.Value) == "Instance" then
						claim(d.Value)
					elseif d:IsA("StringValue") and d.Value ~= "" then
						claim(d.Value)
					end
				end
			end)
		end
	end
	local function addRep(part, plr, uid)
		if not part or not part:IsA("BasePart") or plr == lp then return end
		uid = tonumber(uid) or (typeof(plr) == "Instance" and plr:IsA("Player") and plr.UserId)
		local shown = labelOf(plr, uid)
		if (not shown or shown == "") and not uid and not plr then return end
		table.insert(reps, {
			plr = plr,
			pos = part.Position,
			part = part,
			name = (shown and shown ~= "") and shown or "...",
			uid = uid,
		})
	end
	local function scrape(root, depth)
		if not root or depth > 3 then return end
		for _, d in ipairs(root:GetChildren()) do
			if d.Name:find("ReplicationPart") then
				local uid = d.Name:match("%d+")
				local plr = uid and Players:GetPlayerByUserId(tonumber(uid))
				local posPart = d:IsA("BasePart") and d or d:FindFirstChildWhichIsA("BasePart", true)
				if posPart and (not plr or plr ~= lp) then
					addRep(posPart, plr, uid)
				end
			elseif d.Name ~= "CurrentWeapon" and not d:IsA("BasePart") then
				scrape(d, depth + 1)
			end
		end
	end
	scrape(cam, 0)
	scrape(workspace:FindFirstChild("Camera"), 0)
