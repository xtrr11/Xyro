local function applyAntiAim(dt)
	local model, root = myBody()
	if not model or not root then
		if aaOn then
			aaOn = false
			staticYaw = nil
		end
		return
	end
	local hum = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildWhichIsA("Humanoid", true)
	if hum and hum.SeatPart then
		if aaOn then
			pcall(function() hum.AutoRotate = savedAuto end)
			aaOn = false
			staticYaw = nil
		end
		return
	end
	local spinning = on("Combat", "Target Settings", "Spin-Bot")
	local anti = on("Combat", "Miscellaneous", "Anti Aim")
	if flyV or (not spinning and not anti) then
		if aaOn then
			pcall(function() hum.AutoRotate = savedAuto end)
			aaOn = false
			staticYaw = nil
		end
		return
	end
	if hum then
		if not aaOn then
			savedAuto = hum.AutoRotate
			aaOn = true
			staticYaw = nil
		end
		hum.AutoRotate = false
	end
	local cam = workspace.CurrentCamera
	local camYaw = 0
	if cam then
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.05 then
			camYaw = math.atan2(-flat.X, -flat.Z)
		end
	end
	local mode = pick("Combat", "Miscellaneous", "Anti Aim Mode", "random")
	local t = os.clock()
	local yaw, pitch = camYaw, 0
	if spinning and not anti then
		yaw = t * math.max(num("Combat", "Target Settings", "Spin-Bot Speed", 25), 1) * 0.45
	elseif mode == "static" then
		if not staticYaw then
			local _, y = root.CFrame:ToOrientation()
			staticYaw = y
		end
		yaw = staticYaw
	elseif mode == "zero" then
		yaw = 0
		pitch = 0
	elseif mode == "backwards" then
		yaw = camYaw + math.pi
	elseif mode == "fake angle" then
		yaw = camYaw + math.pi + 0.55
	elseif mode == "sideways" or mode == "left" then
		yaw = camYaw + math.pi / 2
	elseif mode == "right" then
		yaw = camYaw - math.pi / 2
	elseif mode == "slow spin" then
		yaw = t * 1.8
	elseif mode == "spin" then
		yaw = t * 6
	elseif mode == "fast spin" then
		yaw = t * 18
	elseif mode == "jitter" then
		yaw = camYaw + ((math.floor(t * 9) % 2 == 0) and 1.25 or -1.25)
	elseif mode == "flicker" then
		yaw = camYaw + math.sin(t * 45) * 1.5
	elseif mode == "switch" then
		local step = math.floor(t * 3) % 4
		yaw = camYaw + (step == 0 and math.pi or step == 1 and math.pi / 2 or step == 2 and -math.pi / 2 or 0)
	elseif mode == "desync" then
		local vel = root.AssemblyLinearVelocity
		local flat = Vector3.new(vel.X, 0, vel.Z)
		local base = camYaw
		if flat.Magnitude > 1 then
			base = math.atan2(-flat.X, -flat.Z)
		end
		yaw = base + math.pi
	elseif mode == "spin jitter" then
		yaw = t * 10 + ((math.floor(t * 18) % 2 == 0) and 0.8 or -0.8)
	elseif mode == "up" or mode == "sky" then
		yaw = camYaw
		pitch = -1.25
	elseif mode == "down" then
		yaw = camYaw
		pitch = 1.2
	else
		yaw = camYaw + math.noise(t * 2.4, 0.2) * math.pi
	end
	if mode ~= "static" then staticYaw = nil end
	if spinning and anti then
		yaw = yaw + t * math.max(num("Combat", "Target Settings", "Spin-Bot Speed", 25), 1) * 0.2
	end
	local data = lp:FindFirstChild("CharData")
	local yawVal = data and data:FindFirstChild("Yaw")
	if yawVal and yawVal:IsA("NumberValue") then
		yawVal.Value = yaw
	end
	local function pitchJoint(d, angle, lift)
		local n = d.Name:lower()
		local headish = n:find("neck", 1, true) or n:find("head", 1, true) or n:find("camera", 1, true)
		local part = (d:IsA("Motor6D") or d:IsA("Weld")) and (d.Part1 or d.Part0)
		if part and part.Name:lower():find("head", 1, true) then headish = true end
		if not headish then return end
		if d:IsA("Bone") then
			d.Transform = CFrame.new(0, lift or 0, 0) * CFrame.Angles(angle or 0, 0, 0)
		elseif d:IsA("Motor6D") or d:IsA("Weld") then
			if typeof(neckOrig[d]) ~= "CFrame" then neckOrig[d] = d.C0 end
			d.C0 = neckOrig[d] * CFrame.new(0, lift or 0, 0) * CFrame.Angles(angle or 0, 0, 0)
		end
	end
	local body = model
	if body and (spinning or anti) and mode ~= "sky" then
		pcall(function()
			local cf = body:GetPivot()
			body:PivotTo(CFrame.new(cf.Position) * CFrame.Angles(0, yaw, 0))
		end)
	end
	if body and on("Combat", "Target Settings", "Long Neck") then
		local lift = math.clamp(num("Combat", "Target Settings", "Long Neck Value", 5), 0, 6)
		for _, d in ipairs(body:GetDescendants()) do
			pitchJoint(d, 0, lift * 0.35)
		end
	end
	if anti and mode == "sky" then
		local saved = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
		local function rig(model)
			if not model then return end
			for _, d in ipairs(model:GetDescendants()) do
				pitchJoint(d, -1.15, 0)
			end
		end
		rig(body)
		rig(workspace.CurrentCamera and workspace.CurrentCamera:FindFirstChild("CurrentWeapon"))
		if workspace.CurrentCamera and saved then
			workspace.CurrentCamera.CFrame = saved
		end
	end
end

