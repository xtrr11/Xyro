local function httpGet(url)
	if type(game.HttpGet) == "function" then
		local ok, body = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(body) == "string" and body ~= "" then return body end
	end
	local req = (type(request) == "function" and request)
		or (type(http_request) == "function" and http_request)
		or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
		or (type(http) == "table" and type(http.request) == "function" and http.request)
	if not req then return end
	local ok, res = pcall(req, { Url = url, Method = "GET" })
	if not ok or type(res) ~= "table" then return end
	local body = res.Body or res.body
	if type(body) == "string" and body ~= "" then return body end
end

local function nameFromJson(body)
	if type(body) ~= "string" then return end
	local name = body:match('"name"%s*:%s*"([^"\\]+)"')
	if name and name ~= "" and name ~= "Player" then return name end
end

local function resolveUser(uid)
	local n = tonumber(uid)
	if not n or n == lp.UserId then return end
	local plr = Players:GetPlayerByUserId(n)
	if not plr then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId == n then
				plr = p
				break
			end
		end
	end
	if plr and plr ~= lp then
		local shown = (plr.Name ~= "" and plr.Name ~= "Player" and plr.Name)
			or (plr.DisplayName ~= "" and plr.DisplayName ~= "Player" and plr.DisplayName)
		if shown then
			nameCache[n] = shown
			return shown, plr
		end
	end
	if type(nameCache[n]) == "string" and nameCache[n] ~= "" then
		return nameCache[n], plr
	end
	if not namePending[n] then
		namePending[n] = true
		task.spawn(function()
			local name
			local ok, res = pcall(function()
				return Players:GetNameFromUserIdAsync(n)
			end)
			if ok and type(res) == "string" and res ~= "" and res ~= "Player" then
				name = res
			end
			-- Aftermath blanks names on the character. The UserId is still on the
			-- replication part, so look the account up through a Roblox user proxy.
			if not name then
				local urls = {
					"https://users.roproxy.com/v1/users/" .. n,
					"https://users.roblox.com/v1/users/" .. n,
				}
				for _, url in ipairs(urls) do
					name = nameFromJson(httpGet(url))
					if name then break end
				end
			end
			namePending[n] = nil
			if name then nameCache[n] = name end
		end)
	end
	return nil, plr
end

local function labelOf(plr, uid)
	uid = tonumber(uid) or (typeof(plr) == "Instance" and plr:IsA("Player") and plr.UserId)
	if uid and type(nameCache[uid]) == "string" and nameCache[uid] ~= "" then
		return nameCache[uid]
	end
	if typeof(plr) == "Instance" and plr:IsA("Player") and plr ~= lp then
		if plr.Name ~= "" and plr.Name ~= "Player" then
			if plr.UserId then nameCache[plr.UserId] = plr.Name end
			return plr.Name
		end
		if plr.DisplayName ~= "" and plr.DisplayName ~= "Player" then
			return plr.DisplayName
		end
	end
	if uid then
		local name = resolveUser(uid)
		if type(name) == "string" and name ~= "" then return name end
	end
end

