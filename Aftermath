-- aim state
local lockModel, lockPart
local silentRestore
local fovHue = 0

local function chooseTarget()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local mouse = UIS:GetMouseLocation()
	local maxDist = num("Combat", "Target Settings", "Max Distance", 1500)
	local fov = num("Combat", "Aimbot", "FOV Radius", 260)
	local method = pick("Combat", "Aimbot", "Aim method", "silent")
	local mode = (method == "silent") and pick("Combat", "Aimbot", "Silent Hit Part", "Head")
		or pick("Combat", "Target Settings", "Hit Part", "Head")
	local needVis = on("Combat", "Target Settings", "Visible Check")
	local best, bestPart, bestD
	local myModel = select(1, localEntity())
	for model, info in pairs(humans) do
		if model == myModel or info.self then continue end
		local hp = info.hum and info.hum.Health or 100
		if info.root and info.root.Parent and hp > 0 then
			if not (info.plr and teamBlocked(info.plr)) then
				local dist = (info.root.Position - cam.CFrame.Position).Magnitude
				if dist <= maxDist then
					local part = aimPart(model, mode)
					if part then
						local sp = worldToScreen(part.Position)
						if sp then
							local d = (sp - mouse).Magnitude
							if d <= fov and (not needVis or canSee(part, model)) then
								if not bestD or d < bestD then
									best, bestPart, bestD = model, part, d
								end
							end
						end
					end
				end
			end
		end
	end
	return best, bestPart
end

local function underCursor()
	local cam = workspace.CurrentCamera
	if not cam then return false end
	local mouse = UIS:GetMouseLocation()
	local mode = pick("Combat", "Aimbot", "Trigger Hit Part", "Any")
	if mode == "Any" then mode = "Random" end
	local maxDist = num("Combat", "Target Settings", "Max Distance", 1500)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { lp.Character, cam }
	local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * maxDist, params)
	if hit then
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		local info = model and humans[model]
		if info and info.hum.Health > 0 and not (info.plr and teamBlocked(info.plr)) then
			local want = mode
			local n = hit.Instance.Name:lower()
			local group = (n:find("head", 1, true) or n:find("helmet", 1, true)) and "Head" or "Torso"
			if want == "Random" or group == want or (want == "Head" and group == "Head") or (want == "Torso" and group == "Torso") then
				return true, info
			end
		end
	end
	for model, info in pairs(humans) do
		if info.hum.Health > 0 and not (info.plr and teamBlocked(info.plr)) then
			local part = aimPart(model, mode == "Random" and "Head" or mode)
			local sp = part and worldToScreen(part.Position)
			if sp then
				local depth = (part.Position - cam.CFrame.Position).Magnitude
				if depth <= maxDist then
					local px = math.clamp(1600 / math.max(depth, 8), 16, 54)
					if (sp - mouse).Magnitude <= px then
						if not on("Combat", "Target Settings", "Visible Check") or canSee(part, model) then
							return true, info
						end
					end
				end
