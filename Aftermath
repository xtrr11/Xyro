			Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows, Lighting.Ambient, Lighting.OutdoorAmbient = unpack(lightBackup)
		end)
	end
	if fogBackup then pcall(function() Lighting.FogEnd = fogBackup end) end
	if tracerFolder then tracerFolder:Destroy() end
	for _, hl in ipairs({ hlTarget, hlGun, hlArm, hlBody }) do
		if hl then pcall(function() hl:Destroy() end) end
	end
end)

