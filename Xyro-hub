	local hitGui = new("ScreenGui", {
		Name = "XyroHitLogs", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parentGui)
	local hitList = new("Frame", {
		Size = UDim2.fromOffset(330, 220), Position = UDim2.new(0, 16, 0, 70), BackgroundTransparency = 1,
	}, hitGui)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, hitList)

	local HIT_POS = {
		["Top Left"] = UDim2.new(0, 16, 0, 70),
		["Top Center"] = UDim2.new(0.5, -165, 0, 70),
		["Bottom Left"] = UDim2.new(0, 16, 1, -260),
	}
	local hitCounter = 0

	local function richEsc(s)
		s = tostring(s):gsub("&", "&amp;")
		s = s:gsub("<", "&lt;")
		s = s:gsub(">", "&gt;")
		return s
	end

	local function limbName(partName)
		local n = partName:lower()
		if n:find("head", 1, true) then return "Head" end
		local left, right = n:find("left", 1, true), n:find("right", 1, true)
		if n:find("arm", 1, true) or n:find("hand", 1, true) then
			return left and "Left Arm" or (right and "Right Arm" or "Arm")
		end
		if n:find("leg", 1, true) or n:find("foot", 1, true) then
			return left and "Left Leg" or (right and "Right Leg" or "Leg")
		end
		return "Torso"
	end

	local function showHitLog(plr, dmg, limb, dist)
		if not Flags["Hit Logs"] then return end
		hitList.Position = HIT_POS[Flags["Hit Log Position"]] or HIT_POS["Top Left"]
		hitCounter += 1

		-- keep at most 6 on screen (oldest has the highest LayoutOrder)
		local entries = {}
		for _, ch in ipairs(hitList:GetChildren()) do
			if ch:IsA("Frame") then table.insert(entries, ch) end
		end
		if #entries >= 6 then
			table.sort(entries, function(a, b) return a.LayoutOrder > b.LayoutOrder end)
			entries[1]:Destroy()
		end

		local entry = new("Frame", {
			Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(14, 16, 26),
			BackgroundTransparency = 1, LayoutOrder = -hitCounter,
		}, hitList)
		corner(entry, 6)
		local es = stroke(entry, T.Accent, 1, 1)
		local bar = new("Frame", {
			Size = UDim2.new(0, 3, 1, -10), Position = UDim2.fromOffset(7, 5),
			BackgroundColor3 = T.Accent, BorderSizePixel = 0, BackgroundTransparency = 1,
		}, entry)
		corner(bar, 2)
		local txt = new("TextLabel", {
			Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(18, 0), BackgroundTransparency = 1,
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
			RichText = true, TextTransparency = 1,
			Text = string.format(
				'Hit <font color="#%s"><b>%s</b></font> in the <font color="#%s">%s</font> for <font color="#ff6b6b"><b>%d</b></font>  <font color="#8a90ad">(%d studs)</font>',
				T.Accent:ToHex(), richEsc(plr.DisplayName), T.Green:ToHex(), limb,
				math.floor(dmg + 0.5), math.floor(dist)),
		}, entry)

		local fast = TweenInfo.new(0.2)
		TweenService:Create(entry, fast, { BackgroundTransparency = 0.12 }):Play()
		TweenService:Create(es, fast, { Transparency = 0.5 }):Play()
		TweenService:Create(bar, fast, { BackgroundTransparency = 0 }):Play()
		TweenService:Create(txt, fast, { TextTransparency = 0 }):Play()

		task.delay(Flags["Hit Log Duration"] or 4, function()
			if not entry.Parent then return end
			local out = TweenInfo.new(0.3)
			TweenService:Create(entry, out, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(es, out, { Transparency = 1 }):Play()
			TweenService:Create(bar, out, { BackgroundTransparency = 1 }):Play()
			local t = TweenService:Create(txt, out, { TextTransparency = 1 })
			t:Play()
			t.Completed:Wait()
			entry:Destroy()
		end)
	end

	local lastFire = { t = 0, origin = Vector3.zero, dir = Vector3.new(0, 0, -1) }
	local lastAim = { t = 0, part = nil }

	local function markFire()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		lastFire.t = os.clock()
		lastFire.origin = ray.Origin
		lastFire.dir = ray.Direction.Unit
	end

	local hitFireConn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			markFire()
		end
	end)

	local hitBeat = RunService.Heartbeat:Connect(function()
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then markFire() end
		local part = (Flags["Enable Aimbot"] and lockPart and lockPart.Parent and keyHeld() and lockPart) or silentPart
		if part and part.Parent then
			lastAim.t = os.clock()
			lastAim.part = part
		end
	end)

	local function onDamage(plr, dmg)
		if not Flags["Hit Logs"] or dmg < 0.5 then return end
		local now = os.clock()
		if now - lastFire.t > 0.7 then return end
		local c = plr.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		if not c or not root then return end

		local limb
		if lastAim.part and now - lastAim.t < 0.7 and lastAim.part:IsDescendantOf(c) then
			limb = limbName(lastAim.part.Name)
		else
			-- which body part is closest to the line you were shooting along?
			local bestPart, bestPerp
			for _, part in ipairs(c:GetChildren()) do
				if part:IsA("BasePart") then
					local v = part.Position - lastFire.origin
					local proj = v:Dot(lastFire.dir)
					if proj > 0 then
						local perp = (v - lastFire.dir * proj).Magnitude
						if not bestPerp or perp < bestPerp then bestPart, bestPerp = part, perp end
					end
				end
			end
			if bestPart and bestPerp < 6 + (bestPart.Position - lastFire.origin).Magnitude * 0.08 then
				limb = limbName(bestPart.Name)
			end
		end
		if not limb then return end

		local cam = workspace.CurrentCamera
		local dist = (root.Position - (cam and cam.CFrame.Position or lastFire.origin)).Magnitude
		showHitLog(plr, dmg, limb, dist)
	end

	local hitHum, hitCharConns = {}, {}

	local function watchHumanoid(plr, char)
		local hum = char:WaitForChild("Humanoid", 5)
		if not hum then return end
		if hitHum[plr] then hitHum[plr]:Disconnect() end
		local last = hum.Health
		hitHum[plr] = hum.HealthChanged:Connect(function(h)
			local dmg = last - h
			last = h
			if dmg > 0 then onDamage(plr, dmg) end
		end)
	end

	local function watchHitPlayer(plr)
		if plr == LocalPlayer then return end
		if plr.Character then task.spawn(watchHumanoid, plr, plr.Character) end
		if hitCharConns[plr] then hitCharConns[plr]:Disconnect() end
		hitCharConns[plr] = plr.CharacterAdded:Connect(function(ch)
			watchHumanoid(plr, ch)
		end)
	end

	for _, plr in ipairs(Players:GetPlayers()) do watchHitPlayer(plr) end
	local hitAddConn = Players.PlayerAdded:Connect(watchHitPlayer)
	local hitRemoveConn = Players.PlayerRemoving:Connect(function(plr)
		if hitHum[plr] then
			hitHum[plr]:Disconnect()
			hitHum[plr] = nil
		end
		if hitCharConns[plr] then
			hitCharConns[plr]:Disconnect()
			hitCharConns[plr] = nil
		end
	end)

	--// ------------------------ DESYNC ------------------------
	local serverMarker
	local savedCF

	local function hideMarker()
		if not serverMarker then return end
		serverMarker.Transparency = 1
		local tag = serverMarker:FindFirstChild("Tag")
		if tag then tag.Enabled = false end
	end

	local function ensureMarker()
		if serverMarker and serverMarker.Parent then return serverMarker end
		local p = Instance.new("Part")
		p.Name = "XyroServerMarker"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.ForceField
		p.Size = Vector3.new(2.2, 4.6, 1.2)
		p.Transparency = 1
		p.Parent = workspace
		local bb = Instance.new("BillboardGui")
		bb.Name = "Tag"
		bb.Size = UDim2.fromOffset(160, 36)
		bb.StudsOffset = Vector3.new(0, 3.4, 0)
		bb.AlwaysOnTop = true
		bb.Enabled = false
		bb.Parent = p
		local tl = Instance.new("TextLabel")
		tl.Name = "Label"
		tl.BackgroundTransparency = 1
		tl.Size = UDim2.fromScale(1, 1)
		tl.Font = Enum.Font.GothamBold
		tl.TextSize = 13
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.45
		tl.Text = "SERVER"
		tl.Parent = bb
		serverMarker = p
		return p
	end

	local function spoofCFrame(real)
		local dist = Flags["Desync Distance"] or 14
		local mode = Flags["Desync Mode"] or "Underground"
		if mode == "Behind" then
			return real * CFrame.new(0, 0, dist)
		elseif mode == "Above" then
			return real * CFrame.new(0, dist, 0)
		elseif mode == "Random" then
			return real * CFrame.new((math.random() - 0.5) * dist * 2, (math.random() - 0.5) * dist, (math.random() - 0.5) * dist * 2)
		elseif mode == "Spin" then
			return CFrame.new(real.Position) * CFrame.Angles(0, os.clock() * 8, 0) * CFrame.new(0, 0, dist)
		end
		return real * CFrame.new(0, -math.abs(dist), 0)
	end

	local desyncHB = RunService.Heartbeat:Connect(function()
		local _, _, root = myChar()
		if not Flags["Desync"] or not root then
			savedCF = nil
			hideMarker()
			return
		end
		savedCF = root.CFrame
		local spoof = spoofCFrame(savedCF)
		root.CFrame = spoof
		root.AssemblyLinearVelocity = Vector3.zero
		if Flags["Show Server Position"] then
			local g = ensureMarker()
			g.Transparency = 0.45
			g.Color = Flags["Server Marker Color"] or Color3.fromRGB(99, 102, 241)
			g.CFrame = spoof
			local tag = g:FindFirstChild("Tag")
			if tag then
				tag.Enabled = true
				local lbl = tag:FindFirstChild("Label")
				if lbl then
					lbl.Text = string.format("SERVER  %.0f studs", (spoof.Position - savedCF.Position).Magnitude)
				end
			end
		else
			hideMarker()
		end
	end)

	local desyncRS = RunService.RenderStepped:Connect(function()
		if not Flags["Desync"] or not savedCF then return end
		local _, _, root = myChar()
		if root then
			root.CFrame = savedCF
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end)

	Features["Desync"] = function(on)
		if not on then
			savedCF = nil
			hideMarker()
		end
	end

	--// ------------------------ STAFF DETECTOR ------------------------
	-- Only judges players by what applies in THIS game: the game's own group role,
	-- the game owner, Roblox staff, and what this game shows (teams, values,
	-- attributes, overhead tags). Groups a player has elsewhere are ignored.
	local STAFF_WORDS = {
		"admin", "administrator", "mod", "mods", "moderator", "staff", "dev", "developer", "developers",
		"owner", "co owner", "coowner", "founder", "manager", "helper", "support", "head admin",
	}
	local COMPACT_HITS = {
		"headadmin", "superadmin", "coowner", "trialmod", "jradmin", "sradmin",
		"senioradmin", "junioradmin", "gameadmin", "headmod", "headadministrator",
	}

	local function roleIsStaff(role)
		if type(role) ~= "string" or role == "" then return false end
		local lower = string.lower(role)
		local compact = string.gsub(lower, "[^%a]", "")
		for _, w in ipairs(COMPACT_HITS) do
			if string.find(compact, w, 1, true) then return true end
		end
		local cleaned = " " .. string.gsub(lower, "[^%a]", " ") .. " "
		cleaned = string.gsub(cleaned, "%s+", " ")
		for _, w in ipairs(STAFF_WORDS) do
			if string.find(cleaned, " " .. w .. " ", 1, true) then return true end
		end
		return false
	end

	local function truthy(v)
		return v ~= nil and v ~= false and v ~= 0 and v ~= ""
	end

	local function escPattern(str)
		return (str:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0"))
	end

	-- remove the player's own name so a user called "AdminFan" doesn't look like a rank
	local function stripNames(text, plr)
		text = tostring(text)
		for _, n in ipairs({ plr.Name, plr.DisplayName }) do
			if #n > 0 then text = text:gsub(escPattern(n), " ") end
		end
		return text
	end

	-- strings count if their text is a staff rank; numbers/bools count only if the
	-- value's NAME is staff-like AND the value is actually on (IsAdmin = false is fine)
	local function valueStaff(name, value, plr)
		if type(value) == "string" then
			return value ~= "" and roleIsStaff(stripNames(value, plr))
		end
		return roleIsStaff(tostring(name)) and truthy(value)
	end

	local StaffFound, checking = {}, {}
	local staffCharConns = {}

	local function scanExtras(plr)
		if plr.Team and roleIsStaff(plr.Team.Name) then
			return "Team " .. plr.Team.Name
		end
		local ls = plr:FindFirstChild("leaderstats")
		if ls then
			for _, v in ipairs(ls:GetChildren()) do
				if v:IsA("ValueBase") then
					local ok, val = pcall(function() return v.Value end)
					if ok and valueStaff(v.Name, val, plr) then
						return v.Name .. ": " .. tostring(val)
					end
				end
			end
		end
		for _, ch in ipairs(plr:GetChildren()) do
			if ch:IsA("ValueBase") then
				local ok, val = pcall(function() return ch.Value end)
				if ok and valueStaff(ch.Name, val, plr) then
					return ch.Name .. ": " .. tostring(val)
				end
			end
		end
		local okAttr, attrs = pcall(function() return plr:GetAttributes() end)
		if okAttr and attrs then
			for name, val in pairs(attrs) do
				if valueStaff(name, val, plr) then
					return "Attribute " .. name .. " = " .. tostring(val)
				end
			end
		end
		if Flags["Check Nametags"] ~= false then
			local char = plr.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum and roleIsStaff(stripNames(hum.DisplayName, plr)) then
					return "Tag " .. hum.DisplayName
				end
				for _, d in ipairs(char:GetDescendants()) do
					if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= ""
						and d:FindFirstAncestorOfClass("BillboardGui")
						and roleIsStaff(stripNames(d.Text, plr)) then
						return "Nametag " .. d.Text
					end
				end
			end
		end
	end

	local function updateStaffLabel()
		if not staffLabel then return end
		if not Flags["Staff Detector"] then
			staffLabel.Text = "Staff detector is off."
			return
		end
		local names = {}
		for plr, why in pairs(StaffFound) do
			table.insert(names, plr.DisplayName .. " (" .. why .. ")")
		end
		staffLabel.Text = (#names == 0) and "No staff detected in this server."
			or ("Staff in server:\n" .. table.concat(names, "\n"))
	end

	local function onStaff(plr, reason)
		updateStaffLabel()
		notify("STAFF: " .. plr.Name .. " - " .. reason, Color3.fromRGB(255, 90, 90), 6)
		local action = Flags["Detector Action"]
		if action == "Kick" then
			LocalPlayer:Kick("[Xyro] Staff detected: " .. plr.Name .. " (" .. reason .. ")")
		elseif action == "Server Hop" then
			task.wait(0.5)
			serverHop()
		end
	end

	local function checkPlayer(plr)
		if plr == LocalPlayer or StaffFound[plr] or checking[plr] then return end
		checking[plr] = true
		local reason
		pcall(function()
			-- the person who owns THIS game
			if Flags["Check Game Owner"] and game.CreatorType == Enum.CreatorType.User and plr.UserId == game.CreatorId then
				reason = "Game owner"
			end
			-- Roblox employees
			if not reason and Flags["Check Roblox Staff"] and plr:GetRankInGroup(1200769) > 0 then
				reason = "Roblox staff"
			end
			-- role in THIS game's group (only when the game belongs to a group)
			if not reason and Flags["Check Group Roles"] and game.CreatorType == Enum.CreatorType.Group then
				local gid = game.CreatorId
				local role = plr:GetRoleInGroup(gid)
				local rank = plr:GetRankInGroup(gid)
				if roleIsStaff(role) then
					reason = role
				elseif rank > 0 and rank >= (Flags["Staff Rank Threshold"] or 100) then
					reason = role .. ", rank " .. rank
				end
			end
			-- what this game itself displays for the player
			if not reason and Flags["Check In-Game Ranks"] ~= false then
				reason = scanExtras(plr)
			end
		end)
		checking[plr] = nil
		if reason and Flags["Staff Detector"] and plr.Parent then
			StaffFound[plr] = reason
			onStaff(plr, reason)
		end
	end

	local function watchChar(plr)
		if staffCharConns[plr] then staffCharConns[plr]:Disconnect() end
		staffCharConns[plr] = plr.CharacterAdded:Connect(function()
			task.wait(1.2)
			if Flags["Staff Detector"] and plr.Parent and not StaffFound[plr] then
				checkPlayer(plr)
			end
		end)
	end

	local function scanAll()
		StaffFound = {}
		updateStaffLabel()
		for i, plr in ipairs(Players:GetPlayers()) do
			watchChar(plr)
			task.delay((i - 1) * 0.2, function()
				if Flags["Staff Detector"] and plr.Parent then
					checkPlayer(plr)
				end
			end)
		end
		task.delay(3 + #Players:GetPlayers() * 0.2, function()
			if Flags["Staff Detector"] and next(StaffFound) == nil then
				notify("No staff in this server", T.Green)
				updateStaffLabel()
			end
		end)
	end

	Features["Staff Detector"] = function(on)
		if on then
			scanAll()
		else
			StaffFound = {}
			updateStaffLabel()
		end
	end
	Features["Scan Now"] = function()
		if not Flags["Staff Detector"] then
			notify("Turn on Staff Detector first", Color3.fromRGB(255, 190, 80))
			return
		end
		scanAll()
	end

	local staffAddConn = Players.PlayerAdded:Connect(function(plr)
		watchChar(plr)
		if Flags["Staff Detector"] then task.spawn(checkPlayer, plr) end
	end)
	local staffLeaveConn = Players.PlayerRemoving:Connect(function(plr)
		StaffFound[plr] = nil
		if staffCharConns[plr] then
			staffCharConns[plr]:Disconnect()
			staffCharConns[plr] = nil
		end
		updateStaffLabel()
	end)

	-- ranks are often handed out after joining, so look again every few seconds
	task.spawn(function()
		while mg.Parent do
			task.wait(5)
			if Flags["Staff Detector"] then
				for _, plr in ipairs(Players:GetPlayers()) do
					task.spawn(checkPlayer, plr)
				end
			end
		end
	end)

	--// Restore everything we touched
	restoreAll = function()
		for _, cn in ipairs({
			moveConn, noclipConn, fovConn, jumpConn, tpConn, staffAddConn, staffLeaveConn,
			projConn, desyncHB, desyncRS, silentSnapConn, snapRS,
			instantClickConn, trigConn, hitFireConn, hitBeat, hitAddConn, hitRemoveConn,
		}) do
			pcall(function() cn:Disconnect() end)
		end
		for _, cn in pairs(staffCharConns) do
			pcall(function() cn:Disconnect() end)
		end
		for _, cn in pairs(hitHum) do
			pcall(function() cn:Disconnect() end)
		end
		for _, cn in pairs(hitCharConns) do
			pcall(function() cn:Disconnect() end)
		end
		pcall(function() RunService:UnbindFromRenderStep("XyroSilentRestore") end)
		if silentRestoreCF then
			local cam = workspace.CurrentCamera
			if cam then cam.CFrame = silentRestoreCF end
			silentRestoreCF = nil
		end
		for conn in pairs(pinConns) do pcall(function() conn:Disconnect() end) end
		if snapMain then killDraw(snapMain) end
		if snapOut then killDraw(snapOut) end
		if snapTxt then killDraw(snapTxt) end
		if hitGui then hitGui:Destroy() end
		stopFly()
		savedCF = nil
		hideMarker()
		if serverMarker then
			serverMarker:Destroy()
			serverMarker = nil
		end
		for _, name in ipairs({ "Speed Hack", "Super Jump", "Low Gravity", "Noclip", "Custom FOV", "Unlock Zoom", "Full Bright", "No Fog", "Anti AFK" }) do
			pcall(Features[name], false)
		end
	end

	--// Cleanup when the UI is destroyed
	mg.Destroying:Connect(function()
		espConn:Disconnect()
		leaveConn:Disconnect()
		for _, cn in ipairs(ExtraConns) do cn:Disconnect() end
		pcall(restoreAll)
		pcall(function() RunService:UnbindFromRenderStep("XyroAimbot") end)
		for plr in pairs(ESPObjs) do removeESP(plr) end
		for plr in pairs(Highlights) do removeESP(plr) end
		if fovCircle then killDraw(fovCircle) end
		if silentFov then killDraw(silentFov) end
	end)

	if not hasDrawing then
		notify("Drawing API not supported: boxes, skeleton, snapline and FOV circles disabled", Color3.fromRGB(255, 190, 80))
	end

	--// ---------------- WINDOW CONTROLS ----------------
	closeB.MouseButton1Click:Connect(function() mg:Destroy() end)

	local minimized = false
	minB.MouseButton1Click:Connect(function()
		minimized = not minimized
		if popup then
			popup:Destroy()
			popup = nil
		end
		area.Visible = not minimized
		side.Visible = not minimized
		TweenService:Create(win, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
			Size = minimized and UDim2.fromOffset(780, 56) or FULL,
		}):Play()
	end)

	hideB.MouseButton1Click:Connect(function()
		win.Visible = false -- press RightShift to reopen
	end)

	tryAutoload()

	-- Open animation
	win.Size = UDim2.fromOffset(780, 0)
	TweenService:Create(win, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = FULL }):Play()
end
