	local function selectPage(name)
		if popup then
			popup:Destroy()
			popup = nil
		end
		for n, pg in pairs(pages) do
			pg.Frame.Visible = (n == name)
			local tb = tabButtons[n]
			local active = (n == name)
			TweenService:Create(tb.btn, TweenInfo.new(0.18), {
				BackgroundColor3 = active and Color3.fromRGB(32, 34, 72) or T.Card,
				TextColor3 = active and T.Accent or T.Sub,
			}):Play()
			tb.stroke.Transparency = active and 0.3 or 1
		end
		pageTitle.Text = name
	end

