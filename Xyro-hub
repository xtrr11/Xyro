			Box = draw("Square", { Thickness = 1, Filled = false, Visible = false }),
			HealthBG = draw("Square", { Thickness = 1, Filled = true, Visible = false, Color = BLACK }),
			HealthFill = draw("Square", { Thickness = 1, Filled = true, Visible = false }),
			Name = draw("Text", { Size = 13, Center = true, Outline = true, Visible = false }),
			Dist = draw("Text", { Size = 12, Center = true, Outline = true, Visible = false }),
			DotOut = draw("Circle", { NumSides = 16, Thickness = 1, Filled = true, Visible = false, Color = BLACK }),
			Dot = draw("Circle", { NumSides = 16, Thickness = 1, Filled = true, Visible = false }),
			TracerOut = draw("Line", { Thickness = 3, Visible = false, Color = BLACK }),
			Tracer = draw("Line", { Thickness = 1, Visible = false }),
			CornerOutlines = {}, Corners = {}, All = {}, SkAll = {},
		}
		for i = 1, 8 do
			o.CornerOutlines[i] = draw("Line", { Thickness = 3, Visible = false, Color = BLACK })
		end
		for i = 1, 8 do
			o.Corners[i] = draw("Line", { Thickness = 1, Visible = false })
		end
		for _, k in ipairs({ "BoxFill", "BoxOuter", "BoxInner", "Box", "HealthBG", "HealthFill", "Name", "Dist", "DotOut", "Dot", "TracerOut", "Tracer" }) do
			table.insert(o.All, o[k])
		end
		for _, d in ipairs(o.CornerOutlines) do table.insert(o.All, d) end
		for _, d in ipairs(o.Corners) do table.insert(o.All, d) end
		ESPObjs[plr] = o
		return o
	end

	-- skeleton drawings are only created the first time Skeleton is switched on
	local function buildSkeleton(o)
		if o.Sk then return o.Sk end
		local sk = { Out = {}, Main = {}, JointOut = {}, Joint = {}, RibOut = {}, Rib = {} }
		for i = 1, 14 do
			sk.Out[i] = draw("Line", { Thickness = 4, Visible = false, Color = BLACK })
			sk.Main[i] = draw("Line", { Thickness = 2, Visible = false })
		end
		for i = 1, 3 do
			sk.RibOut[i] = draw("Line", { Thickness = 4, Visible = false, Color = BLACK })
			sk.Rib[i] = draw("Line", { Thickness = 2, Visible = false })
		end
		sk.HeadOut = draw("Circle", { NumSides = 24, Thickness = 4, Filled = false, Visible = false, Color = BLACK })
		sk.Head = draw("Circle", { NumSides = 24, Thickness = 2, Filled = false, Visible = false })
		for i = 1, 14 do
			sk.JointOut[i] = draw("Circle", { NumSides = 12, Thickness = 1, Filled = true, Visible = false, Color = BLACK })
			sk.Joint[i] = draw("Circle", { NumSides = 12, Thickness = 1, Filled = true, Visible = false })
		end
		for _, group in ipairs({ sk.Out, sk.Main, sk.RibOut, sk.Rib, sk.JointOut, sk.Joint }) do
			for _, d in ipairs(group) do
				table.insert(o.SkAll, d)
				table.insert(o.All, d)
			end
		end
		table.insert(o.SkAll, sk.HeadOut) table.insert(o.All, sk.HeadOut)
		table.insert(o.SkAll, sk.Head) table.insert(o.All, sk.Head)
		o.Sk = sk
		return sk
	end

	local function hideESP(o)
		for _, d in ipairs(o.All) do d.Visible = false end
	end

	local function removeESP(plr)
		local o = ESPObjs[plr]
		if o then
			for _, d in ipairs(o.All) do killDraw(d) end
			ESPObjs[plr] = nil
		end
		if Highlights[plr] then
			Highlights[plr]:Destroy()
			Highlights[plr] = nil
		end
	end

	local function updateChams(plr, c, show)
		local hl = Highlights[plr]
		if show then
			if not hl or hl.Adornee ~= c then
				if hl then hl:Destroy() end
				hl = new("Highlight", { Adornee = c }, parentGui)
				Highlights[plr] = hl
			end
			local mode = Flags["Chams Mode"]
			hl.FillColor = Flags["Chams Fill Color"]
			hl.OutlineColor = Flags["Chams Outline Color"]
			hl.FillTransparency = (mode == "Outline") and 1 or (1 - Flags["Chams Intensity"] / 100)
			hl.OutlineTransparency = (mode == "Fill") and 1 or 0
			hl.DepthMode = Flags["Chams Through Walls"] and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
			hl.Enabled = true
		elseif hl then
			hl.Enabled = false
		end
	end

	local function projectPoint(v)
		local p = Camera:WorldToViewportPoint(v)
		if p.Z > 0 then return Vector2.new(p.X, p.Y) end
		return nil
	end

	local function updateSkeleton(o, c, hum, head, h)
		local sk = buildSkeleton(o)
		local bonesStyle = Flags["Skeleton Style"] ~= "Lines"
		local outl = bonesStyle and Flags["Skeleton Outline"] and true or false
		local col = Flags["Skeleton Color"]
		local isR15 = hum.RigType == Enum.HumanoidRigType.R15
		local bones = isR15 and R15 or R6
		local thick = bonesStyle and math.clamp(math.floor(h * 0.012 + 0.5), 2, 4) or 1
		local jr = math.clamp(h * 0.015, 2, 5)

		for i = 1, 14 do
			local pair = bones[i]
			local ln, lo, jd, jo = sk.Main[i], sk.Out[i], sk.Joint[i], sk.JointOut[i]
			local drawn = false
			if pair then
				local a, b = c:FindFirstChild(pair[1]), c:FindFirstChild(pair[2])
				if a and b then
					local apos = a.Position
					if i == 1 and bonesStyle then
						apos = a.Position - Vector3.new(0, a.Size.Y * 0.5, 0) -- neck starts under the skull
					end
					local pa, pb = projectPoint(apos), projectPoint(b.Position)
					if pa and pb then
						drawn = true
						lo.Visible = outl
						if outl then
							lo.From = pa
							lo.To = pb
							lo.Thickness = thick + 2
						end
						ln.From = pa
						ln.To = pb
						ln.Thickness = thick
						ln.Color = col
						ln.Visible = true
						jo.Visible = outl
						jd.Visible = bonesStyle
						if bonesStyle then
							jd.Position = pb
							jd.Radius = jr
							jd.Color = col
							if outl then
								jo.Position = pb
								jo.Radius = jr + 1.5
							end
						end
					end
				end
			end
			if not drawn then
				ln.Visible, lo.Visible, jd.Visible, jo.Visible = false, false, false, false
			end
		end

		-- rib cage (R15)
		local ribsOn = false
		if bonesStyle and isR15 then
			local ut, lt = c:FindFirstChild("UpperTorso"), c:FindFirstChild("LowerTorso")
			local la, ra = c:FindFirstChild("LeftUpperArm"), c:FindFirstChild("RightUpperArm")
			if ut and lt and la and ra then
				ribsOn = true
				local across = ra.Position - la.Position
				for i = 1, 3 do
					local mid = ut.Position:Lerp(lt.Position, 0.16 + (i - 1) * 0.22)
					local k = 0.42 - (i - 1) * 0.07
					local pa, pb = projectPoint(mid - across * k), projectPoint(mid + across * k)
					local show = pa ~= nil and pb ~= nil
					sk.Rib[i].Visible = show
					sk.RibOut[i].Visible = show and outl
					if show then
						sk.Rib[i].From, sk.Rib[i].To = pa, pb
						sk.Rib[i].Thickness = math.max(thick - 1, 1)
						sk.Rib[i].Color = col
						if outl then
							sk.RibOut[i].From, sk.RibOut[i].To = pa, pb
							sk.RibOut[i].Thickness = math.max(thick - 1, 1) + 2
						end
					end
				end
			end
		end
		if not ribsOn then
			for i = 1, 3 do
				sk.Rib[i].Visible = false
				sk.RibOut[i].Visible = false
			end
		end

		-- skull
		local hp = bonesStyle and projectPoint(head.Position)
		if hp then
			local topP = projectPoint(head.Position + Vector3.new(0, head.Size.Y * 0.5, 0))
			local r = topP and math.max(3, math.abs(topP.Y - hp.Y)) or 5
			sk.Head.Visible = true
			sk.Head.Position = hp
			sk.Head.Radius = r
			sk.Head.Thickness = thick
			sk.Head.Color = col
			sk.HeadOut.Visible = outl
			if outl then
				sk.HeadOut.Position = hp
				sk.HeadOut.Radius = r
				sk.HeadOut.Thickness = thick + 2
			end
		else
			sk.Head.Visible = false
			sk.HeadOut.Visible = false
		end
	end

	local function updateESP(plr, vp)
		local c, hum, root, head = charParts(plr)
		local dist = root and (root.Position - Camera.CFrame.Position).Magnitude or math.huge
		local ok = c ~= nil and not teamBlocked(plr, "ESP Team Check") and dist <= Flags["ESP Max Distance"]

		updateChams(plr, c, ok and Flags["Chams"])

		local o = ESPObjs[plr]
		if not (hasDrawing and ok and Flags["Player ESP"]) then
			if o then hideESP(o) end
			return
		end
		o = o or newESP(plr)

		local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
		local bot = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
		if top.Z <= 0 or bot.Z <= 0 then
			hideESP(o)
			return
		end

		local h = math.abs(bot.Y - top.Y)
		local w = h * 0.55
		local x, y = math.floor(top.X - w / 2), math.floor(top.Y)
		h, w = math.floor(h), math.floor(w)
		local boxCol = Flags["Box Color"]
		local outCol = Flags["Outline Color"] or BLACK
		local outline = Flags["Box Outline"] and true or false
		local boxOn = Flags["Box ESP"] and true or false

		-- full box: coloured line sandwiched between two dark lines, plus a soft fill
		o.Box.Visible = boxOn
		o.BoxOuter.Visible = boxOn and outline
		o.BoxInner.Visible = boxOn and outline
		o.BoxFill.Visible = boxOn and (Flags["Box Fill"] and true or false)
		if boxOn then
			o.Box.Position = Vector2.new(x, y)
			o.Box.Size = Vector2.new(w, h)
			o.Box.Color = boxCol
			if outline then
				o.BoxOuter.Position = Vector2.new(x - 1, y - 1)
				o.BoxOuter.Size = Vector2.new(w + 2, h + 2)
				o.BoxOuter.Color = outCol
				o.BoxInner.Position = Vector2.new(x + 1, y + 1)
				o.BoxInner.Size = Vector2.new(math.max(w - 2, 1), math.max(h - 2, 1))
				o.BoxInner.Color = outCol
			end
			if o.BoxFill.Visible then
				o.BoxFill.Position = Vector2.new(x + 1, y + 1)
				o.BoxFill.Size = Vector2.new(math.max(w - 2, 1), math.max(h - 2, 1))
				o.BoxFill.Color = boxCol
				o.BoxFill.Transparency = (Flags["Box Fill Opacity"] or 15) / 100
			end
		end

		-- corner box (+ outline underneath)
		if Flags["Corner Box"] then
			local l = math.max(math.min(w, h) * 0.28, 4)
			local segs = {
				{ x, y, x + l, y }, { x, y, x, y + l },
				{ x + w, y, x + w - l, y }, { x + w, y, x + w, y + l },
				{ x, y + h, x + l, y + h }, { x, y + h, x, y + h - l },
				{ x + w, y + h, x + w - l, y + h }, { x + w, y + h, x + w, y + h - l },
			}
			for i, sg in ipairs(segs) do
				local from, to = Vector2.new(sg[1], sg[2]), Vector2.new(sg[3], sg[4])
				local lo = o.CornerOutlines[i]
				lo.Visible = outline
				if outline then
					lo.From, lo.To, lo.Color = from, to, outCol
				end
				local ln = o.Corners[i]
				ln.From, ln.To, ln.Color = from, to, boxCol
				ln.Visible = true
			end
		else
			for i = 1, 8 do
				o.Corners[i].Visible = false
				o.CornerOutlines[i].Visible = false
			end
		end

		-- skeleton
		if Flags["Skeleton"] then
			updateSkeleton(o, c, hum, head, h)
		elseif o.Sk then
			for _, d in ipairs(o.SkAll) do d.Visible = false end
		end

		-- health bar: dark backing + fill that fades red -> your colour
		local hb = Flags["Health Bar"] and true or false
		local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		local fh = math.floor(h * frac)
		o.HealthBG.Visible = hb
		o.HealthFill.Visible = hb and fh >= 1
		if hb then
			local bx = x - 6
			o.HealthBG.Position = Vector2.new(bx, y - 1)
			o.HealthBG.Size = Vector2.new(4, h + 2)
			o.HealthFill.Position = Vector2.new(bx + 1, y + (h - fh))
			o.HealthFill.Size = Vector2.new(2, fh)
			o.HealthFill.Color = Color3.fromRGB(255, 60, 60):Lerp(Flags["Health Bar Color"], frac)
		end

		-- name / distance
		o.Name.Visible = Flags["Name ESP"] and true or false
		if o.Name.Visible then
			o.Name.Text = plr.DisplayName
			o.Name.Position = Vector2.new(x + w / 2, y - 17)
			o.Name.Color = Flags["Name Color"]
		end
		o.Dist.Visible = Flags["Distance ESP"] and true or false
		if o.Dist.Visible then
			o.Dist.Text = string.format("[%dm]", math.floor(dist))
			o.Dist.Position = Vector2.new(x + w / 2, y + h + 3)
			o.Dist.Color = Flags["Name Color"]
		end

		-- head dot (dark ring behind it)
		local dotOn = Flags["Head Dot"] and true or false
		o.Dot.Visible = dotOn
		o.DotOut.Visible = dotOn and outline
		if dotOn then
			local hp = Camera:WorldToViewportPoint(head.Position)
			local r = math.max(2, w * 0.1)
			o.Dot.Position = Vector2.new(hp.X, hp.Y)
			o.Dot.Radius = r
			o.Dot.Color = boxCol
			o.DotOut.Position = Vector2.new(hp.X, hp.Y)
			o.DotOut.Radius = r + 1.5
		end

		-- tracer (dark line underneath)
		local trOn = Flags["Tracers"] and true or false
		o.Tracer.Visible = trOn
		o.TracerOut.Visible = trOn and outline
		if trOn then
			local origin = Flags["Tracer Origin"]
			local from
			if origin == "Center" then from = Vector2.new(vp.X / 2, vp.Y / 2)
			elseif origin == "Top" then from = Vector2.new(vp.X / 2, 0)
			elseif origin == "Mouse" then from = UserInputService:GetMouseLocation()
			else from = Vector2.new(vp.X / 2, vp.Y) end
			local to = Vector2.new(x + w / 2, y + h)
			o.Tracer.From, o.Tracer.To, o.Tracer.Color = from, to, Flags["Tracer Color"]
			if outline then
				o.TracerOut.From, o.TracerOut.To, o.TracerOut.Color = from, to, outCol
			end
		end
	end

	local espConn = RunService.RenderStepped:Connect(function()
		Camera = workspace.CurrentCamera
		local vp = Camera.ViewportSize
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local ok, err = pcall(updateESP, plr, vp)
				if not ok then warn("[Xyro ESP] " .. tostring(err)) end
			end
		end
	end)
	local leaveConn = Players.PlayerRemoving:Connect(removeESP)

	--// ------------------------ AIMBOT ------------------------
	local fovCircle = hasDrawing and draw("Circle", { NumSides = 64, Visible = false }) or nil
	local silentFov = hasDrawing and draw("Circle", { NumSides = 64, Visible = false }) or nil
	local lockPlr, lockPart, lockMiss, lockOffset = nil, nil, false, Vector3.zero
	local silentPart, silentLock, silentMiss = nil, nil, false

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function bindHeld(b)
		if not b then return false end
		if b.Kind == "Key" then
			return UserInputService:IsKeyDown(b.Enum)
		end
		if b.Kind == "Mouse" then
			return UserInputService:IsMouseButtonPressed(b.Enum)
		end
		return false
	end

	local function keyHeld()
		return bindHeld(Flags["Aim Key"])
	end

	local function silentActive()
		if not Flags["Silent Aim"] then return false end
		if Flags["Silent Activation"] == "Hold" then
			return bindHeld(Flags["Silent Key"])
		end
		return true
	end

	local function getPart(c, mode, mousePos)
		if mode == "Head" then return c:FindFirstChild("Head") end
		if mode == "Torso" then return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") end
		if mode == "HumanoidRootPart" then return c:FindFirstChild("HumanoidRootPart") end
		if mode == "Random" then
			local pool = {}
			for _, n in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
				local p = c:FindFirstChild(n)
				if p then table.insert(pool, p) end
			end
			return pool[math.random(1, math.max(#pool, 1))]
		end
		-- Closest Part (to the cursor)
		local best, bestD
		for _, part in ipairs(c:GetChildren()) do
			if part:IsA("BasePart") then
				local sp = Camera:WorldToViewportPoint(part.Position)
				if sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
					if not bestD or d < bestD then best, bestD = part, d end
				end
			end
		end
		return best
	end

	local function visibleTo(part, c)
		rayParams.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
		local origin = Camera.CFrame.Position
		local res = workspace:Raycast(origin, part.Position - origin, rayParams)
		return res == nil or res.Instance:IsDescendantOf(c)
	end

	local function findTarget(mousePos, opts)
		opts = opts or {}
		local teamFlag = opts.teamFlag or "Aimbot Team Check"
		local maxDist = opts.maxDist or Flags["Aimbot Max Distance"]
		local partMode = opts.partMode or Flags["Aimbot Target"]
		local fov = opts.fov or Flags["Aimbot FOV"]
		local wall = opts.wall
		if wall == nil then wall = Flags["Wall Check"] end
		local priority = opts.priority or Flags["Target Priority"]
		local bestPlr, bestPart, bestScore
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and not teamBlocked(plr, teamFlag) then
				local c = plr.Character
				local hum = c and c:FindFirstChildOfClass("Humanoid")
				local root = c and c:FindFirstChild("HumanoidRootPart")
				if hum and root and (hum.Health > 0 or not Flags["Alive Check"]) then
					local dist = (root.Position - Camera.CFrame.Position).Magnitude
					if dist <= maxDist then
						local part = getPart(c, partMode, mousePos)
						if part then
							local sp = Camera:WorldToViewportPoint(part.Position)
							local d2 = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
							if sp.Z > 0 and d2 <= fov and (not wall or visibleTo(part, c)) then
								local pr = priority
								local score = (pr == "Closest Distance" and dist) or (pr == "Lowest Health" and hum.Health) or d2
								if not bestScore or score < bestScore then
									bestPlr, bestPart, bestScore = plr, part, score
								end
							end
						end
					end
				end
			end
		end
		return bestPlr, bestPart
	end

	RunService:BindToRenderStep("XyroAimbot", Enum.RenderPriority.Camera.Value + 1, function(dt)
		Camera = workspace.CurrentCamera
		local mousePos = UserInputService:GetMouseLocation()

		if silentFov then
			local show = Flags["Show Silent FOV"] and Flags["Silent Aim"]
			silentFov.Visible = show and true or false
			if show then
				silentFov.Position = mousePos
				silentFov.Radius = Flags["Silent FOV"] or 220
				silentFov.Thickness = 1
				silentFov.Filled = false
				silentFov.Transparency = 1
				silentFov.Color = Flags["Silent FOV Color"] or Color3.fromRGB(46, 214, 140)
			end
		end

		if silentActive() then
			local _, part = findTarget(mousePos, {
				teamFlag = "Silent Team Check",
				maxDist = Flags["Silent Max Distance"],
				partMode = Flags["Silent Target"],
				fov = Flags["Silent FOV"],
				wall = Flags["Silent Wall Check"],
				priority = Flags["Silent Priority"],
			})
			if part ~= silentLock then
				silentLock = part
				silentMiss = math.random(1, 100) > (Flags["Silent Hit Chance"] or 100)
			end
			silentPart = (part and not silentMiss) and part or nil
		else
			silentPart, silentLock = nil, nil
		end

		if fovCircle then
			local show = Flags["Show FOV Circle"]
			fovCircle.Visible = show
			if show then
				fovCircle.Position = mousePos
				fovCircle.Radius = Flags["Aimbot FOV"]
				fovCircle.Thickness = Flags["FOV Thickness"]
				fovCircle.Filled = Flags["FOV Filled"]
				fovCircle.Transparency = Flags["FOV Filled"] and 0.15 or 1
				fovCircle.Color = Flags["FOV Color"]
			end
		end

		if not Flags["Enable Aimbot"] or not keyHeld() then
			lockPlr, lockPart = nil, nil
			return
		end

		local keep = false
		if Flags["Sticky Aim"] and lockPlr then
			local c = lockPlr.Character
			local hum = c and c:FindFirstChildOfClass("Humanoid")
			keep = hum ~= nil and hum.Health > 0 and lockPart ~= nil and lockPart.Parent ~= nil
		end
		if not keep then
			local p, part = findTarget(mousePos)
			if p ~= lockPlr then
				lockMiss = math.random(1, 100) > Flags["Hit Chance"]
				lockOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 8
			end
			lockPlr, lockPart = p, part
		end
		if not lockPlr or not lockPart then return end

		local aimPos = lockPart.Position
		if Flags["Prediction"] then
			aimPos += lockPart.AssemblyLinearVelocity * (Flags["Prediction Strength"] / 100) * 0.2
		end
		if lockMiss then aimPos += lockOffset end

		local base = 1 / math.max(Flags["Aimbot Smoothing"], 1)
		local style = Flags["Smoothing Style"]
		local alpha
		if style == "Exponential" then
			alpha = 1 - (1 - base) ^ (dt * 60)
		elseif style == "Sine" then
			alpha = math.sin(base * math.pi / 2) * dt * 60
		else
			alpha = base * dt * 60
		end
		alpha = math.clamp(alpha, 0, 1)

		local cf = Camera.CFrame
		Camera.CFrame = cf:Lerp(CFrame.new(cf.Position, aimPos), alpha)
	end)

	--// ------------------------- MISC -------------------------
	local Lighting = game:GetService("Lighting")
	local TeleportService = game:GetService("TeleportService")
	local HttpService = game:GetService("HttpService")

	local function myChar()
		local c = LocalPlayer.Character
