		-- AUTO CHEST FARM (with blacklist + dwell timer so claimed chests get skipped)
		Features["Auto Chest Farm"] = function(on)
			if not on then
				local _, hum = myChar()
				if hum and not Flags["Fly"] then hum.PlatformStand = false end
				if not Flags["Auto Level"] and not Flags["Auto Mastery"] then
					farmGoal = nil
					farmLook = nil
					farmClip = false
				end
				return
			end
			task.spawn(function()
				-- ignored[part] = os.clock() when it was blacklisted.
				-- Cleared automatically when the part is Destroyed, or after 5 minutes as a safety net.
				local ignored = {}
				local ignoreWatch = {}
				local lastTarget = nil
				local lastTargetAt = 0
				local arriveAt = 0
				local cachedScan = {}
				local lastScanAt = 0

				local function ignorePart(part)
					if not part or ignored[part] then return end
					ignored[part] = os.clock()
					if not ignoreWatch[part] then
						ignoreWatch[part] = part.Destroying:Connect(function()
							ignored[part] = nil
							if ignoreWatch[part] then
								ignoreWatch[part]:Disconnect()
								ignoreWatch[part] = nil
							end
						end)
					end
				end

				local function collectCandidates()
					local folder = workspace:FindFirstChild("Chests") or workspace:FindFirstChild("Chest")
					local out = {}
					if folder then
						for _, child in ipairs(folder:GetChildren()) do
							if child:IsA("BasePart") then
								table.insert(out, child)
							elseif child:IsA("Model") then
								local prim = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)
								if prim then table.insert(out, prim) end
							end
						end
					end
					if #out == 0 then
						-- Fallback: workspace-wide scan (throttled to once per second)
						if os.clock() - lastScanAt > 1 then
							lastScanAt = os.clock()
							cachedScan = {}
							for _, d in ipairs(workspace:GetDescendants()) do
								if d:IsA("BasePart") then
									local n = d.Name:lower()
									local inChest = n:find("chest", 1, true) ~= nil
									if not inChest and d.Parent then
										inChest = d.Parent.Name:lower():find("chest", 1, true) ~= nil
									end
									if inChest then table.insert(cachedScan, d) end
								end
							end
						end
						return cachedScan
					end
					return out
				end

				-- A chest is "alive" (worth targeting) if it still exists, isn't
				-- invisible, and hasn't had its interaction disabled by the game.
				-- Blox Fruits leaves claimed chests in workspace but flips them
				-- invisible / disables their prompt, so these checks stop us from
				-- re-locking onto a chest that's already been opened.
				local function chestAlive(part)
					if not part or not part.Parent then return false end
					if part.Transparency >= 1 then return false end
					local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
					if prompt and prompt.Enabled == false then return false end
					return true
				end

				while Flags["Auto Chest Farm"] do
					local _, _, root = myChar()
					if root then
						local range = Flags["Chest Range"] or 2500

						-- Sweep the ignore table. Entries stay put while the chest
						-- reference exists (Blox Fruits keeps claimed chests around
						-- for a while after they disappear visually). We only drop
						-- them if the part is gone or it's been 5 minutes.
						for ref, t in pairs(ignored) do
							if not ref.Parent or os.clock() - t > 300 then
								ignored[ref] = nil
								if ignoreWatch[ref] then
									ignoreWatch[ref]:Disconnect()
									ignoreWatch[ref] = nil
								end
							end
						end

						local candidates = collectCandidates()
						local best, bestD
						for _, c in ipairs(candidates) do
							if not ignored[c] and chestAlive(c) then
								local d = (c.Position - root.Position).Magnitude
								if d < range and (not bestD or d < bestD) then
									best, bestD = c, d
								end
							end
						end

						if best then
							farmGoal = best.Position + Vector3.new(0, 1.5, 0)
							farmLook = best.Position
							farmClip = true

							if best ~= lastTarget then
								-- Fresh target: burst-teleport and reset the dwell timer
								lastTarget = best
								lastTargetAt = os.clock()
								arriveAt = 0
								fastTeleportUntil = os.clock() + 1.5
								root.CFrame = CFrame.new(best.Position + Vector3.new(0, 1.5, 0))
							else
								local dist = (best.Position - root.Position).Magnitude

								-- Chest visually disappeared / got disabled under us: done, blacklist now.
								if not chestAlive(best) then
									ignorePart(best)
									lastTarget = nil
									arriveAt = 0
									farmGoal = nil
									farmLook = nil
								elseif dist < 8 then
									-- We're on top of it. Short 0.35s dwell so the touch fires
									-- but we don't sit here spamming pickup events.
									if arriveAt == 0 then
										arriveAt = os.clock()
									elseif os.clock() - arriveAt > 0.35 then
										ignorePart(best)
										lastTarget = nil
										arriveAt = 0
										farmGoal = nil
										farmLook = nil
									end
								else
									if dist > 25 then arriveAt = 0 end
								end

								-- Hard safety net if we somehow get stuck on one ref
								if os.clock() - lastTargetAt > 6 then
									ignorePart(best)
									lastTarget = nil
									lastTargetAt = os.clock()
									arriveAt = 0
								end
							end
						else
							lastTarget = nil
							arriveAt = 0
							if not Flags["Auto Level"] and not Flags["Auto Mastery"] then
								farmGoal = nil
								farmLook = nil
								farmClip = false
								local _, hum = myChar()
								if hum and not Flags["Fly"] then hum.PlatformStand = false end
							end
						end
					end
					task.wait(0.08)
				end

				-- Clean up Destroying connections on exit
				for _, conn in pairs(ignoreWatch) do
					pcall(function() conn:Disconnect() end)
				end
				ignoreWatch = {}

				if not Flags["Auto Level"] and not Flags["Auto Mastery"] then
					farmGoal = nil
					farmLook = nil
					farmClip = false
					local _, hum = myChar()
					if hum and not Flags["Fly"] then hum.PlatformStand = false end
				end
			end)
		end

