		end

		local function toolKind(tool)
			local tip = ""
			pcall(function() tip = tostring(tool.ToolTip or "") end)
			tip = tip:lower()
			if tip:find("melee", 1, true) then return "Melee" end
			if tip:find("sword", 1, true) then return "Sword" end
			if tip:find("gun", 1, true) then return "Gun" end
			if tip:find("fruit", 1, true) or tip:find("blox", 1, true) then return "Fruit" end
			return "Other"
		end

		local function equipWeapon()
			local char, hum = myChar()
			if not (char and hum) then return end
			local want = Flags["BF Weapon"] or "Auto"
			local current = char:FindFirstChildOfClass("Tool")
			if current then
				local kind = toolKind(current)
				if want == "Auto" then
					if kind ~= "Fruit" and kind ~= "Other" then return end
				elseif kind == want then
					return
				end
			end
			local bp = LocalPlayer:FindFirstChild("Backpack")
			if not bp then return end
			local fallback
			for _, tool in ipairs(bp:GetChildren()) do
				if tool:IsA("Tool") then
					local kind = toolKind(tool)
					if want == "Auto" then
						if kind == "Melee" or kind == "Sword" or kind == "Gun" then
							hum:EquipTool(tool)
							return
						end
						fallback = fallback or tool
					elseif kind == want then
						hum:EquipTool(tool)
						return
					end
				end
			end
			if fallback then hum:EquipTool(fallback) end
		end

