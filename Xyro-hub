	local moveConn = RunService.Heartbeat:Connect(function(dt)
		local c, hum, root = myChar()
		if not (c and hum and root) then return end

		if Flags["Speed Hack"] then
			if Flags["Speed Method"] == "CFrame" then
				if hum.MoveDirection.Magnitude > 0 then
					root.CFrame += hum.MoveDirection * (Flags["Walk Speed"] - 16) * dt
				end
			else
				hum.WalkSpeed = Flags["Walk Speed"]
			end
		end

		if Flags["Super Jump"] then
			hum.UseJumpPower = true
			hum.JumpPower = Flags["Jump Power"]
		end

		if Flags["Fly"] then
			if not flyBV or flyBV.Parent ~= root then
				stopFly()
				flyBV = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
				flyBG = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4 }, root)
			end
			hum.PlatformStand = true
			local cam = workspace.CurrentCamera.CFrame
			local d = Vector3.zero
			if not UserInputService:GetFocusedTextBox() then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then d += cam.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then d -= cam.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then d += cam.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then d -= cam.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.yAxis end
			end
			flyBV.Velocity = d.Magnitude > 0 and d.Unit * Flags["Fly Speed"] or Vector3.zero
			flyBG.CFrame = cam
		end
