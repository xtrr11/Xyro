local function new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do obj[k] = v end
	if parent then obj.Parent = parent end
	return obj
end

local function corner(obj, r)
	return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, obj)
end

local function stroke(obj, color, thickness, transparency)
	return new("UIStroke", {
		Color = color, Thickness = thickness or 1, Transparency = transparency or 0.6,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, obj)
end

local function label(parent, text, size, color, pos, sz, font, xalign)
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextSize = size,
		TextColor3 = color, Position = pos, Size = sz,
		Font = font or Enum.Font.Gotham,
		TextXAlignment = xalign or Enum.TextXAlignment.Left,
	}, parent)
end

local function button(parent, text, pos, size, bg, textColor)
	local b = new("TextButton", {
		Text = text, Font = Enum.Font.GothamMedium, TextSize = 13,
		TextColor3 = textColor or Color3.new(1, 1, 1),
		BackgroundColor3 = bg, Position = pos, Size = size,
		AutoButtonColor = false,
	}, parent)
	corner(b, 8)
	local base = bg
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12)}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = base}):Play()
	end)
	return b
end

local function toast(statusLabel, text, color)
	statusLabel.Text = text
	statusLabel.TextColor3 = color or Color3.fromRGB(200, 210, 225)
end

local function getExecutor()
	local ok, name = pcall(function() return identifyexecutor and identifyexecutor() or "Unknown" end)
