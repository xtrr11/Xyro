	local function ColorPicker(S, text, default)
		local r = row(S, 44, text)
		label(r, text, 12, T.Text, UDim2.new(), UDim2.new(1, -60, 1, 0))

		local sw = new("TextButton", {
			Size = UDim2.fromOffset(40, 22), Position = UDim2.new(1, -40, 0.5, -11),
			BackgroundColor3 = default, Text = "", AutoButtonColor = false,
		}, r)
		corner(sw, 6)
		stroke(sw, Color3.new(1, 1, 1), 1, 0.7)

		local h, s, v = default:ToHSV()
		Flags[text] = default

		local function setColor(c, silent)
			if typeof(c) ~= "Color3" then return end
			h, s, v = c:ToHSV()
			sw.BackgroundColor3 = c
			Flags[text] = c
			if not silent then runHook(text, c) end
		end

		sw.MouseButton1Click:Connect(function()
			if popup then
				local mine = popup:GetAttribute("owner") == text
				popup:Destroy()
				popup = nil
				if mine then return end
			end

			local pw, ph = 188, 172
			local pop = new("Frame", {
