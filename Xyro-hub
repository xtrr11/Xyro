	local function canHoldClick()
		if type(mouse1press) == "function" and type(mouse1release) == "function" then return true end
		return type(mouse1click) ~= "function"
	end

	local function pressTrigger()
		lastShot = os.clock()
		local held = sendClick(true)
		triggerDown = held and true or false
		if not held then pokeTool() end
	end

	local function tapTrigger()
		lastShot = os.clock()
		if type(mouse1click) == "function" then pcall(mouse1click) return end
		local held = sendClick(true)
		if not held then pokeTool() return end
		triggerPendingUp = true
		local token = triggerReleaseToken
		task.delay(0.03, function()
			if token ~= triggerReleaseToken then return end
			triggerPendingUp = false
			sendClick(false)
		end)
	end

	local function updateTrigger(mousePos)
		if triggerFov then
			local show = Flags["Show Trigger FOV"] and Flags["Triggerbot"]
			triggerFov.Visible = show and true or false
			if show then
				triggerFov.Position = mousePos
				triggerFov.Radius = Flags["Trigger FOV"] or 18
				triggerFov.Thickness = 1
				triggerFov.Filled = false
				triggerFov.Transparency = 1
				triggerFov.Color = Flags["Trigger FOV Color"] or Color3.fromRGB(255, 176, 72)
			end
		end

		if not triggerActive() then
			releaseTrigger()
			return
		end

		local _, part = findTarget(mousePos, {
			teamFlag = "Trigger Team Check",
			maxDist = Flags["Trigger Max Distance"] or 700,
			partMode = Flags["Trigger Head Only"] and "Head" or "Closest Part",
			fov = Flags["Trigger FOV"] or 18,
			wall = Flags["Trigger Wall Check"],
			priority = "Closest To Crosshair",
			forceAlive = true,
		})
		if not part then
			releaseTrigger()
			return
		end

		local now = os.clock()
		if (Flags["Trigger Style"] or "Tap") == "Hold" and canHoldClick() then
			if triggerDown then
				if now >= nextTriggerAt then
					nextTriggerAt = now + triggerDelay()
					lastShot = now
				end
			elseif now >= nextTriggerAt then
				nextTriggerAt = now + triggerDelay()
				pressTrigger()
			end
		else
			releaseTrigger()
			if now >= nextTriggerAt then
				nextTriggerAt = now + triggerDelay()
				tapTrigger()
			end
		end
	end

