		local h, s, v = default:ToHSV()
		Flags[text] = default

		local function setColor(c, silent)
			if typeof(c) ~= "Color3" then return end
			h, s, v = c:ToHSV()
			sw.BackgroundColor3 = c
			Flags[text] = c
			if not silent then runHook(text, c) end
		end

		sw.MouseButton1Click:Connect(function()
