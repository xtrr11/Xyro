	--// ------------------------ INSTANT HIT ------------------------
	local function aimPoint(part)
		local pos = part.Position
		if Flags["Silent Prediction"] then
			pos += part.AssemblyLinearVelocity * ((Flags["Silent Prediction Power"] or 20) / 100) * 0.2
		end
		return pos
	end

	-- when did we last shoot (real click, held button, or a triggerbot shot)
	local lastShootT = 0
	local instantClickConn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			lastShootT = os.clock()
		end
	end)

	local pinConns = {}

	-- who/what should bullets land on: silent aim target, else nearest player to the cursor, else where the cursor points
	local function bulletGoal()
		if silentPart and silentPart.Parent and silentActive() then
			return silentPart, nil
		end
		local cam = workspace.CurrentCamera
		local m = UserInputService:GetMouseLocation()
		local _, part = findTarget(m, SilentCfg)
		if part then return part, nil end
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		local dist = Flags["Instant Range"] or 1500
		rayParams.FilterDescendantsInstances = { LocalPlayer.Character, cam }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * dist, rayParams)
		return nil, hit and hit.Position or (ray.Origin + ray.Direction * dist)
	end

	local function killMovers(obj)
		for _, ch in ipairs(obj:GetChildren()) do
			if ch:IsA("BodyMover") or ch:IsA("LinearVelocity") or ch:IsA("VectorForce")
				or ch:IsA("AlignPosition") or ch:IsA("BodyForce") then
				pcall(function() ch:Destroy() end)
			end
		end
	end

	local projConn = workspace.DescendantAdded:Connect(function(obj)
		if not Flags["Instant Hit"] or not obj:IsA("BasePart") then return end
		task.defer(function()
			if not obj.Parent or not Flags["Instant Hit"] then return end
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root or obj:IsDescendantOf(char) then return end

			-- only things that appeared because we just shot
			local shooting = (os.clock() - lastShootT) < 0.6
				or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
			if not shooting then return end
			if (obj.Position - root.Position).Magnitude > (Flags["Bullet Detect Range"] or 50) then return end
			if obj.Size.Magnitude > 10 then return end
			local model = obj:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then return end
			if obj:FindFirstAncestorOfClass("Tool") then return end

			local tgtPart, fixed = bulletGoal()
			local function goal()
				if tgtPart and tgtPart.Parent then return tgtPart.Position end
				return fixed
			end
			if not goal() then return end

			killMovers(obj)
			local function place()
				local p = goal()
				if not p then return end
				obj.AssemblyLinearVelocity = Vector3.zero
				obj.AssemblyAngularVelocity = Vector3.zero
				obj.CFrame = CFrame.new(p)
			end
			pcall(place)
			if Flags["Instant Method"] == "Teleport Once" then return end

			-- keep it glued to the target for the rest of its life so it never travels
			local t0 = os.clock()
			local conn
			conn = RunService.Heartbeat:Connect(function()
				if not obj.Parent or not Flags["Instant Hit"] or os.clock() - t0 > 1.5 then
					conn:Disconnect()
					pinConns[conn] = nil
					return
				end
				pcall(place)
			end)
			pinConns[conn] = true
		end)
	end)

	--// ------------------------ TRIGGERBOT ------------------------
	local VIM
	pcall(function() VIM = game:GetService("VirtualInputManager") end)

	local function bodyGroup(inst)
		if inst:FindFirstAncestorOfClass("Accoutrement") then return "Head" end
		local n = inst.Name:lower()
		if n:find("head", 1, true) then return "Head" end
		if n:find("arm", 1, true) or n:find("hand", 1, true) then return "Arms" end
		if n:find("leg", 1, true) or n:find("foot", 1, true) then return "Legs" end
		return "Torso"
	end

	-- is the cursor on a valid enemy body part of the chosen hitbox?
	local function triggerOnTarget()
		-- silent aim already has a target locked: shoot, the snap does the aiming
		if Flags["Trigger With Silent Aim"] and silentPart and silentPart.Parent then
			return true
		end
		local cam = workspace.CurrentCamera
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		rayParams.FilterDescendantsInstances = { LocalPlayer.Character, cam }
		local res = workspace:Raycast(ray.Origin, ray.Direction * (Flags["Trigger Max Distance"] or 500), rayParams)
		if not res then return false end

		local inst = res.Instance
		local model = inst:FindFirstAncestorOfClass("Model")
		local plr = model and Players:GetPlayerFromCharacter(model)
		if not plr or plr == LocalPlayer then return false end
		if teamBlocked(plr, "Trigger Team Check") then return false end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return false end

		local want = Flags["Trigger Hitbox"] or "Head"
		local group = bodyGroup(inst)
		if want == "Any" then return true end
		if want == "Head + Torso" then return group == "Head" or group == "Torso" end
		return group == want
	end

	local function fireClick()
		local method = Flags["Trigger Fire Method"] or "Auto"
		local hold = (Flags["Trigger Hold (ms)"] or 30) / 1000
		lastShootT = os.clock()

		local function viaTool()
			local c = LocalPlayer.Character
			local tool = c and c:FindFirstChildOfClass("Tool")
			if tool then
				tool:Activate()
				return true
			end
			return false
		end
		local function viaMouse()
			if type(mouse1press) == "function" and type(mouse1release) == "function" then
				mouse1press()
				task.wait(hold)
				mouse1release()
				return true
			elseif type(mouse1click) == "function" then
				mouse1click()
				return true
			end
			return false
		end
		local function viaVIM()
			if not VIM then return false end
			return (pcall(function()
				local m = UserInputService:GetMouseLocation()
				VIM:SendMouseButtonEvent(m.X, m.Y, 0, true, game, 0)
				task.wait(hold)
				VIM:SendMouseButtonEvent(m.X, m.Y, 0, false, game, 0)
			end))
		end

		if method == "Tool Activate" then
			viaTool()
		elseif method == "Mouse Click" then
			if not viaMouse() then viaVIM() end
		elseif method == "Virtual Input" then
			viaVIM()
		else
			if not viaMouse() then
				if not viaVIM() then viaTool() end
			end
		end
	end

	local trigSince, trigLast, trigBusy = nil, 0, false
	local trigConn = RunService.Heartbeat:Connect(function()
		if not Flags["Triggerbot"] then
			trigSince = nil
			return
		end
		local key = Flags["Trigger Key"]
		if key and not bindHeld(key) then
			trigSince = nil
			return
		end
		if UserInputService:GetFocusedTextBox() then return end

		local ok, onTarget = pcall(triggerOnTarget)
		if not (ok and onTarget) then
			trigSince = nil
			return
		end

		local now = os.clock()
		trigSince = trigSince or now
		if now - trigSince < (Flags["Trigger Delay (ms)"] or 0) / 1000 then return end
		if now - trigLast < (Flags["Trigger Cooldown (ms)"] or 100) / 1000 then return end
		if trigBusy then return end
		trigLast = now
		trigBusy = true
		task.spawn(function()
			pcall(fireClick)
			trigBusy = false
		end)
	end)

	--// ------------------------ SILENT AIM (camera snap, no hooks) ------------------------
	-- Each Heartbeat (after the frame is drawn) the camera is turned so the cursor ray
	-- passes through the target. Anything that reads the camera / Mouse.Hit during the
	-- next input phase (a click, Tool.Activated) sees the snapped aim. Just before the
	-- next frame is drawn it is put back, so you never see it.
	local silentRestoreCF = nil

	local function snapCameraToTarget()
		local part = silentPart
		if not part or not part.Parent then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		local want = aimPoint(part) - ray.Origin
		if want.Magnitude < 0.5 then return end
		local from, to = ray.Direction.Unit, want.Unit
		local angle = math.acos(math.clamp(from:Dot(to), -1, 1))
		if angle < 1e-4 then return end
		local axis = from:Cross(to)
		if axis.Magnitude < 1e-6 then return end
		local cf = cam.CFrame
		silentRestoreCF = cf
		cam.CFrame = CFrame.fromAxisAngle(axis.Unit, angle) * (cf - cf.Position) + cf.Position
	end

	RunService:BindToRenderStep("XyroSilentRestore", Enum.RenderPriority.First.Value, function()
		if silentRestoreCF then
			local cam = workspace.CurrentCamera
			if cam then cam.CFrame = silentRestoreCF end
			silentRestoreCF = nil
		end
	end)

	local silentSnapConn = RunService.Heartbeat:Connect(function()
		if silentRestoreCF == nil and silentActive() and silentPart then
			pcall(snapCameraToTarget)
		end
	end)

	--// ------------------------ TARGET SNAPLINE ------------------------
	-- outline is created first so it is drawn underneath the coloured line
	local snapOut = hasDrawing and draw("Line", { Visible = false, Color = Color3.new(0, 0, 0) }) or nil
	local snapMain = hasDrawing and draw("Line", { Visible = false }) or nil
	local snapTxt = hasDrawing and draw("Text", { Size = 13, Center = true, Outline = true, Visible = false }) or nil

	local function hideSnap()
		if snapMain then snapMain.Visible = false end
		if snapOut then snapOut.Visible = false end
		if snapTxt then snapTxt.Visible = false end
	end

	local snapRS = RunService.RenderStepped:Connect(function()
		if not snapMain then return end
		local target
		if Flags["Enable Aimbot"] and lockPart and lockPart.Parent and keyHeld() then
			target = lockPart
		elseif silentPart and silentPart.Parent then
			target = silentPart
		elseif silentLock and silentLock.Parent and Flags["Silent Aim"] then
			target = silentLock -- silent target found but this shot is a "miss" roll: still show who it is
		end
		local cam = workspace.CurrentCamera
		if not (Flags["Target Snapline"] and target and cam) then
			hideSnap()
			return
		end
		local sp = cam:WorldToViewportPoint(target.Position)
		if sp.Z <= 0 then
			hideSnap()
			return
		end
		local vp = cam.ViewportSize
		local origin = Flags["Snapline Origin"]
		local from
		if origin == "Mouse" then
			from = UserInputService:GetMouseLocation()
		elseif origin == "Bottom" then
			from = Vector2.new(vp.X / 2, vp.Y)
		else
			from = Vector2.new(vp.X / 2, vp.Y / 2)
		end
		local to = Vector2.new(sp.X, sp.Y)
		local th = Flags["Snapline Thickness"] or 1

		snapOut.Visible = Flags["Snapline Outline"] and true or false
		if snapOut.Visible then
			snapOut.From = from
			snapOut.To = to
			snapOut.Thickness = th + 2
			snapOut.Color = Flags["Snapline Outline Color"] or Color3.new(0, 0, 0)
		end
		snapMain.From = from
		snapMain.To = to
		snapMain.Thickness = th
		snapMain.Color = Flags["Snapline Color"] or Color3.new(1, 1, 1)
		snapMain.Visible = true

		-- who we're locked onto
		snapTxt.Visible = Flags["Snapline Target Info"] and true or false
		if snapTxt.Visible then
			local model = target:FindFirstAncestorOfClass("Model")
			local plr = model and Players:GetPlayerFromCharacter(model)
			local d = (target.Position - cam.CFrame.Position).Magnitude
			snapTxt.Text = string.format("%s [%dm]", plr and plr.DisplayName or target.Parent.Name, math.floor(d))
			snapTxt.Position = Vector2.new(to.X, to.Y - 18)
			snapTxt.Color = Flags["Snapline Color"] or Color3.new(1, 1, 1)
		end
	end)

