			local py = sw.AbsolutePosition.Y - win.AbsolutePosition.Y + 28
			pop.Position = UDim2.fromOffset(math.max(8, px), math.min(py, 470 - ph - 8))
			popup = pop

			-- saturation / value square
			local sv = new("Frame", {
				Size = UDim2.fromOffset(168, 100), Position = UDim2.fromOffset(10, 10),
				BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, ZIndex = 51,
			}, pop)
			corner(sv, 6)
			local white = new("Frame", {
				Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, ZIndex = 52,
			}, sv)
			corner(white, 6)
			new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
			local black = new("Frame", {
				Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 0, ZIndex = 53,
			}, sv)
			corner(black, 6)
			new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)

			local svCursor = new("Frame", {
				Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 55,
				Position = UDim2.new(s, -5, 1 - v, -5),
			}, sv)
			corner(svCursor, 5)
			stroke(svCursor, Color3.new(1, 1, 1), 2, 0)

			-- hue bar
			local hue = new("Frame", {
				Size = UDim2.fromOffset(168, 12), Position = UDim2.fromOffset(10, 120),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 51,
			}, pop)
			corner(hue, 6)
			local kps = {}
			for i = 0, 6 do
				table.insert(kps, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
			end
			new("UIGradient", { Color = ColorSequence.new(kps) }, hue)
			local hueCursor = new("Frame", {
				Size = UDim2.fromOffset(4, 18), Position = UDim2.new(h, -2, 0.5, -9),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 55,
			}, hue)
			corner(hueCursor, 2)

			local hex = label(pop, "#" .. default:ToHex():upper(), 11, T.Sub, UDim2.fromOffset(10, 142), UDim2.fromOffset(120, 20), Enum.Font.GothamMedium)
			hex.ZIndex = 51

			local function refresh()
				local c = Color3.fromHSV(h, s, v)
				sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				sw.BackgroundColor3 = c
				svCursor.Position = UDim2.new(s, -5, 1 - v, -5)
				hueCursor.Position = UDim2.new(h, -2, 0.5, -9)
				hex.Text = "#" .. c:ToHex():upper()
				Flags[text] = c
				runHook(text, c)
			end

			local dragSV, dragHue = false, false
			local function mouse() return UserInputService:GetMouseLocation() end
			local function updSV()
				local m = mouse()
				s = math.clamp((m.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
				v = 1 - math.clamp((m.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
				refresh()
			end
			local function updHue()
				local m = mouse()
				h = math.clamp((m.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 0.999)
				refresh()
			end

			local function hitbox(parent, onDown)
				local b = new("TextButton", {
					Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 60,
				}, parent)
				b.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						onDown()
					end
				end)
			end
			hitbox(sv, function()
				dragSV = true
				updSV()
			end)
			hitbox(hue, function()
				dragHue = true
				updHue()
			end)

			local conns = {}
			table.insert(conns, UserInputService.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					if dragSV then updSV() elseif dragHue then updHue() end
				end
			end))
			table.insert(conns, UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragSV, dragHue = false, false
				end
			end))
			pop.Destroying:Connect(function()
				for _, c in ipairs(conns) do c:Disconnect() end
			end)
		end)
		Controls[text] = {
			kind = "color",
			apply = function(raw)
				if type(raw) == "table" and raw.t == "c" then
					setColor(Color3.new(tonumber(raw.r) or 0, tonumber(raw.g) or 0, tonumber(raw.b) or 0), true)
				end
			end,
		}
	end

	local function bindName(enum)
		if enum == Enum.UserInputType.MouseButton1 then return "Mouse 1" end
		if enum == Enum.UserInputType.MouseButton2 then return "Mouse 2" end
		if enum == Enum.UserInputType.MouseButton3 then return "Mouse 3" end
		return enum.Name
	end

	local function matchBind(b, input)
		if not b then return false end
		if b.Kind == "Key" then
			return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == b.Enum
		end
		return input.UserInputType == b.Enum
	end

	-- Click the box, then press any key or mouse button. Escape clears it.
	-- onPress (optional) runs whenever the bound key is pressed.
	local function Keybind(S, text, default, onPress, required)
