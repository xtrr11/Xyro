	--// CORE
	--// ===================================================================
	local function BuildCore()
	local restoreAll
	local Camera = workspace.CurrentCamera
	local hasDrawing = type(Drawing) == "table"

	local function draw(class, props)
		local d = Drawing.new(class)
		for k, v in pairs(props) do d[k] = v end
		return d
	end
	local function killDraw(d) pcall(function() d:Remove() end) end

	local function teamBlocked(plr, flag)
		return Flags[flag] and plr.Team ~= nil and plr.Team == LocalPlayer.Team
	end

	local function charParts(plr)
		local c = plr.Character
		if not c then return end
		local hum = c:FindFirstChildOfClass("Humanoid")
		local root = c:FindFirstChild("HumanoidRootPart")
		local head = c:FindFirstChild("Head")
		if hum and root and head and hum.Health > 0 then
			return c, hum, root, head
		end
		return nil
	end

	local R15 = {
		{ "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
		{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
		{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
		{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
		{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
	}
	local R6 = {
		{ "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
		{ "Torso", "Left Leg" }, { "Torso", "Right Leg" },
	}

	local ESPObjs, Highlights = {}, {}

	local function newESP(plr)
		local o = {
			Box = draw("Square", { Thickness = 1, Filled = false, Visible = false }),
			Name = draw("Text", { Size = 13, Center = true, Outline = true, Visible = false }),
			Dist = draw("Text", { Size = 12, Center = true, Outline = true, Visible = false }),
			HealthBG = draw("Line", { Thickness = 4, Color = Color3.new(0, 0, 0), Visible = false }),
			HealthFill = draw("Line", { Thickness = 2, Visible = false }),
			Dot = draw("Circle", { NumSides = 16, Thickness = 1, Filled = true, Visible = false }),
			Tracer = draw("Line", { Thickness = 1, Visible = false }),
			Corners = {}, Bones = {}, All = {},
		}
		for i = 1, 8 do o.Corners[i] = draw("Line", { Thickness = 1, Visible = false }) end
		for i = 1, 14 do o.Bones[i] = draw("Line", { Thickness = 1, Visible = false }) end
		for _, k in ipairs({ "Box", "Name", "Dist", "HealthBG", "HealthFill", "Dot", "Tracer" }) do table.insert(o.All, o[k]) end
		for _, d in ipairs(o.Corners) do table.insert(o.All, d) end
		for _, d in ipairs(o.Bones) do table.insert(o.All, d) end
		ESPObjs[plr] = o
		return o
	end

	local function hideESP(o)
		for _, d in ipairs(o.All) do d.Visible = false end
	end

	local function removeESP(plr)
		local o = ESPObjs[plr]
		if o then
			for _, d in ipairs(o.All) do killDraw(d) end
			ESPObjs[plr] = nil
		end
		if Highlights[plr] then
			Highlights[plr]:Destroy()
			Highlights[plr] = nil
		end
	end

	local function updateChams(plr, c, show)
		local hl = Highlights[plr]
		if show then
			if not hl or hl.Adornee ~= c then
				if hl then hl:Destroy() end
				hl = new("Highlight", { Adornee = c }, parentGui)
				Highlights[plr] = hl
			end
			local mode = Flags["Chams Mode"]
			hl.FillColor = Flags["Chams Fill Color"]
			hl.OutlineColor = Flags["Chams Outline Color"]
			hl.FillTransparency = (mode == "Outline") and 1 or (1 - Flags["Chams Intensity"] / 100)
			hl.OutlineTransparency = (mode == "Fill") and 1 or 0
			hl.DepthMode = Flags["Chams Through Walls"] and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
			hl.Enabled = true
		elseif hl then
			hl.Enabled = false
		end
	end

	local function updateESP(plr, vp)
		local c, hum, root, head = charParts(plr)
		local dist = root and (root.Position - Camera.CFrame.Position).Magnitude or math.huge
		local ok = c ~= nil and not teamBlocked(plr, "ESP Team Check") and dist <= Flags["ESP Max Distance"]

		updateChams(plr, c, ok and Flags["Chams"])

		local o = ESPObjs[plr]
		if not (hasDrawing and ok and Flags["Player ESP"]) then
			if o then hideESP(o) end
			return
		end
		o = o or newESP(plr)

		local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
		local bot = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
		if top.Z <= 0 or bot.Z <= 0 then
			hideESP(o)
			return
		end

		local h = math.abs(bot.Y - top.Y)
		local w = h * 0.55
		local x, y = top.X - w / 2, top.Y
		local boxCol = Flags["Box Color"]

		o.Box.Visible = Flags["Box ESP"]
		if Flags["Box ESP"] then
			o.Box.Position = Vector2.new(x, y)
			o.Box.Size = Vector2.new(w, h)
			o.Box.Color = boxCol
		end

		local cb = Flags["Corner Box"]
		if cb then
			local l = math.min(w, h) * 0.28
			local segs = {
				{ x, y, x + l, y }, { x, y, x, y + l },
				{ x + w, y, x + w - l, y }, { x + w, y, x + w, y + l },
				{ x, y + h, x + l, y + h }, { x, y + h, x, y + h - l },
				{ x + w, y + h, x + w - l, y + h }, { x + w, y + h, x + w, y + h - l },
			}
			for i, sg in ipairs(segs) do
				local ln = o.Corners[i]
				ln.From = Vector2.new(sg[1], sg[2])
				ln.To = Vector2.new(sg[3], sg[4])
				ln.Color = boxCol
				ln.Visible = true
			end
		else
			for _, ln in ipairs(o.Corners) do ln.Visible = false end
		end

		local bones = (hum.RigType == Enum.HumanoidRigType.R15) and R15 or R6
		for i, ln in ipairs(o.Bones) do
			local pair = Flags["Skeleton"] and bones[i]
			local drawn = false
			if pair then
				local a, b = c:FindFirstChild(pair[1]), c:FindFirstChild(pair[2])
				if a and b then
					local pa = Camera:WorldToViewportPoint(a.Position)
					local pb = Camera:WorldToViewportPoint(b.Position)
					if pa.Z > 0 and pb.Z > 0 then
						ln.From = Vector2.new(pa.X, pa.Y)
						ln.To = Vector2.new(pb.X, pb.Y)
						ln.Color = Flags["Skeleton Color"]
						drawn = true
					end
				end
			end
			ln.Visible = drawn
		end

		local hb = Flags["Health Bar"]
		o.HealthBG.Visible = hb
		o.HealthFill.Visible = hb
		if hb then
			local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			local bx = x - 5
			o.HealthBG.From = Vector2.new(bx, y + h + 1)
			o.HealthBG.To = Vector2.new(bx, y - 1)
			o.HealthFill.From = Vector2.new(bx, y + h)
			o.HealthFill.To = Vector2.new(bx, y + h - h * frac)
			o.HealthFill.Color = Flags["Health Bar Color"]
		end

		o.Name.Visible = Flags["Name ESP"]
		if Flags["Name ESP"] then
			o.Name.Text = plr.DisplayName
			o.Name.Position = Vector2.new(x + w / 2, y - 16)
			o.Name.Color = Flags["Name Color"]
		end
		o.Dist.Visible = Flags["Distance ESP"]
		if Flags["Distance ESP"] then
			o.Dist.Text = string.format("[%dm]", math.floor(dist))
			o.Dist.Position = Vector2.new(x + w / 2, y + h + 2)
			o.Dist.Color = Flags["Name Color"]
		end

		o.Dot.Visible = Flags["Head Dot"]
		if Flags["Head Dot"] then
			local hp = Camera:WorldToViewportPoint(head.Position)
			o.Dot.Position = Vector2.new(hp.X, hp.Y)
			o.Dot.Radius = math.max(2, w * 0.1)
			o.Dot.Color = boxCol
		end

		o.Tracer.Visible = Flags["Tracers"]
		if Flags["Tracers"] then
			local origin = Flags["Tracer Origin"]
			local from
			if origin == "Center" then from = Vector2.new(vp.X / 2, vp.Y / 2)
			elseif origin == "Top" then from = Vector2.new(vp.X / 2, 0)
			elseif origin == "Mouse" then from = UserInputService:GetMouseLocation()
			else from = Vector2.new(vp.X / 2, vp.Y) end
			o.Tracer.From = from
			o.Tracer.To = Vector2.new(x + w / 2, y + h)
			o.Tracer.Color = Flags["Tracer Color"]
		end
	end

	local espConn = RunService.RenderStepped:Connect(function()
		Camera = workspace.CurrentCamera
		local vp = Camera.ViewportSize
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local ok, err = pcall(updateESP, plr, vp)
				if not ok then warn("[Xyro ESP] " .. tostring(err)) end
			end
		end
	end)
	local leaveConn = Players.PlayerRemoving:Connect(removeESP)

	-- HIT LOGS
	local lastShot = 0
	local hitConns = {}
	local hitRows = {}
	local hitOrder = 0
	local PART_LABEL = {
		Head = "Head", Torso = "Torso",
		["Left Arm"] = "Left Arm", ["Right Arm"] = "Right Arm",
		["Left Leg"] = "Left Leg", ["Right Leg"] = "Right Leg",
		UpperTorso = "Upper Torso", LowerTorso = "Lower Torso",
		LeftUpperArm = "Left Arm", LeftLowerArm = "Left Arm", LeftHand = "Left Hand",
		RightUpperArm = "Right Arm", RightLowerArm = "Right Arm", RightHand = "Right Hand",
		LeftUpperLeg = "Left Leg", LeftLowerLeg = "Left Leg", LeftFoot = "Left Foot",
		RightUpperLeg = "Right Leg", RightLowerLeg = "Right Leg", RightFoot = "Right Foot",
	}

	local hitHolder = new("Frame", {
		Size = UDim2.fromOffset(380, 220),
		Position = UDim2.new(0.5, -190, 0, 14),
		BackgroundTransparency = 1,
	}, mg)
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, hitHolder)

	local function safeRich(s)
		return (tostring(s):gsub("[&<>]", ""))
	end

	local function closestLimb(char, mousePos)
		local bestName, bestD = "Body", math.huge
		local cam = workspace.CurrentCamera
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local sp = cam:WorldToViewportPoint(part.Position)
				if sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
					if d < bestD then
						bestD, bestName = d, part.Name
					end
				end
			end
		end
		return PART_LABEL[bestName] or bestName
	end

	local function pushHitLog(userId, partName, playerName, dmg, dist)
		if Flags["Hit Logs"] == false then return end
		hitOrder += 1
		local row = new("Frame", {
			Size = UDim2.fromOffset(360, 32),
			BackgroundColor3 = Color3.fromRGB(22, 24, 28),
			BackgroundTransparency = 0.04,
			LayoutOrder = hitOrder,
		}, hitHolder)
		corner(row, 6)

		local avatar = new("ImageLabel", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.fromOffset(8, 7),
			BackgroundColor3 = Color3.fromRGB(46, 130, 220),
			Image = "",
		}, row)
		corner(avatar, 9)
		task.spawn(function()
			local ok, img = pcall(function()
				return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)
			if ok and avatar.Parent then avatar.Image = img end
		end)

		local text = label(row, "", 13, Color3.fromRGB(226, 229, 236), UDim2.fromOffset(34, 0), UDim2.new(1, -66, 1, 0), Enum.Font.GothamMedium, Enum.TextXAlignment.Left)
		text.RichText = true
		text.TextTruncate = Enum.TextTruncate.AtEnd
		text.Text = string.format(
			"%s Hit   <b>%s</b>   <font color=\"#9aa3b2\">·   %d st (%dm)</font>",
			safeRich(partName), safeRich(playerName),
			math.floor(dmg + 0.5), math.floor(dist + 0.5)
		)

		local cross = new("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(1, -26, 0.5, -9),
			BackgroundColor3 = Color3.fromRGB(214, 48, 58),
		}, row)
		corner(cross, 4)
		local plus = label(cross, "+", 14, Color3.new(1, 1, 1), UDim2.new(), UDim2.fromScale(1, 1), Enum.Font.GothamBold, Enum.TextXAlignment.Center)
		plus.TextYAlignment = Enum.TextYAlignment.Center

		table.insert(hitRows, row)
		while #hitRows > 5 do
			local oldRow = table.remove(hitRows, 1)
			if oldRow then oldRow:Destroy() end
		end
		task.delay(3.6, function()
			if not row.Parent then return end
			local fade = TweenService:Create(row, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
			fade:Play()
			TweenService:Create(text, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
			TweenService:Create(avatar, TweenInfo.new(0.25), { ImageTransparency = 1, BackgroundTransparency = 1 }):Play()
			TweenService:Create(cross, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(plus, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
			fade.Completed:Wait()
			if row.Parent then row:Destroy() end
		end)
	end

	local function onDamaged(plr, char, prev, now)
		local dmg = prev - now
		if dmg < 0.5 then return end
		if Flags["Hit Logs"] == false then return end
		if os.clock() - lastShot > 0.5 then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local cam = workspace.CurrentCamera
		if not (root and mine and cam) then return end
		local mousePos = UserInputService:GetMouseLocation()
		local sp = cam:WorldToViewportPoint(root.Position)
		if sp.Z <= 0 then return end
		if (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude > 320 then return end
		pushHitLog(plr.UserId, closestLimb(char, mousePos), plr.DisplayName, dmg, (root.Position - mine.Position).Magnitude)
	end

	local function trackHum(plr, char, hum)
		local last = hum.Health
		table.insert(hitConns, hum.HealthChanged:Connect(function(h)
			local prev = last
			last = h
			onDamaged(plr, char, prev, h)
		end))
	end

	local function trackChar(plr, char)
		task.spawn(function()
			local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
			if hum and char.Parent and plr.Parent then
				trackHum(plr, char, hum)
			end
		end)
	end

	local function trackPlayer(plr)
		if plr == LocalPlayer then return end
		if plr.Character then trackChar(plr, plr.Character) end
		table.insert(hitConns, plr.CharacterAdded:Connect(function(char)
			trackChar(plr, char)
		end))
	end

	local function armTool(tool)
		if not tool:IsA("Tool") then return end
		table.insert(hitConns, tool.Activated:Connect(function()
			lastShot = os.clock()
		end))
	end

	local function armChar(char)
		for _, ch in ipairs(char:GetChildren()) do armTool(ch) end
		table.insert(hitConns, char.ChildAdded:Connect(armTool))
	end

	table.insert(hitConns, UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			lastShot = os.clock()
		end
	end))
	if LocalPlayer.Character then armChar(LocalPlayer.Character) end
	table.insert(hitConns, LocalPlayer.CharacterAdded:Connect(armChar))
	for _, plr in ipairs(Players:GetPlayers()) do
		trackPlayer(plr)
	end
	table.insert(hitConns, Players.PlayerAdded:Connect(trackPlayer))

	-- AIMBOT
	local fovCircle = hasDrawing and draw("Circle", { NumSides = 64, Visible = false }) or nil
	local silentFov = hasDrawing and draw("Circle", { NumSides = 64, Visible = false }) or nil
	local triggerFov = hasDrawing and draw("Circle", { NumSides = 48, Visible = false }) or nil
	local lockPlr, lockPart, lockMiss, lockOffset = nil, nil, false, Vector3.zero
	local silentPart, silentLock, silentMiss = nil, nil, false

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function bindHeld(b)
		if not b then return false end
		if b.Kind == "Key" then return UserInputService:IsKeyDown(b.Enum) end
		if b.Kind == "Mouse" then return UserInputService:IsMouseButtonPressed(b.Enum) end
		return false
	end

	local function keyHeld() return bindHeld(Flags["Aim Key"]) end

	local function silentActive()
		if not Flags["Silent Aim"] then return false end
		if Flags["Silent Activation"] == "Hold" then return bindHeld(Flags["Silent Key"]) end
		return true
	end

	local function getPart(c, mode, mousePos)
		if mode == "Head" then return c:FindFirstChild("Head") end
		if mode == "Torso" then return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") end
		if mode == "HumanoidRootPart" then return c:FindFirstChild("HumanoidRootPart") end
		if mode == "Random" then
			local pool = {}
			for _, n in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
				local p = c:FindFirstChild(n)
				if p then table.insert(pool, p) end
			end
			return pool[math.random(1, math.max(#pool, 1))]
		end
		local best, bestD
		for _, part in ipairs(c:GetChildren()) do
			if part:IsA("BasePart") then
				local sp = Camera:WorldToViewportPoint(part.Position)
				if sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
					if not bestD or d < bestD then best, bestD = part, d end
				end
			end
		end
		return best
	end

	local inInternalRay = false

	local function visibleTo(part, c)
		rayParams.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
		local origin = Camera.CFrame.Position
		inInternalRay = true
		local res = workspace:Raycast(origin, part.Position - origin, rayParams)
		inInternalRay = false
		return res == nil or res.Instance:IsDescendantOf(c)
	end

	local function findTarget(mousePos, opts)
		opts = opts or {}
		local teamFlag = opts.teamFlag or "Aimbot Team Check"
		local maxDist = opts.maxDist or Flags["Aimbot Max Distance"]
		local partMode = opts.partMode or Flags["Aimbot Target"]
		local fov = opts.fov or Flags["Aimbot FOV"]
		local wall = opts.wall
		if wall == nil then wall = Flags["Wall Check"] end
		local priority = opts.priority or Flags["Target Priority"]
		local bestPlr, bestPart, bestScore
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and not teamBlocked(plr, teamFlag) then
				local c = plr.Character
				local hum = c and c:FindFirstChildOfClass("Humanoid")
				local root = c and c:FindFirstChild("HumanoidRootPart")
				local alive = false
				if hum then
					if opts.forceAlive then
						alive = hum.Health > 0
					else
						alive = hum.Health > 0 or not Flags["Alive Check"]
					end
				end
				if hum and root and alive then
					local dist = (root.Position - Camera.CFrame.Position).Magnitude
					if dist <= maxDist then
						local part = getPart(c, partMode, mousePos)
						if part then
							local sp = Camera:WorldToViewportPoint(part.Position)
							local d2 = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
							if sp.Z > 0 and d2 <= fov and (not wall or visibleTo(part, c)) then
								local pr = priority
								local score = (pr == "Closest Distance" and dist) or (pr == "Lowest Health" and hum.Health) or d2
								if not bestScore or score < bestScore then
									bestPlr, bestPart, bestScore = plr, part, score
								end
							end
						end
					end
				end
			end
		end
		return bestPlr, bestPart
	end

	local triggerDown = false
	local triggerPendingUp = false
	local nextTriggerAt = 0
	local triggerReleaseToken = 0

	local function sendClick(down)
		if down then
			if type(mouse1press) == "function" then pcall(mouse1press) return true end
			if type(mouse1click) == "function" then pcall(mouse1click) return false end
		else
			if type(mouse1release) == "function" then pcall(mouse1release) return true end
			if type(mouse1click) == "function" then return true end
		end
		local ok = pcall(function()
			local vim = game:GetService("VirtualInputManager")
			local m = UserInputService:GetMouseLocation()
			vim:SendMouseButtonEvent(m.X, m.Y, 0, down, game, 1)
		end)
		return ok
	end

	local function releaseTrigger()
		if not triggerDown and not triggerPendingUp then return end
		triggerReleaseToken += 1
		triggerDown = false
		triggerPendingUp = false
		sendClick(false)
	end

	local function pointerOnMenu()
		if not win.Visible then return false end
		local m = LocalPlayer:GetMouse()
		local p = win.AbsolutePosition
		local s = win.AbsoluteSize
		return m.X >= p.X and m.Y >= p.Y and m.X <= p.X + s.X and m.Y <= p.Y + s.Y
	end

	local function triggerActive()
		if not Flags["Triggerbot"] then return false end
		if binding or popup or UserInputService:GetFocusedTextBox() then return false end
		if pointerOnMenu() then return false end
		if Flags["Trigger Mode"] == "Hold" then return bindHeld(Flags["Trigger Key"]) end
		return true
	end

	local function triggerDelay()
		local base = math.max(0, tonumber(Flags["Trigger Delay"]) or 70) / 1000
		local jitter = (base > 0) and (math.random() * math.min(0.025, base * 0.2)) or 0
		return math.max(base + jitter, 0.03)
	end

	local function pokeTool()
		local char = LocalPlayer.Character
		local tool = char and char:FindFirstChildOfClass("Tool")
		if tool then pcall(function() tool:Activate() end) end
