				end
				watchNoclip(part)
				part.CanCollide = false
				if noclipReady then pcall(function() part.CollisionGroup = NOCLIP_GROUP end) end
			end
		end
	end

	local function clearNoclip()
		for part, conn in pairs(noclipWatch) do pcall(function() conn:Disconnect() end) end
		noclipWatch = {}
		for part, saved in pairs(noclipSaved) do
			if part.Parent then
				pcall(function()
					part.CollisionGroup = saved.Group
					part.CanCollide = saved.CanCollide
				end)
