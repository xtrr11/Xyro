		-- Read kill counter from the quest UI. Returns (cur, goal) or nil.
		local function questKills()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			local mainUI = pg and pg:FindFirstChild("Main")
			local q = mainUI and mainUI:FindFirstChild("Quest")
			if not q then return nil end
			for _, d in ipairs(q:GetDescendants()) do
				if d:IsA("TextLabel") and d.Text ~= "" then
					local a, b = d.Text:match("^(%d+)%s*/%s*(%d+)$")
					if a and b and tonumber(b) > 0 then
						return tonumber(a), tonumber(b)
					end
				end
			end
			return nil
		end

		local function moveTo(pos, lookAt, token)
			local _, _, root = myChar()
			local dist = root and (root.Position - pos).Magnitude or 1000
			local timeout = math.clamp(dist / 180 + 8, 12, 200)
			local t0 = os.clock()
			farmClip = true
			while Flags["Auto Level"] and token == bfToken and os.clock() - t0 < timeout do
				local c, hum, r = myChar()
				if not (c and hum and r) or hum.Health <= 0 then
					farmGoal = nil
					task.wait(0.4)
				else
					farmGoal = pos
					farmLook = lookAt or pos
					if (r.Position - pos).Magnitude < 10 then return true end
					task.wait(0.1)
				end
			end
			return false
		end

		local function runAutoLevel(token)
			while Flags["Auto Level"] and token == bfToken do
				local sea = BF_PLACES[game.PlaceId]
				local level = bfLevel()
				local entry, over = pickQuest(sea, level)
				if not entry then
					setBfStatus("Blox Fruits is open, but this place has no quest route.")
					task.wait(1)
				elseif over then
					setBfStatus(string.format("Level %d is past the %s. Sail to the next sea, then turn Auto Level on again.", level, SEA_NAME[sea] or "sea"))
					if autoLevelToggle then autoLevelToggle.Set(false) end
					return
				else
					setBfStatus(string.format("Lv %d  ·  %s  ·  %s", level, entry.Mob, SEA_NAME[sea] or "Sea"))
					local key = entry.Quest .. "#" .. entry.Num

					if claimedQuest == key then
						local cur, goal = questKills()
						local complete = (cur and goal and cur >= goal)
						local stale = (os.clock() - claimedAt > 60)
						if complete or stale then
							claimedQuest = nil
						end
					end

					if claimedQuest ~= key then
						local remote = CommF()
						if not remote then
							setBfStatus("Looking for CommF_ remote...")
							task.wait(0.5)
						else
							pcall(function() remote:InvokeServer("StartQuest", entry.Quest, entry.Num) end)
							claimedQuest = key
							claimedAt = os.clock()
							equipWeapon()
							task.wait(0.4)
						end
					end

					local mob = findMob(entry.Mob)
					local hrp = mob and mob:FindFirstChild("HumanoidRootPart")
					local hum = mob and mob:FindFirstChild("Humanoid")
					if hrp and hum and hum.Health > 0 then
						local height = Flags["Farm Height"] or 18
						local above = hrp.Position + Vector3.new(0, height, 0)
						farmClip = true
						farmGoal = above
						farmLook = hrp.Position
						local _, _, root = myChar()
						if root and (root.Position - above).Magnitude < 28 then
							equipWeapon()
							bfAttack(mob)
						end
						task.wait(0.12)
					else
						setBfStatus(string.format("Lv %d  ·  walking to %s", level, entry.Mob))
						farmClip = true
						farmGoal = entry.Npc + Vector3.new(0, Flags["Farm Height"] or 18, 0)
						farmLook = entry.Npc
						task.wait(0.4)
					end
				end
			end
		end

