		local btnStroke = stroke(btn, T.Accent, 1, 1)

		local function show()
			btn.Text = Flags[text] and Flags[text].Name or "None"
		end
		local function set(enum)
			if enum == nil then
				Flags[text] = nil
			elseif enum.EnumType == Enum.KeyCode then
				Flags[text] = { Kind = "Key", Enum = enum, Name = bindName(enum) }
			else
				Flags[text] = { Kind = "Mouse", Enum = enum, Name = bindName(enum) }
			end
			show()
		end
