		local function show()
			btn.Text = Flags[text] and Flags[text].Name or "None"
		end
		local function set(enum)
			if enum == nil then
				Flags[text] = nil
			elseif enum.EnumType == Enum.KeyCode then
				Flags[text] = { Kind = "Key", Enum = enum, Name = bindName(enum) }
			else
				Flags[text] = { Kind = "Mouse", Enum = enum, Name = bindName(enum) }
			end
			show()
		end
		set(default)

		btn.MouseButton1Click:Connect(function()
			if binding then return end
			binding = text
			btn.Text = "Press a key..."
			btnStroke.Transparency = 0.1
			local conn
			conn = UserInputService.InputBegan:Connect(function(input)
				local ut = input.UserInputType
				if ut == Enum.UserInputType.Keyboard then
					if input.KeyCode == Enum.KeyCode.Escape then
						if not required then set(nil) else show() end
					elseif input.KeyCode ~= Enum.KeyCode.Unknown then
						set(input.KeyCode)
					else
						return
					end
				elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2 or ut == Enum.UserInputType.MouseButton3 then
					set(ut)
				else
					return
				end
				conn:Disconnect()
				binding = nil
				lastBind = os.clock()
				btnStroke.Transparency = 1
			end)
		end)

		if onPress then
			table.insert(ExtraConns, UserInputService.InputBegan:Connect(function(input, processed)
				if processed or binding or os.clock() - lastBind < 0.25 then return end
				if matchBind(Flags[text], input) then onPress() end
			end))
		end
		Controls[text] = {
			kind = "bind",
			apply = function(raw)
				if raw == nil or raw == false then
					if not required then set(nil) end
					return
				end
				if type(raw) ~= "table" then return end
				if raw.k == "Key" then
					local ok, enum = pcall(function() return Enum.KeyCode[raw.n] end)
					if ok and enum and enum ~= Enum.KeyCode.Unknown then set(enum) end
				elseif raw.k == "Mouse" then
					local map = {
						["Mouse 1"] = Enum.UserInputType.MouseButton1,
						["Mouse 2"] = Enum.UserInputType.MouseButton2,
						["Mouse 3"] = Enum.UserInputType.MouseButton3,
					}
					if map[raw.n] then set(map[raw.n]) end
				end
			end,
		}
	end

	local CFG_FOLDER = "XyroHub"
	local AUTO_PATH = CFG_FOLDER .. "/autoload.txt"

	local function cleanCfgName(name)
		name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
		name = name:gsub("[^%w_%- ]", "")
		if #name > 32 then name = name:sub(1, 32) end
		if name == "" then return nil end
		return name
	end

	local function hasFS()
		return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
	end

	local function ensureCfgFolder()
		if type(makefolder) ~= "function" then return end
		if type(isfolder) == "function" then
			if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
		else
			pcall(makefolder, CFG_FOLDER)
		end
	end

	local function cfgPath(name)
		return CFG_FOLDER .. "/" .. name .. ".json"
	end

	local function packFlags()
		local out = {}
		for name, ctrl in pairs(Controls) do
			local v = Flags[name]
			if ctrl.kind == "bool" then
				out[name] = v and true or false
			elseif ctrl.kind == "number" then
				out[name] = tonumber(v)
			elseif ctrl.kind == "enum" then
				out[name] = tostring(v)
			elseif ctrl.kind == "color" and typeof(v) == "Color3" then
				out[name] = { t = "c", r = v.R, g = v.G, b = v.B }
			elseif ctrl.kind == "bind" then
				if type(v) == "table" and v.Kind and v.Name then
					out[name] = { t = "b", k = v.Kind, n = v.Name }
				else
					out[name] = false
				end
			end
		end
		return out
	end

	local function applyPacked(data)
		for name, ctrl in pairs(Controls) do
			local raw = data[name]
			if raw ~= nil and ctrl.kind ~= "bool" then
				pcall(ctrl.apply, raw)
			end
		end
		for name, ctrl in pairs(Controls) do
			local raw = data[name]
			if raw ~= nil and ctrl.kind == "bool" then
				pcall(ctrl.apply, raw)
			end
		end
	end

	local function saveConfig(rawName)
		local name = cleanCfgName(rawName)
		if not name then return false, "Enter a config name." end
		local payload = game:GetService("HttpService"):JSONEncode(packFlags())
		if not hasFS() then
			if setclipboard then
				setclipboard(payload)
				return false, "No writefile. JSON copied."
			end
			return false, "Executor has no writefile."
		end
		ensureCfgFolder()
		local ok = pcall(writefile, cfgPath(name), payload)
		if not ok then return false, "Save failed." end
		return true, "Saved '" .. name .. "'."
	end

	local function loadConfig(rawName)
		local name = cleanCfgName(rawName)
		if not name then return false, "Enter a config name." end
		if not hasFS() then return false, "Executor has no readfile." end
		local path = cfgPath(name)
		if not isfile(path) then return false, "No config named '" .. name .. "'." end
		local ok, data = pcall(function()
			return game:GetService("HttpService"):JSONDecode(readfile(path))
		end)
		if not ok or type(data) ~= "table" then return false, "Config file is corrupt." end
		applyPacked(data)
		return true, "Loaded '" .. name .. "'."
	end

	local function deleteConfig(rawName)
		local name = cleanCfgName(rawName)
		if not name then return false, "Enter a config name." end
		if not hasFS() or type(delfile) ~= "function" then return false, "Executor has no delfile." end
		local path = cfgPath(name)
		if not isfile(path) then return false, "No config named '" .. name .. "'." end
		local ok = pcall(delfile, path)
		if not ok then return false, "Delete failed." end
		return true, "Deleted '" .. name .. "'."
	end

	local function setAutoload(rawName)
		local name = cleanCfgName(rawName)
		if not name then return false, "Enter a config name." end
		if not hasFS() then return false, "Executor has no writefile." end
		if not isfile(cfgPath(name)) then return false, "Save the config before autoload." end
		ensureCfgFolder()
		local ok = pcall(writefile, AUTO_PATH, name)
		if not ok then return false, "Could not set autoload." end
		return true, "Autoload set to '" .. name .. "'."
	end

	local function clearAutoload()
		if not hasFS() or type(delfile) ~= "function" then return false, "Executor has no delfile." end
		if isfile(AUTO_PATH) then pcall(delfile, AUTO_PATH) end
		return true, "Autoload cleared."
	end

	local function tryAutoload()
		if not hasFS() or not isfile(AUTO_PATH) then return end
		local ok, name = pcall(readfile, AUTO_PATH)
		if not ok or type(name) ~= "string" then return end
		name = cleanCfgName(name)
		if not name then return end
		if cfgNameBox then cfgNameBox.Text = name end
		local loaded, msg = loadConfig(name)
		if cfgStatus and msg then cfgStatus.Text = msg end
		if loaded then notify(msg, T.Green, 3) end
	end

