	-- STAFF DETECTOR
	local STAFF_WORDS = {
		"admin", "administrator", "mod", "mods", "moderator", "staff", "dev", "developer", "developers",
		"owner", "co owner", "coowner", "founder", "manager", "helper", "support", "head admin",
	}
	local COMPACT_HITS = {
		"headadmin", "superadmin", "coowner", "trialmod", "jradmin", "sradmin",
		"senioradmin", "junioradmin", "gameadmin", "headmod", "headadministrator",
	}

	local function roleIsStaff(role)
		if type(role) ~= "string" or role == "" then return false end
		local lower = string.lower(role)
		local compact = string.gsub(lower, "[^%a]", "")
		for _, w in ipairs(COMPACT_HITS) do
			if string.find(compact, w, 1, true) then return true end
		end
		local cleaned = " " .. string.gsub(lower, "[^%a]", " ") .. " "
		cleaned = string.gsub(cleaned, "%s+", " ")
		for _, w in ipairs(STAFF_WORDS) do
			if string.find(cleaned, " " .. w .. " ", 1, true) then return true end
		end
		return false
	end

	local StaffFound, checking = {}, {}
	local staffCharConns = {}
	local GroupService = game:GetService("GroupService")

	local function scanExtras(plr)
		if plr.Team and roleIsStaff(plr.Team.Name) then return "Team " .. plr.Team.Name end
		local ls = plr:FindFirstChild("leaderstats")
		if ls then
			for _, v in ipairs(ls:GetChildren()) do
				if v:IsA("ValueBase") and roleIsStaff(tostring(v.Value)) then return tostring(v.Value) end
			end
		end
		for _, ch in ipairs(plr:GetChildren()) do
			if ch:IsA("ValueBase") and (roleIsStaff(ch.Name) or roleIsStaff(tostring(ch.Value))) then
				return ch.Name .. ": " .. tostring(ch.Value)
			end
		end
		local okAttr, attrs = pcall(function() return plr:GetAttributes() end)
		if okAttr and attrs then
			for name, val in pairs(attrs) do
				if type(val) == "string" and roleIsStaff(val) then return name .. ": " .. val end
				if roleIsStaff(name) and val ~= false and val ~= 0 and val ~= "" then
					return "Attribute " .. name
				end
			end
		end
		if Flags["Check Nametags"] ~= false then
			local char = plr.Character
			if char then
				for _, d in ipairs(char:GetDescendants()) do
					if (d:IsA("TextLabel") or d:IsA("TextButton")) and roleIsStaff(d.Text) then
						return "Nametag " .. d.Text
					end
				end
			end
		end
	end

	local function updateStaffLabel()
		if not staffLabel then return end
		if not Flags["Staff Detector"] then
			staffLabel.Text = "Staff detector is off."
			return
		end
		local names = {}
		for plr, why in pairs(StaffFound) do
			table.insert(names, plr.DisplayName .. " (" .. why .. ")")
		end
		staffLabel.Text = (#names == 0) and "No staff detected in this server."
			or ("Staff in server:\n" .. table.concat(names, "\n"))
	end

	local function onStaff(plr, reason)
		updateStaffLabel()
		notify("STAFF: " .. plr.Name .. " - " .. reason, Color3.fromRGB(255, 90, 90), 6)
		local action = Flags["Detector Action"]
		if action == "Kick" then
			LocalPlayer:Kick("[Xyro] Staff detected: " .. plr.Name .. " (" .. reason .. ")")
		elseif action == "Server Hop" then
			task.wait(0.5)
			serverHop()
		end
	end

	local function checkPlayer(plr)
		if plr == LocalPlayer or StaffFound[plr] or checking[plr] then return end
		checking[plr] = true
		local reason
		pcall(function()
			if Flags["Check Game Owner"] and game.CreatorType == Enum.CreatorType.User and plr.UserId == game.CreatorId then
				reason = "Game owner"
			end
			if not reason and Flags["Check Roblox Staff"] and plr:GetRankInGroup(1200769) > 0 then
				reason = "Roblox staff"
			end
			if not reason and Flags["Check Group Roles"] and game.CreatorType == Enum.CreatorType.Group then
				local gid = game.CreatorId
				local role = plr:GetRoleInGroup(gid)
				local rank = plr:GetRankInGroup(gid)
				if roleIsStaff(role) then
					reason = role
				elseif rank >= (Flags["Staff Rank Threshold"] or 100) and rank > 0 then
					reason = role .. ", rank " .. rank
				end
			end
			if not reason and Flags["Check All Groups"] ~= false then
				local ok, groups = pcall(function() return GroupService:GetGroupsAsync(plr.UserId) end)
				if ok and type(groups) == "table" then
					for _, g in ipairs(groups) do
						if roleIsStaff(g.Role) then
							reason = g.Role .. " @ " .. g.Name
							break
						end
					end
				end
			end
			if not reason then reason = scanExtras(plr) end
		end)
		checking[plr] = nil
		if reason and Flags["Staff Detector"] and plr.Parent then
			StaffFound[plr] = reason
			onStaff(plr, reason)
		end
	end

	local function watchChar(plr)
		if staffCharConns[plr] then staffCharConns[plr]:Disconnect() end
		staffCharConns[plr] = plr.CharacterAdded:Connect(function()
			task.wait(1.2)
			if Flags["Staff Detector"] and plr.Parent and not StaffFound[plr] then
				checkPlayer(plr)
			end
		end)
	end

	local function scanAll()
		StaffFound = {}
		updateStaffLabel()
		for i, plr in ipairs(Players:GetPlayers()) do
			watchChar(plr)
			task.delay((i - 1) * 0.3, function()
				if Flags["Staff Detector"] and plr.Parent then checkPlayer(plr) end
			end)
		end
		task.delay(3 + #Players:GetPlayers() * 0.3, function()
			if Flags["Staff Detector"] and next(StaffFound) == nil then
				notify("No staff in this server", T.Green)
				updateStaffLabel()
			end
		end)
	end

