	local function spoofCFrame(real)
		local dist = Flags["Desync Distance"] or 14
		local mode = Flags["Desync Mode"] or "Underground"
		if mode == "Behind" then return real * CFrame.new(0, 0, dist)
		elseif mode == "Above" then return real * CFrame.new(0, dist, 0)
		elseif mode == "Random" then
			return real * CFrame.new((math.random() - 0.5) * dist * 2, (math.random() - 0.5) * dist, (math.random() - 0.5) * dist * 2)
		elseif mode == "Spin" then
			return CFrame.new(real.Position) * CFrame.Angles(0, os.clock() * 8, 0) * CFrame.new(0, 0, dist)
		end
		return real * CFrame.new(0, -math.abs(dist), 0)
	end

